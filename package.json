{
  "name": "wavival-dev",
  "type": "module",
  "version": "4.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --ignore-lock --host 127.0.0.1",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install --with-deps chromium",
    "lhci": "lhci autorun",
    "links": "linkinator ./dist --recurse --skip \"^(?!https?://localhost)\"",
    "csp:check": "node scripts/check-csp-hashes.mjs",
    "css:check": "node scripts/check-component-css.mjs",
    "security-txt:check": "node scripts/check-security-txt.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@vercel/microfrontends": "2.4.0",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{astro,ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.12.0",
    "@puppeteer/browsers": "^3.2.3",
    "@lhci/utils": {
      "js-yaml": "^4.3.2"
    }
  }
}

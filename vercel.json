{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/keepalive", "schedule": "0 9 */3 * *" }],
  "redirects": [
    {
      "source": "/proyectos/terracore-landing",
      "destination": "/proyectos/terracore#landing",
      "permanent": true
    },
    {
      "source": "/en/projects/terracore-landing",
      "destination": "/en/projects/terracore#landing",
      "permanent": true
    },
    {
      "source": "/projects/terracore-landing",
      "destination": "/proyectos/terracore#landing",
      "permanent": true
    },
    {
      "source": "/proyectos/okroot-landing",
      "destination": "/proyectos/okroot#landing",
      "permanent": true
    },
    {
      "source": "/en/projects/okroot-landing",
      "destination": "/en/projects/okroot#landing",
      "permanent": true
    },
    {
      "source": "/projects/okroot-landing",
      "destination": "/proyectos/okroot#landing",
      "permanent": true
    },
    {
      "source": "/proyectos/root-landing",
      "destination": "/proyectos/okroot#landing",
      "permanent": true
    },
    {
      "source": "/en/projects/root-landing",
      "destination": "/en/projects/okroot#landing",
      "permanent": true
    },
    {
      "source": "/projects/root-landing",
      "destination": "/proyectos/okroot#landing",
      "permanent": true
    },
    {
      "source": "/proyectos/blog-lumina-w",
      "destination": "/proyectos/lumina-w#blog",
      "permanent": true
    },
    {
      "source": "/en/projects/blog-lumina-w",
      "destination": "/en/projects/lumina-w#blog",
      "permanent": true
    },
    {
      "source": "/projects/blog-lumina-w",
      "destination": "/proyectos/lumina-w#blog",
      "permanent": true
    },
    {
      "source": "/proyectos/root",
      "destination": "/proyectos/okroot",
      "permanent": true
    },
    {
      "source": "/en/projects/root",
      "destination": "/en/projects/okroot",
      "permanent": true
    },
    {
      "source": "/projects/root",
      "destination": "/proyectos/okroot",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/proyectos/:path*",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/proyectos",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/sobre-mi",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/uses",
      "destination": "/herramientas",
      "permanent": true
    },
    {
      "source": "/cv_valentina_ramirez_es.pdf",
      "destination": "/sobre-mi",
      "permanent": true
    },
    {
      "source": "/cv_valentina_ramirez_en.pdf",
      "destination": "/en/about",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Ve9ZcDlpsOhfLecORYsJn37tQsVQ9FkOOPgrpPwR3bY=' 'sha256-9rQY2RsxVZ6My6dJ1Kkn1IWM+11FR3RVnVpEY5GcCQ8=' 'sha256-uISy+8ptqFMdZd+MCRD4H0qZUL1qysU4lo0QC7adiiA=' 'sha256-HirSGq/UsqRnbMlgefMu5m6oRLeZM+FErtkwQVSl1Nk=' 'sha256-HlpsG44Z8x1M83GlfwNPsr0JP4VYAFH4KgR3zhD+U7w=' 'sha256-PRxvjsbY/mGlh5QgEJDD5iOUqMNuNORxosu/A2oq3rw=' 'sha256-Rzdy1yD/yq+WhYvgMHr3gogOHqNygSRDI3yOxhWTSBc=' https://cloud.umami.is https://analytics.umami.is https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; font-src 'self'; img-src 'self' data: https://*.calendly.com https://d3v0px0pttie1i.cloudfront.net; connect-src 'self' https://cloud.umami.is https://analytics.umami.is https://gateway.umami.is https://calendly.com; frame-src https://calendly.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/_astro/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brand/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/icons/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}

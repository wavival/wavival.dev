---
import TextLink from "@/components/atoms/TextLink.astro";
import type { ProjectAction } from "@/data/projectView";

interface Props {
  actions: ProjectAction[];
  class?: string;
  /** One link per row instead of a wrapping row. */
  stacked?: boolean;
}

const { actions, class: extra = "", stacked = false } = Astro.props;
---

{
  actions.length > 0 && (
    <div class={`flex ${stacked ? "flex-col gap-3" : "flex-wrap gap-6"} ${extra}`.trim()}>
      {actions.map((a) => (
        <TextLink
          href={a.href}
          target={a.external ? "_blank" : "_self"}
          aria-label={a.ariaLabel}
          data-umami-event={a.event}
        >
          {a.text}
        </TextLink>
      ))}
    </div>
  )
}

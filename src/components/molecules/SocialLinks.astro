---
import IconLink from "@/components/atoms/IconLink.astro";
import {
  DEFAULT_SOCIAL_NETWORKS,
  SOCIAL_NETWORKS,
  SOCIAL_PROFILES,
  type SocialNetwork,
} from "@/data/social";
import type { Lang } from "@/i18n/utils";

/**
 * The only row of profile links of the site. `networks` picks which ones a
 * place shows; the order is always the one of `SOCIAL_NETWORKS`.
 */
interface Props {
  lang?: Lang;
  size?: "md" | "lg";
  class?: string;
  networks?: readonly SocialNetwork[];
}

const {
  lang = "es",
  size = "md",
  class: extra = "",
  networks = DEFAULT_SOCIAL_NETWORKS,
} = Astro.props;

const links = SOCIAL_NETWORKS.filter((id) => networks.includes(id)).map((id) => ({
  icon: id,
  href: SOCIAL_PROFILES[id].href,
  label: SOCIAL_PROFILES[id].label[lang],
}));
---

<div class={`flex flex-wrap items-center gap-2 ${extra}`.trim()} data-social-links>
  {links.map((l) => <IconLink href={l.href} icon={l.icon} label={l.label} size={size} />)}
</div>

---
import IconLink from "@/components/atoms/IconLink.astro";
import type { Lang } from "@/i18n/utils";
import { whatsappHref } from "@/data/whatsapp";

interface Props {
  lang?: Lang;
  size?: "md" | "lg";
  items?: ("linkedin" | "github" | "instagram" | "tiktok" | "whatsapp")[];
  class?: string;
}

const {
  lang = "es",
  size = "md",
  items = ["instagram", "github", "linkedin", "tiktok"],
  class: extra = "",
} = Astro.props;
const isEn = lang === "en";

const defs = {
  linkedin: {
    href: "https://linkedin.com/in/wavival",
    label: isEn ? "Valentina Ramírez on LinkedIn" : "LinkedIn de Valentina Ramírez",
  },
  github: {
    href: "https://github.com/wavival",
    label: isEn ? "Valentina Ramírez on GitHub" : "GitHub de Valentina Ramírez",
  },
  instagram: {
    href: "https://instagram.com/wavival",
    label: isEn ? "Valentina Ramírez on Instagram" : "Instagram de Valentina Ramírez",
  },
  tiktok: {
    href: "https://www.tiktok.com/@wavival_dev",
    label: isEn ? "Valentina Ramírez on TikTok" : "TikTok de Valentina Ramírez",
  },
  whatsapp: {
    href: whatsappHref(lang),
    label: isEn ? "Valentina Ramírez on WhatsApp" : "WhatsApp de Valentina Ramírez",
  },
};
---

<div class={`flex flex-wrap items-center gap-2 ${extra}`.trim()}>
  {items.map((k) => <IconLink href={defs[k].href} icon={k} label={defs[k].label} size={size} />)}
</div>

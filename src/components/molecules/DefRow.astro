---
interface Props {
  label: string;
  /** link tone highlights the label (the "what I built" row) */
  tone?: "muted" | "link";
  class?: string;
}

const { label, tone = "muted", class: extra = "" } = Astro.props;
---

<div class={`flex flex-col gap-[10px] border-b border-line py-6 ${extra}`.trim()}>
  <dt class={`label-sm ${tone === "link" ? "label-sm-link" : ""}`.trim()}>{label}</dt>
  <dd class="m-0"><slot /></dd>
</div>

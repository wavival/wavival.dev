---
interface Props {
  label: string;
  /** link tone highlights the label (the "what I built" row) */
  tone?: "muted" | "link";
  /** Final row of a list: no rule, extra bottom space. */
  last?: boolean;
  class?: string;
}

const { label, tone = "muted", last = false, class: extra = "" } = Astro.props;
const rowClass = last ? "pb-8 pt-6" : "border-b border-line py-6";
---

<div class={`flex flex-col gap-[10px] ${rowClass} ${extra}`.trim()}>
  <dt class={`label-sm ${tone === "link" ? "label-sm-link" : ""}`.trim()}>{label}</dt>
  <dd class="m-0"><slot /></dd>
</div>

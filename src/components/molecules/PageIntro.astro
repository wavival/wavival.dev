---
import Eyebrow from "@/components/atoms/Eyebrow.astro";

interface Props {
  eyebrow: string;
  /** Display scale of the h1; each size maps to a `.display-*` class. */
  size?: "page" | "index" | "contact" | "case" | "uses" | "about";
  class?: string;
}

const { eyebrow, size = "page", class: extra = "" } = Astro.props;
const headingClass = {
  page: "display-page",
  index: "display-index",
  contact: "display-contact text-balance",
  case: "display-case",
  uses: "display-uses",
  about: "display-about",
}[size];
---

<div class={extra}>
  <Eyebrow>{eyebrow}</Eyebrow>
  <h1 class={`${headingClass} mt-5 mb-0`}>
    <slot name="title" />
  </h1>
  <div class="mt-7">
    <slot />
  </div>
</div>

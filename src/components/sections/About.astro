---
import Link from "@/components/ui/Link.astro";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<section id="about" class="section" data-aos="fade-up">
  <p class="section-subtitle">{isEn ? "Beyond the code" : "Más allá del código"}</p>
  <h2 class="section-title">{isEn ? "About me" : "Sobre mí"}</h2>

  <div class="max-w-3xl flex flex-col gap-6 mt-10">
    <div class="flex flex-col gap-4 text-[var(--text-muted)] leading-relaxed">
      {
        isEn ? (
          <>
            <p>
              I'm a self-taught Full Stack Developer by conviction, focused on Django, React, and
              Next.js. I founded Lúmina W to build my own products. I study Software Analysis and
              Development at SENA and English Language at Universidad de San Buenaventura, learning
              in parallel because I don't know how to do it any other way.
            </p>
            <p>
              Outside of code, you'll find me in photography, behind the drums, and listening to a
              playlist that doesn't respect genres.
            </p>
          </>
        ) : (
          <>
            <p>
              Soy desarrolladora Full Stack autodidacta por convicción, con foco en Django, React y
              Next.js. Fundé Lúmina W para construir productos propios. <br /> Estudio Análisis y
              Desarrollo de Software en el SENA y Lengua Inglesa en la Universidad de San
              Buenaventura, aprendo en paralelo porque no sé hacerlo de otra forma.
            </p>
            <p>
              Fuera del código me encuentra la fotografía, la batería y una playlist que no respeta
              géneros.
            </p>
          </>
        )
      }
    </div>

    <blockquote class="border-l-4 border-[var(--brand-blue)] pl-5 my-2">
      <p class="italic font-display font-semibold text-[var(--text-primary)] leading-snug">
        {
          isEn
            ? '"The best software is built by people who understand the problem before opening the editor."'
            : '"El mejor software lo construyen personas que entienden el problema antes de abrir el editor."'
        }
      </p>
    </blockquote>

    <div class="flex flex-wrap items-center gap-[16px] mt-2">
      <Link
        href="https://instagram.com/wavival"
        target="_blank"
        icon="instagram"
        aria-label={isEn ? "Valentina Ramírez on Instagram" : "Instagram de Valentina Ramírez"}
      />
      <Link
        href="https://wa.me/573016560222"
        target="_blank"
        icon="whatsapp"
        aria-label={isEn ? "Valentina Ramírez on WhatsApp" : "WhatsApp de Valentina Ramírez"}
      />
      <Link
        href="https://platzi.com/p/wavival"
        target="_blank"
        icon="link"
        aria-label={isEn
          ? "Valentina Ramírez's Platzi profile"
          : "Perfil de Platzi de Valentina Ramírez"}
      />
      <Link
        href="https://blog.luminaw.co"
        class="!text-base"
        target="_blank"
        aria-label={isEn
          ? "Lúmina W blog by Valentina Ramírez"
          : "Blog de Lúmina W creado por Valentina Ramírez"}
        >Blog W
      </Link>
    </div>
  </div>
</section>

---
import Link from "@/components/ui/Link.astro";
import { projects } from "@/data/projects";
import type { Project } from "@/data/projects";

interface Props {
  featured?: boolean;
  lang?: "es" | "en";
  heading?: "h1" | "h2";
}

const { featured = false, lang = "es", heading = "h2" } = Astro.props;
const isEn = lang === "en";
const Heading = heading;

const base = import.meta.env.BASE_URL;

const featuredSlugs = ["terracore", "okroot", "nullbreach"];
const list = featured ? projects.filter((p) => featuredSlugs.includes(p.slug)) : projects;

const tagStyles: Record<string, string> = {
  green: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400",
  blue: "bg-blue-100 text-blue-900 dark:bg-blue-900/30 dark:text-blue-300",
  orange: "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
  gray: "bg-[var(--bg-blur)] text-[var(--text-muted)]",
};

const filterDefs = [
  { key: "all", label: isEn ? "All" : "Todos" },
  { key: "full-stack", label: "Full Stack" },
  { key: "ia", label: isEn ? "AI" : "IA" },
  { key: "pwa", label: "PWA" },
  { key: "landing", label: "Landing" },
  { key: "diseno", label: isEn ? "Design" : "Diseño" },
];

function getImageAlt(p: Project): string {
  return isEn ? (p.en?.imageAlt ?? p.imageAlt ?? "") : (p.imageAlt ?? "");
}
function getProblem(p: Project): string {
  return isEn ? (p.en?.problem ?? p.problem) : p.problem;
}
function getSolution(p: Project): string {
  return isEn ? (p.en?.solution ?? p.solution) : p.solution;
}
function getLinks(p: Project) {
  return isEn ? (p.en?.links ?? p.links) : p.links;
}
---

<section id="projects" class="section !pb-0" data-aos="fade-up">
  <p class="section-subtitle">{isEn ? "Projects" : "Proyectos"}</p>
  <Heading class="section-title"
    >{isEn ? "From challenge to product" : "Del reto al producto"}</Heading
  >

  <p class="text-[var(--text-muted)] leading-relaxed mt-4 max-w-2xl">
    {
      isEn
        ? "Real systems in production: complex business logic, integrated AI, and security by design."
        : "Sistemas reales en producción: lógica de negocio compleja, IA integrada y seguridad desde el diseño."
    }
  </p>

  {
    !featured && (
      <div
        id="project-filters"
        class="flex flex-wrap gap-2 mt-8"
        role="group"
        aria-label={isEn ? "Filter projects" : "Filtrar proyectos"}
      >
        {filterDefs.map(({ key, label }) => (
          <button
            type="button"
            data-filter={key}
            data-active={key === "all" ? "true" : undefined}
            class="filter-btn px-3 py-1.5 rounded-full text-xs font-display font-semibold border transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)]"
            aria-pressed={key === "all" ? "true" : "false"}
          >
            {label}
          </button>
        ))}
      </div>
    )
  }

  <div class="flex flex-col gap-8 mt-10">
    {
      list.map((p) => (
        <article
          class="card !p-0 overflow-hidden flex flex-col"
          style={
            p.slug === "terracore"
              ? "border-color: var(--brand-blue); background-color: var(--bg-blur);"
              : ""
          }
          data-project-card
          data-filters={(p.filters ?? []).join(" ")}
        >
          {p.image && (
            <div class="proj-img-wrap">
              <img
                src={`${import.meta.env.BASE_URL}${p.image}`}
                alt={getImageAlt(p)}
                width={p.imageWidth}
                height={p.imageHeight}
                loading="lazy"
                decoding="async"
                class="w-full h-auto block"
              />
            </div>
          )}

          <div class="flex flex-col gap-5 p-6">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div class="flex flex-col gap-1">
                {p.slug === "terracore" && (
                  <span class="text-[var(--brand-blue-text)] font-semibold text-xs uppercase tracking-widest">
                    {isEn ? "Featured project" : "Proyecto destacado"}
                  </span>
                )}
                {p.slug === "nullbreach" && (
                  <span class="text-[var(--brand-blue-text)] font-semibold text-xs uppercase tracking-widest">
                    {isEn ? "AI · Security" : "IA · Seguridad"}
                  </span>
                )}
                <h3 class="font-display font-bold text-2xl leading-tight text-[var(--text-primary)]">
                  {p.title}
                </h3>
              </div>
              <span
                class={`text-xs font-semibold px-3 py-1 rounded-full shrink-0 mt-0.5 ${tagStyles[p.tagColor]}`}
              >
                {p.tag}
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 border border-[var(--border-base)] rounded-[var(--radius-md)] overflow-hidden text-sm">
              <div class="p-4 flex flex-col gap-2">
                <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)]">
                  {isEn ? "The challenge" : "El reto"}
                </span>
                <p class="text-[var(--text-muted)] leading-relaxed">{getProblem(p)}</p>
              </div>
              <div class="p-4 flex flex-col gap-2 border-t border-[var(--border-base)] md:border-t-0 md:border-l bg-[var(--bg-blur)]">
                <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)]">
                  {isEn ? "What I built" : "Lo que construí"}
                </span>
                <p class="text-[var(--text-muted)] leading-relaxed">{getSolution(p)}</p>
              </div>
            </div>

            <div class="flex flex-col gap-2 items-center">
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)]">
                Stack
              </span>
              <div class="flex flex-wrap gap-1.5 justify-center">
                {p.stack.map((s) => (
                  <span class="chip !text-[var(--text-primary)]">{s}</span>
                ))}
              </div>
            </div>

            {(() => {
              const caseStudyTarget = p.linkedCaseStudy ?? (p.caseStudy ? p.slug : null);
              const links = getLinks(p);
              const siteLink = links.find(
                (l) =>
                  l.text === "Ver sitio" ||
                  l.text === "Visit site" ||
                  l.text === "Ver app" ||
                  l.text === "View app"
              );
              const otherLinks = links.filter((l) => l !== siteLink);
              const hasAnyLink = siteLink || caseStudyTarget || otherLinks.length > 0;
              return hasAnyLink ? (
                <div class="flex gap-4 flex-wrap justify-center">
                  {caseStudyTarget && (
                    <Link
                      href={
                        isEn
                          ? `${base}en/projects/${caseStudyTarget}`
                          : `${base}proyectos/${caseStudyTarget}`
                      }
                      class="!text-xs"
                      aria-label={
                        isEn
                          ? `Read the ${p.title} case study`
                          : `Leer el caso de estudio de ${p.title}`
                      }
                    >
                      {isEn ? "Case study" : "Caso de estudio"}
                    </Link>
                  )}
                  {siteLink && (
                    <Link
                      href={siteLink.href}
                      class="!text-xs"
                      target="_blank"
                      aria-label={siteLink.ariaLabel}
                      data-umami-event={siteLink.event}
                    >
                      {siteLink.text}
                    </Link>
                  )}
                  {otherLinks.map((l) => (
                    <Link
                      href={l.href}
                      class="!text-xs"
                      target="_blank"
                      aria-label={l.ariaLabel}
                      data-umami-event={l.event}
                    >
                      {l.text}
                    </Link>
                  ))}
                </div>
              ) : null;
            })()}
          </div>
        </article>
      ))
    }
  </div>

  <div id="projects-no-results" class="hidden mt-12 py-8 text-center" role="status">
    <p class="font-display font-semibold text-lg text-[var(--text-primary)]">
      {isEn ? "No results" : "Sin resultados"}
    </p>
    <p class="mt-2 text-sm text-[var(--text-muted)]">
      {isEn ? "No projects match this filter." : "Ningún proyecto coincide con este filtro."}
    </p>
  </div>

  {
    featured && (
      <div class="mt-12 flex justify-center" data-aos="fade-up">
        <Link
          href={isEn ? `${base}en/projects` : `${base}proyectos`}
          aria-label={
            isEn ? "See all projects and the lab" : "Ver todos los proyectos y el laboratorio"
          }
        >
          {isEn ? "See all projects" : "Ver todos los proyectos"}
        </Link>
      </div>
    )
  }
</section>

<style>
  .filter-btn {
    color: var(--text-muted);
    border-color: var(--text-muted);
    background-color: transparent;
  }

  .filter-btn:hover {
    color: var(--brand-blue-text);
    border-color: var(--brand-blue-text);
  }

  .filter-btn[data-active="true"] {
    background-color: var(--brand-blue-text);
    color: white;
    border-color: var(--brand-blue-text);
  }

  [data-project-card].is-filtering-out {
    opacity: 0;
    transform: translateY(8px) scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-project-card].is-filtering-out {
      transform: none;
    }
  }

  .proj-img-wrap {
    overflow: hidden;
  }

  .proj-img-wrap img {
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  article:hover .proj-img-wrap img {
    transform: scale(1.03);
  }
</style>

<script>
  function initProjectFilters() {
    const filterContainer = document.getElementById("project-filters");
    if (!filterContainer) return;

    const buttons = filterContainer.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");
    const noResults = document.getElementById("projects-no-results");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter ?? "all";

        buttons.forEach((b) => {
          const active = b === btn;
          if (active) {
            b.setAttribute("data-active", "true");
          } else {
            b.removeAttribute("data-active");
          }
          b.setAttribute("aria-pressed", active ? "true" : "false");
        });

        let visible = 0;
        cards.forEach((card) => {
          const cardFilters = (card.dataset.filters ?? "").split(" ").filter(Boolean);
          const show = filter === "all" || cardFilters.includes(filter);

          if (show) {
            visible++;
            card.style.display = "";
            requestAnimationFrame(() => card.classList.remove("is-filtering-out"));
          } else {
            card.classList.add("is-filtering-out");
            window.setTimeout(() => {
              if (card.classList.contains("is-filtering-out")) card.style.display = "none";
            }, 200);
          }
        });

        if (noResults) {
          noResults.classList.toggle("hidden", visible > 0);
        }
      });
    });
  }

  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>

---
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import { cvHref } from "@/i18n/utils";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const isEn = lang === "en";

const base = import.meta.env.BASE_URL;
const cv = cvHref(lang, base);
const cvFile = cv.slice(base.length);
---

<section class="section min-h-[calc(100dvh-64px)] flex items-center" id="hero">
  <div class="w-full flex flex-col md:flex-row-reverse items-center gap-12">
    <div class="w-full md:w-2/5 flex justify-center">
      <img
        src={`${base}images/profile.webp`}
        alt={isEn ? "Profile photo of Valentina Ramírez" : "Foto de perfil de Valentina Ramírez"}
        fetchpriority="high"
        decoding="async"
        width="320"
        height="320"
        class="w-64 h-64 md:w-80 md:h-80 rounded-full object-cover border-4 border-[var(--brand-blue)] shadow-lg"
      />
    </div>

    <div class="w-full md:w-3/5 flex flex-col gap-6">
      <h1
        class="font-display font-bold text-[var(--text-primary)] text-4xl md:text-5xl leading-tight"
      >
        Full Stack Developer.<br />
        <span class="text-[var(--brand-blue)]">
          {isEn ? "The code I ship, I also break." : "El código que firmo también lo rompo."}
        </span>
      </h1>

      <p class="text-[var(--text-muted)] text-base md:text-lg leading-relaxed">
        {
          isEn
            ? "I'm Valentina Ramírez, a Colombian Full Stack Developer working with Django, React, and Next.js."
            : "Soy Valentina Ramírez, Full Stack Developer colombiana con experiencia en Django, React y Next.js."
        }
      </p>

      <p class="text-[var(--text-muted)] text-base md:text-lg leading-relaxed">
        {
          isEn
            ? "I deliver real applications: multi-user, complex business logic, my own APIs, and frontends people actually use. Offensive mindset to write code that doesn't break, with AI integrated where it counts."
            : "Entrego aplicaciones reales: multiusuario, lógica de negocio compleja, APIs propias y frontends que la gente usa. Mentalidad ofensiva para escribir código que no se rompe, con IA integrada donde resuelve."
        }
      </p>

      <p class="text-xs text-[var(--text-muted)] font-display tracking-wide">
        {
          isEn
            ? "3 apps in production · Founder of Lúmina W"
            : "3 apps en producción · Fundadora de Lúmina W"
        }
      </p>

      <div class="flex items-center gap-5 flex-wrap">
        <Button
          href={cv}
          download={cvFile}
          icon="download-cv-white"
          data-umami-event={isEn ? "cv-descarga-en" : "cv-descarga-es"}
          aria-label={isEn
            ? "Download Valentina Ramírez's CV in PDF"
            : "Descargar CV de Valentina Ramírez en PDF"}
        >
          {isEn ? "Download CV" : "Descargar CV"}
        </Button>
        <Link
          href={isEn ? `${base}en/services` : `${base}servicios`}
          aria-label={isEn
            ? "See Valentina Ramírez's full services"
            : "Ver los servicios de Valentina Ramírez"}
        >
          {isEn ? "See services" : "Ver servicios"}
        </Link>
        <div class="flex items-center gap-[16px]">
          <Link
            href="https://linkedin.com/in/wavival"
            target="_blank"
            icon="linkedin"
            aria-label={isEn
              ? "Valentina Ramírez on LinkedIn"
              : "Perfil de LinkedIn de Valentina Ramírez"}
          />
          <Link
            href="https://github.com/wavival"
            target="_blank"
            icon="github"
            aria-label={isEn
              ? "Valentina Ramírez on GitHub"
              : "Perfil de GitHub de Valentina Ramírez"}
          />
        </div>
      </div>
    </div>
  </div>
</section>

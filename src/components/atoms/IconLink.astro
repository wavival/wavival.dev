---
import Button from "@/components/atoms/Button.astro";

/** Icon-only anchor: the `icon` tier of `Button` (`.icon-btn`), `label` is its `aria-label`. */
interface Props {
  href: string;
  icon: string;
  label: string;
  target?: "_blank" | "_self";
  size?: "md" | "lg";
  class?: string;
  "data-umami-event"?: string;
}

const {
  href,
  icon,
  label,
  target = "_blank",
  size = "md",
  class: extra = "",
  "data-umami-event": umamiEvent,
} = Astro.props;
---

<Button
  variant="icon"
  href={href}
  icon={icon}
  aria-label={label}
  target={target}
  size={size}
  class={extra}
  data-umami-event={umamiEvent}
/>

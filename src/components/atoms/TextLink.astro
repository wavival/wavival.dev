---
import Button from "@/components/atoms/Button.astro";
import { labelInName, visibleText } from "@/utils/a11y";

/**
 * Text links. The default `text` variant is the tertiary tier of `Button`
 * (`.action-link`); `list` and `inline` are the plain list and in-prose links.
 * None of them carries an icon.
 */
interface Props {
  href: string;
  target?: "_blank" | "_self";
  /** underlined display link, plain list link, or inline underlined body link */
  variant?: "text" | "list" | "inline";
  class?: string;
  hreflang?: string;
  "aria-label"?: string;
  "aria-current"?: "page" | undefined;
  "data-umami-event"?: string;
}

const {
  href,
  target = "_self",
  variant = "text",
  class: extra = "",
  hreflang,
  "aria-label": ariaLabel,
  "aria-current": ariaCurrent,
  "data-umami-event": umamiEvent,
} = Astro.props;

const rel = target === "_blank" ? "noopener noreferrer" : undefined;
const base = variant === "list" ? "list-link" : "inline-link";
const accessibleName = ariaLabel
  ? labelInName(visibleText(await Astro.slots.render("default")), ariaLabel)
  : undefined;
---

{
  variant === "text" ? (
    <Button
      variant="tertiary"
      href={href}
      target={target}
      class={extra}
      hreflang={hreflang}
      aria-label={ariaLabel}
      aria-current={ariaCurrent}
      data-umami-event={umamiEvent}
    >
      <slot />
    </Button>
  ) : (
    <a
      href={href}
      target={target}
      rel={rel}
      hreflang={hreflang}
      class={`${base} ${extra}`.trim()}
      aria-label={accessibleName}
      aria-current={ariaCurrent}
      data-umami-event={umamiEvent}
    >
      <slot />
    </a>
  )
}

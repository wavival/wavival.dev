---
interface Props {
  name: string;
  size?: "md" | "lg" | "xl";
  class?: string;
}

const { name, size = "md", class: extra = "" } = Astro.props;
const src = `${import.meta.env.BASE_URL}icons/ui/${name}.svg`;
const sizeClass = size === "lg" ? "mask-icon-lg" : size === "xl" ? "mask-icon-xl" : "";
---

<span
  class={`mask-icon ${sizeClass} ${extra}`.trim()}
  style={`--icon:url(${src})`}
  aria-hidden="true"
>
</span>

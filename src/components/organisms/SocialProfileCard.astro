---
import Badge from "@/components/atoms/Badge.astro";
import MaskIcon from "@/components/atoms/MaskIcon.astro";
import { SOCIAL_PROFILES, type SocialNetwork } from "@/data/social";

/**
 * One profile card of the "Redes" / "Social" section of the tools pages. The
 * `featured` variant mirrors the featured GitHub card (blue top rule, surface
 * background, large handle) and the `repo` variant mirrors `RepoCard`, so only
 * one profile reads as highlighted. The whole card is the link and, like
 * `RepoCard`, its accessible name is its visible content (network, handle and
 * the one line about the content from the default slot); the URL and the handle
 * come from `src/data/social.ts`.
 */
interface Props {
  network: SocialNetwork;
  name: string;
  variant?: "featured" | "repo";
}

const { network, name, variant = "featured" } = Astro.props;
const profile = SOCIAL_PROFILES[network];
const featured = variant === "featured";

const cardClass = featured
  ? "flex h-full flex-col border border-line border-t-2 border-t-blue bg-surface p-6 text-ink no-underline transition-colors hover:border-blue hover:text-ink md:p-10"
  : "flex h-full flex-col gap-[10px] border border-line bg-bg p-5 text-ink no-underline transition-colors hover:border-blue hover:text-ink";
const handleClass = featured
  ? "h-title mt-4 block text-4xl tracking-[-0.03em]"
  : "h-title wrap-break-word block text-lg";
const lineClass = featured ? "body mt-[10px] block" : "block text-[13px] leading-[1.6] text-muted";
---

<a
  href={profile.href}
  target="_blank"
  rel="noopener noreferrer"
  data-social-profile={network}
  data-variant={variant}
  class={cardClass}
>
  <span class="flex items-center justify-between gap-4">
    <Badge>{name}</Badge>
    <MaskIcon name={network} size={featured ? "xl" : "lg"} />
  </span>
  {profile.handle && <span class={handleClass}>{profile.handle}</span>}
  <span class={lineClass}><slot /></span>
</a>

---
import Button from "@/components/atoms/Button.astro";
import Eyebrow from "@/components/atoms/Eyebrow.astro";
import { serviceById } from "@/data/services";
import { siteRoutes } from "@/i18n/utils";

interface Props {
  lang?: "es" | "en";
  /** Where the secondary button goes: the services page, or the contact page on the services pages themselves. */
  secondary?: "services" | "contact";
}

const { lang = "es", secondary = "services" } = Astro.props;
const isEn = lang === "en";
const r = siteRoutes(lang, import.meta.env.BASE_URL);
// The MVP timeline comes from the catalog, so the band and the services page never disagree.
const mvpTimeline = serviceById("custom-web-app-mvp").timeline[lang];
---

<section data-reveal id="contact" class="border-t border-line bg-surface">
  <div class="wrap py-sec">
    <Eyebrow>{isEn ? "One click away" : "A un click"}</Eyebrow>
    <h2 class="display-cta m-0 mt-5 max-w-[1100px] text-balance">
      {isEn ? "Less work by hand," : "Menos trabajo a mano,"}
      <span class="accent">
        {isEn ? "more customers who find you." : "más clientes que llegan solos."}
      </span>
    </h2>
    <div
      class="mt-12 flex flex-wrap items-end justify-between gap-x-16 gap-y-8 border-t border-line pt-8"
    >
      <div class="flex max-w-[620px] flex-[1_1_420px] flex-col gap-3">
        <p class="body-lg m-0 text-[17px]">
          {
            isEn
              ? "I build landing pages, websites, automations, chatbots and custom apps, plus the content that gets you found. Security by design and a fixed price."
              : "Construyo landing pages, sitios web, automatizaciones, chatbots y apps a medida, y el contenido para que te encuentren. Seguridad desde el diseño y precio fijo."
          }
        </p>
        <p class="m-0 text-sm text-muted" data-mvp-timeline>
          {
            isEn
              ? `MVP in ${mvpTimeline}. Limited availability, I reply within 24 hours.`
              : `MVP de ${mvpTimeline}. Disponibilidad limitada, respondo en 24 horas.`
          }
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 min-[640px]:justify-start">
        <Button href={r.quote} icon="calculator-white" data-umami-event="cta-quiero-producto">
          {isEn ? "Get a quote" : "Cotizar mi proyecto"}
        </Button>
        {
          secondary === "contact" ? (
            <Button href={r.contact} variant="secondary">
              {isEn ? "Contact me" : "Contactar"}
            </Button>
          ) : (
            <Button href={r.services} variant="secondary">
              {isEn ? "View services" : "Ver servicios"}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

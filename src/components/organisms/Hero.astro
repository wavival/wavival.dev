---
import Button from "@/components/atoms/Button.astro";
import SocialLinks from "@/components/molecules/SocialLinks.astro";
import { siteRoutes } from "@/i18n/utils";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
const base = import.meta.env.BASE_URL;
const r = siteRoutes(lang, base);

const stats = isEn
  ? [
      { value: "3 apps", label: "in production" },
      { value: "Lúmina W", label: "founder" },
      { value: "24h", label: "response time" },
    ]
  : [
      { value: "3 apps", label: "en producción" },
      { value: "Lúmina W", label: "fundadora" },
      { value: "24h", label: "tiempo de respuesta" },
    ];
---

<section id="hero" class="wrap" style="padding-top:clamp(32px,5vw,72px);padding-bottom:var(--sec)">
  <div
    class="flex flex-wrap justify-center gap-x-6 gap-y-3 border-b border-line pb-[18px] font-display text-xs font-bold uppercase tracking-[0.16em] text-muted"
  >
    <span class="text-center">Valentina Ramírez · Colombia · COT (UTC-5)</span>
    <span class="inline-flex items-center gap-[10px]">
      <span class="status-dot status-dot-ok status-dot-lg" aria-hidden="true"></span>
      {
        isEn
          ? "Limited availability · I respond within 24h"
          : "Disponibilidad limitada · Respondo en 24h"
      }
    </span>
  </div>

  <div
    class="mx-auto flex max-w-[1040px] flex-col items-center gap-5 text-center"
    style="margin-top:clamp(36px,5vw,64px);margin-bottom:clamp(36px,5vw,64px)"
  >
    <h1 class="display-hero m-0" style="text-wrap:balance">
      {
        isEn
          ? "I help entrepreneurs save time with secure software and AI automation, and I show how I build it in public."
          : "Ayudo a emprendedores a ahorrar tiempo con software seguro y automatización con IA, y muestro en público cómo lo construyo."
      }
    </h1>
    <p class="lead accent m-0" data-hero-tagline>
      {isEn ? "The code I ship, I also break." : "El código que firmo también lo rompo."}
    </p>
  </div>

  <div class="flex flex-col items-center gap-10 text-center">
    <figure class="m-0 w-full max-w-[320px]">
      <div class="photo-frame">
        <img
          src={`${base}images/profile.webp`}
          alt={isEn ? "Profile photo of Valentina Ramírez" : "Foto de perfil de Valentina Ramírez"}
          fetchpriority="high"
          decoding="async"
          width="320"
          height="400"
        />
      </div>
      <figcaption class="mt-3 text-xs text-muted">
        {isEn ? "Fig. 01: Founder of Lúmina W" : "Fig. 01: Fundadora de Lúmina W"}
      </figcaption>
    </figure>

    <div class="flex w-full min-w-0 max-w-[680px] flex-col items-center gap-6">
      <p class="lead m-0" data-hero-lead>
        {
          isEn
            ? "I'm Valentina Ramírez, a Colombian software developer focused on backend, AI and security. I build landing pages, websites, chatbots and custom apps for businesses that want to stop doing everything by hand."
            : "Soy Valentina Ramírez, desarrolladora de software colombiana con enfoque en backend, IA y seguridad. Construyo landing pages, sitios web, chatbots y apps a medida para negocios que quieren dejar de hacer todo a mano."
        }
      </p>
      <p class="body-lg m-0 text-[17px] leading-[1.7]">
        {
          isEn
            ? "I deliver real applications: multi-user, complex business logic, my own APIs, and frontends people actually use. Security by design to write code that doesn't break, with AI integrated where it counts."
            : "Entrego aplicaciones reales: multiusuario, lógica de negocio compleja, APIs propias y frontends que la gente usa. Seguridad desde el diseño para escribir código que no se rompe, con IA integrada donde resuelve."
        }
      </p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <Button href={r.services}>
          {isEn ? "See services" : "Ver servicios"}
        </Button>
        <SocialLinks lang={lang} size="lg" />
      </div>
      <dl
        class="m-0 mt-4 grid w-full border-t border-line"
        style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))"
      >
        {
          stats.map((s) => (
            <div class="px-3 pt-5">
              <dt class="h-title text-[36px] leading-none tracking-[-0.03em]">{s.value}</dt>
              <dd class="m-0 mt-2 text-[13px] text-muted">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

---
import Button from "@/components/atoms/Button.astro";
import SocialLinks from "@/components/molecules/SocialLinks.astro";
import { siteRoutes } from "@/i18n/utils";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
const base = import.meta.env.BASE_URL;
const r = siteRoutes(lang, base);

const stats = isEn
  ? [
      { value: "4 apps", label: "in production" },
      { value: "Lúmina\u00a0W", label: "founder" },
      { value: "24h", label: "response time" },
    ]
  : [
      { value: "4 apps", label: "en producción" },
      { value: "Lúmina\u00a0W", label: "fundadora" },
      { value: "24h", label: "tiempo de respuesta" },
    ];
---

<section id="hero" class="wrap" style="padding-top:clamp(32px,5vw,72px);padding-bottom:var(--sec)">
  <div
    class="flex flex-wrap justify-center gap-x-6 gap-y-3 border-b border-line pb-[18px] font-display text-xs font-bold uppercase tracking-[0.16em] text-muted"
  >
    <span class="text-center">Valentina Ramírez · Colombia&nbsp;·&nbsp;COT&nbsp;(UTC-5)</span>
    <span class="inline-flex items-center gap-[10px]">
      <span class="status-dot status-dot-ok status-dot-lg" aria-hidden="true"></span>
      {
        isEn
          ? "Limited availability · I reply within 24h"
          : "Disponibilidad limitada · Respondo en 24h"
      }
    </span>
  </div>

  <div
    class="mx-auto flex max-w-[1200px] flex-col items-center gap-5 text-center"
    style="margin-top:clamp(36px,5vw,64px);margin-bottom:clamp(36px,5vw,64px)"
  >
    <h1 class="display-hero m-0" style="text-wrap:balance">
      {
        isEn
          ? "I help entrepreneurs save time and sell more with software and digital marketing, and I show how I build it in public."
          : "Ayudo a emprendedores a ahorrar tiempo y vender más con software y marketing digital, y muestro en público cómo lo construyo."
      }
    </h1>
    <p class="lead accent m-0" data-hero-tagline>
      {
        isEn
          ? "I build what your business needs and make sure people find it."
          : "Construyo lo que tu negocio necesita y me aseguro de que la gente lo encuentre."
      }
    </p>
  </div>

  <div class="flex flex-col items-center gap-10 text-center">
    <figure class="m-0 w-full max-w-[320px]">
      <div class="photo-frame">
        <img
          src={`${base}images/profile.webp`}
          alt={isEn ? "Profile photo of Valentina Ramírez" : "Foto de perfil de Valentina Ramírez"}
          fetchpriority="high"
          decoding="async"
          width="320"
          height="400"
        />
      </div>
      <figcaption class="mt-3 text-xs text-muted">
        {isEn ? "Fig. 01: Founder of Lúmina W" : "Fig. 01: Fundadora de Lúmina W"}
      </figcaption>
    </figure>

    <div class="flex w-full min-w-0 max-w-[920px] flex-col items-center gap-6">
      <p class="lead m-0" data-hero-lead>
        {
          isEn
            ? "I'm Valentina Ramírez, a Colombian software developer and digital strategist. My two strengths are software and digital marketing: I build landing pages, websites, chatbots and custom apps for businesses that want to stop doing everything by hand and sell more on social media."
            : "Soy Valentina Ramírez, desarrolladora de software colombiana y estratega digital. Mis dos fuertes son el software y el marketing digital: construyo landing pages, sitios web, chatbots y apps a medida para negocios que quieren dejar de hacer todo a mano y vender más en redes."
        }
      </p>
      <p class="body-lg m-0 text-[17px] leading-[1.7]">
        {
          isEn
            ? "I deliver real applications: multi-user, complex business logic, my own APIs, and frontends people actually use. Security by design, so the code doesn't break, with AI integrated where it counts."
            : "Entrego aplicaciones reales: multiusuario, lógica de negocio compleja, APIs propias y frontends que la gente usa. Seguridad desde el diseño para escribir código que no se rompe, con IA integrada donde resuelve."
        }
      </p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <Button href={r.services} icon="briefcase-white">
          {isEn ? "View services" : "Ver servicios"}
        </Button>
        <SocialLinks lang={lang} size="lg" networks={["instagram", "tiktok", "linkedin"]} />
      </div>
      <dl
        class="m-0 mt-4 grid w-full border-t border-line"
        style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))"
      >
        {
          stats.map((s) => (
            <div class="px-3 pt-5">
              <dt
                class="h-title whitespace-nowrap leading-none tracking-[-0.03em]"
                style="font-size:clamp(28px,8vw,36px)"
              >
                {s.value}
              </dt>
              <dd class="m-0 mt-2 text-[13px] text-muted">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

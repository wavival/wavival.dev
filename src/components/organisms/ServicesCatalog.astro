---
// The services catalog in one language: the three groups (development, digital
// marketing, complementary) with their numbered rows, the general exclusions and
// the block for technical teams. Copy comes from `src/data/services.ts`; every
// amount is a `Price` in the currency of the page variant being built.
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import ServiceRow from "@/components/organisms/ServiceRow.astro";
import StickyContentSection from "@/components/organisms/StickyContentSection.astro";
import {
  GENERAL_EXCLUSIONS,
  SERVICE_GROUPS,
  SERVICE_LABELS,
  SERVICES,
  TECHNICAL_TEAMS_SERVICE,
  fillServiceText,
  servicesInGroup,
  type ServiceExample,
} from "@/data/services";
import { siteRoutes, type Lang } from "@/i18n/utils";
import { currencyForPathname } from "@/utils/currency";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const r = siteRoutes(lang, base);
const currency = currencyForPathname(Astro.url.pathname);
const labels = SERVICE_LABELS[lang];
const fill = (text: string) => fillServiceText(text, currency, lang);
const serviceBanners = {
  development: {
    es: "Desarrollo: landing pages, sitios web, automatizaciones, chatbots y apps a medida",
    en: "Development: landing pages, websites, automations, chatbots and custom apps",
  },
  marketing: {
    es: "Marketing digital: estrategia de oferta y lanzamientos, presencia digital y posicionamiento",
    en: "Digital marketing: offer and launch strategy, digital presence and SEO",
  },
  complementary: {
    es: "Complementarios: revisión de seguridad y soporte mensual",
    en: "Complementary: security review and monthly support",
  },
} as const;
// `anchor` is the id of each group section, so `/servicios#desarrollo` or
// `/en/services#development` opens that group directly.
const groupLayout = {
  development: {
    anchor: { es: "desarrollo", en: "development" },
    eyebrow: { es: "DESARROLLO", en: "DEVELOPMENT" },
    title: { es: "Desarrollo de software", en: "Software development" },
    description: {
      es: "Landing pages, sitios, automatizaciones, chatbots y apps para convertir tareas manuales en software que mueve tu negocio.",
      en: "Landing pages, websites, automations, chatbots and apps that turn manual work into software that drives your business.",
    },
  },
  marketing: {
    anchor: { es: "marketing", en: "marketing" },
    eyebrow: { es: "MARKETING", en: "MARKETING" },
    title: { es: "Marketing digital", en: "Digital marketing" },
    description: {
      es: "Estrategia de oferta y de lanzamientos, presencia digital y posicionamiento para que lo que ofreces llegue a quien lo necesita y se venda.",
      en: "Offer and launch strategy, digital presence and SEO so that what you offer reaches the people who need it and sells.",
    },
  },
  complementary: {
    anchor: { es: "complementarios", en: "complementary" },
    eyebrow: { es: "COMPLEMENTARIOS", en: "COMPLEMENTARY" },
    title: { es: "Seguridad y soporte", en: "Security and support" },
    description: {
      es: "Una revisión para encontrar lo que puede fallar y soporte para que lo que ya funciona siga funcionando.",
      en: "A review to find what could fail and support to keep what already works working.",
    },
  },
} as const;
const exampleLinks = (examples: readonly ServiceExample[] = []) =>
  examples.map((example) => ({
    name: example.name,
    description: example.description[lang],
    href: `${r.project(example.slug)}${example.part ? `#${example.part}` : ""}`,
  }));
const indexOf = (id: string) =>
  String(SERVICES.findIndex((service) => service.id === id) + 1).padStart(2, "0");
---

{
  SERVICE_GROUPS.map((group, i) => (
    <StickyContentSection
      id={groupLayout[group.id].anchor[lang]}
      dataServiceGroup={group.id}
      index={String(i + 1).padStart(2, "0")}
      eyebrow={groupLayout[group.id].eyebrow[lang]}
      title={groupLayout[group.id].title[lang]}
      description={groupLayout[group.id].description[lang]}
      class={i === 0 ? "mt-[72px]" : "section-gap"}
    >
      <img
        src={`${base}images/services/services-${group.id}.webp`}
        alt={serviceBanners[group.id][lang]}
        width="1600"
        height="500"
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
        data-service-banner={group.id}
        class="block h-auto w-full"
      />
      <div class="mt-10 border-t border-ink">
        {servicesInGroup(group.id).map((service) => (
          <ServiceRow
            index={indexOf(service.id)}
            id={service.id}
            title={service.title[lang]}
            body={fill(service.body[lang])}
            priceId={service.priceId}
            priceText={service.customQuote ? labels.customQuote : undefined}
            tiers={service.tiers?.map((tier) => ({
              name: tier.name[lang],
              priceId: tier.priceId,
              includes: tier.includes[lang],
            }))}
            timeline={service.timeline[lang]}
            includes={service.includes?.[lang]}
            excludes={service.excludes[lang]}
            note={service.note ? fill(service.note[lang]) : undefined}
            badge={service.badge?.[lang]}
            examples={exampleLinks(service.examples)}
            quoteHref={`${r.quote}?service=${service.id}`}
            labels={labels}
          />
        ))}
      </div>
    </StickyContentSection>
  ))
}

<section data-service-exclusions>
  <SectionHeader
    label={labels.exclusionsLabel}
    title={labels.exclusionsTitle}
    titleClass="h-title text-[32px] leading-[1.05] tracking-[-0.02em]"
    class="section-gap"
  />
  <ul class="m-0 mt-8 list-none border-t border-line p-0">
    {
      GENERAL_EXCLUSIONS[lang].map((item) => (
        <li
          class="border-b border-line py-3.5 text-[15px] leading-relaxed text-muted"
          style="text-wrap:pretty"
        >
          {item}
        </li>
      ))
    }
  </ul>
</section>

<section data-service-technical>
  <SectionHeader
    label={labels.technicalLabel}
    title={labels.technicalTitle}
    intro={labels.technicalIntro}
    class="section-gap"
  />
  <div class="mt-10 border-t border-ink">
    <ServiceRow
      title={TECHNICAL_TEAMS_SERVICE.title[lang]}
      body={TECHNICAL_TEAMS_SERVICE.body[lang]}
      timeline={TECHNICAL_TEAMS_SERVICE.timeline[lang]}
      tools={[...TECHNICAL_TEAMS_SERVICE.tools]}
      examples={exampleLinks(TECHNICAL_TEAMS_SERVICE.examples)}
      quoteHref={`${r.quote}?service=rest-apis-backend`}
      quoteLabel={labels.technicalQuote}
      labels={labels}
    />
  </div>
</section>

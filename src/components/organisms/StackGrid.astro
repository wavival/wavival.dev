---
import Bento from "@/components/molecules/Bento.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import { stack } from "@/data/stack";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
const mobileOrders = [1, 2, 4, 3, 5, 6];
const styles = stack.map(
  (s, i) => `--span:${s.featured ? 2 : 1};--mobile-order:${mobileOrders[i]}`
);
---

<Bento cells class="stack-grid">
  {
    stack.map((s, i) => (
      <article
        class={`flex flex-col gap-4 p-7 transition-colors hover:bg-tint ${s.featured ? "bg-tint shadow-[inset_0_2px_0_var(--blue)]" : ""}`.trim()}
        style={styles[i]}
        data-stack-card
        data-featured={s.featured ? "" : undefined}
      >
        <div class="flex items-center justify-between gap-3">
          <span class="index index-muted">{String(i + 1).padStart(2, "0")}</span>
          {s.featured && (
            <span class="label-sm label-sm-link">{isEn ? "Featured" : "Destacado"}</span>
          )}
        </div>
        <div>
          <h3 class="h-title m-0 text-2xl tracking-[-0.01em] text-link">{s.category}</h3>
          <p class="m-0 mt-[6px] text-sm text-muted">
            {isEn ? (s.descriptionEn ?? s.description) : s.description}
          </p>
        </div>
        <ChipList items={isEn ? (s.toolsEn ?? s.tools) : s.tools} class="mt-auto" />
      </article>
    ))
  }
</Bento>

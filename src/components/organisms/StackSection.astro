---
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import StackGrid from "@/components/organisms/StackGrid.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import { siteRoutes } from "@/i18n/utils";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
const r = siteRoutes(lang, import.meta.env.BASE_URL);
---

<section id="stack" class="wrap" style="padding-bottom:var(--sec)">
  <SectionHeader
    index="02"
    label={isEn ? "What I work with" : "Con qué trabajo"}
    title={isEn ? "Go-to stack" : "Stack favorito"}
    class="mb-12"
  />
  <StackGrid lang={lang} />
  <div class="mt-8 flex justify-center">
    <TextLink
      href={r.uses}
      aria-label={isEn
        ? "Technical criteria: tools breakdown and why I use them"
        : "Criterio técnico: detalle de herramientas y por qué las uso"}
    >
      {isEn ? "Technical criteria" : "Criterio técnico"}
    </TextLink>
  </div>
</section>

---
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import PullQuote from "@/components/molecules/PullQuote.astro";
import SocialLinks from "@/components/molecules/SocialLinks.astro";
import Button from "@/components/atoms/Button.astro";
import { siteRoutes } from "@/i18n/utils";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
const r = siteRoutes(lang, import.meta.env.BASE_URL);
---

<section data-reveal id="about" class="wrap" style="padding-bottom:var(--sec)">
  <SectionHeader
    index="03"
    label={isEn ? "Beyond the code" : "Más allá del código"}
    title={isEn ? "About me" : "Sobre mí"}
    class="mb-12"
  />
  <PullQuote size="lg" class="mb-14">
    {
      isEn ? (
        <>
          "A good product starts by <span class="accent">understanding who will use it</span> and is
          done when it reaches who will buy it."
        </>
      ) : (
        <>
          "Un buen producto empieza por <span class="accent">entender a quien lo va a usar</span> y
          termina cuando llega a quien lo va a comprar."
        </>
      )
    }
  </PullQuote>
  <div class="flex flex-col gap-5">
    {
      isEn ? (
        <>
          <p class="body-lg m-0 leading-[1.75]">
            I'm a self-taught software developer by conviction, with two strengths: software and
            digital marketing. I work with Django and React, with AI and security by design. I
            founded Lúmina&nbsp;W to build my own products. I also create content and know how to
            sell on social media, so the software I build is meant to bring in clients, not just to
            work. I study English Language at Universidad de San Buenaventura, learning in parallel
            because I don't know how to do it any other way.
          </p>
          <p class="body-lg m-0 leading-[1.75]">
            Outside of code, you'll find me in photography, behind the drums, and listening to a
            playlist that doesn't respect genres.
          </p>
        </>
      ) : (
        <>
          <p class="body-lg m-0 leading-[1.75]">
            Soy desarrolladora de software autodidacta por convicción, con dos fuertes: el software
            y el marketing digital. Trabajo con Django y React, con IA y seguridad desde el diseño.
            Fundé Lúmina&nbsp;W para construir productos propios. También creo contenido y sé vender
            en redes sociales, así que el software que hago está pensado para traer clientes, no
            solo para funcionar. Estudio Lengua Inglesa en la Universidad de San Buenaventura,
            aprendo en paralelo porque no sé hacerlo de otra forma.
          </p>
          <p class="body-lg m-0 leading-[1.75]">
            Fuera del código me encuentra la fotografía, la batería y una playlist que no respeta
            géneros.
          </p>
        </>
      )
    }
  </div>
  <div
    class="mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-5 border-t border-line pt-6"
  >
    <SocialLinks lang={lang} networks={["instagram", "tiktok", "linkedin"]} />
    <div class="flex flex-wrap items-center gap-3">
      <Button
        href="https://blog.luminaw.co"
        target="_blank"
        variant="primary"
        size="sm"
        icon="read-more-white"
        aria-label={isEn
          ? "Read Blog W: Lúmina W blog by Valentina Ramírez"
          : "Leer Blog W: blog de Lúmina W creado por Valentina Ramírez"}
      >
        {isEn ? "Read Blog W" : "Leer Blog W"}
      </Button>
      <Button href={r.about} variant="secondary" size="sm">
        {isEn ? "Read about me" : "Leer sobre mí"}
      </Button>
    </div>
  </div>
</section>

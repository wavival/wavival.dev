---
import Bento from "@/components/molecules/Bento.astro";
import Disclosure from "@/components/molecules/Disclosure.astro";
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import { bentoStyles } from "@/utils/bento";

interface Props {
  fit: {
    yesTitle: string;
    noTitle: string;
    yes: string[];
    no: string[];
    yesMark: string;
    noMark: string;
  };
  processTitle: string;
  processLabel: string;
  process: { step: string; title: string; body: string }[];
  faqTitle: string;
  faqs: { id: string; q: string; a: string }[];
  /** Labels of the disclosure toggle of each question. */
  faqOpenLabel: string;
  faqCloseLabel: string;
}

const { fit, processTitle, processLabel, process, faqTitle, faqs, faqOpenLabel, faqCloseLabel } =
  Astro.props;
const processStyles = bentoStyles(process.length);
---

<div
  data-reveal
  class="section-gap grid gap-px border border-line bg-line"
  style="grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr))"
>
  <div class="bg-bg" style="padding:clamp(28px,3vw,44px)">
    <h3 class="h-title m-0 mb-6 text-[28px] tracking-[-0.02em]">{fit.yesTitle}</h3>
    <ul class="m-0 list-none p-0">
      {
        fit.yes.map((f) => (
          <li class="flex gap-4 border-t border-line py-3.5 text-[15px] leading-relaxed text-ink">
            <span aria-hidden="true" class="h-title flex-none basis-6 pt-[3px] text-xs text-ok">
              {fit.yesMark}
            </span>
            {f}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="bg-bg" style="padding:clamp(28px,3vw,44px)">
    <h3 class="h-title m-0 mb-6 text-[28px] tracking-[-0.02em] text-muted">{fit.noTitle}</h3>
    <ul class="m-0 list-none p-0">
      {
        fit.no.map((f) => (
          <li class="flex gap-4 border-t border-line py-3.5 text-[15px] leading-relaxed text-muted">
            <span aria-hidden="true" class="h-title flex-none basis-6 pt-[3px] text-xs text-muted">
              {fit.noMark}
            </span>
            {f}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<SectionHeader label={processLabel} title={processTitle} class="section-gap mb-12" />
<Bento as="ol" class="m-0 list-none gap-8 p-0">
  {
    process.map((p, i) => (
      <li class="flex flex-col gap-3.5" style={processStyles[i]}>
        <div class="flex items-center gap-3">
          <span class="h-title text-[56px] leading-none tracking-[-0.04em] text-blue">
            {p.step}
          </span>
          <span class="h-px flex-1 bg-line" aria-hidden="true" />
        </div>
        <h3 class="h-title m-0 text-[22px]">{p.title}</h3>
        <p class="body m-0 text-sm">{p.body}</p>
      </li>
    ))
  }
</Bento>

<SectionHeader label="FAQ" title={faqTitle} class="section-gap mb-12" />
<div class="flex flex-col border-t border-line" data-services-faq>
  {
    faqs.map((f, i) => (
      <div id={`faq-${f.id}`} data-faq-item>
        <Disclosure
          index={String(i + 1).padStart(2, "0")}
          title={f.q}
          openLabel={faqOpenLabel}
          closeLabel={faqCloseLabel}
        >
          <p class="body m-0 max-w-[70ch] text-[15px]">{f.a}</p>
        </Disclosure>
      </div>
    ))
  }
</div>

---
import Button from "@/components/atoms/Button.astro";

interface Props {
  title: string;
  text: string;
  homeHref: string;
  homeLabel: string;
}

const { title, text, homeHref, homeLabel } = Astro.props;
---

<section
  class="wrap flex flex-col justify-center"
  style="padding-top:clamp(48px,6vw,96px);padding-bottom:clamp(48px,6vw,96px);min-height:calc(100vh - var(--nav-h))"
>
  <p
    aria-hidden="true"
    class="h-title m-0 text-transparent"
    style="font-size:clamp(140px,30vw,420px);line-height:.8;letter-spacing:-0.06em;-webkit-text-stroke:2px var(--blue)"
  >
    404
  </p>
  <div
    class="mt-12 flex flex-wrap items-end justify-between gap-x-12 gap-y-6 border-t border-ink pt-6"
  >
    <div>
      <h1 class="h-title m-0 tracking-[-0.03em]" style="font-size:clamp(32px,4vw,56px)">{title}</h1>
      <p class="m-0 mt-3 text-base text-muted">{text}</p>
    </div>
    <Button href={homeHref} variant="secondary">{homeLabel}</Button>
  </div>
</section>

---
import Button from "@/components/atoms/Button.astro";
import { LEGACY_QUOTE_SERVICE_IDS } from "@/data/quoteOptions";
import type { Lang } from "@/i18n/utils";
import type { Currency } from "@/utils/currency";

interface Option {
  id: string;
  label: string;
}

interface Props {
  lang: Lang;
  /** Currency of the page variant; the budget ranges and the payload carry it. */
  currency: Currency;
  services: Option[];
  countries: Option[];
  /** ISO code selected when the page renders (the COP variant knows it is Colombia). */
  defaultCountry?: string;
  budgetRanges: Option[];
  howFound: Option[];
  preferredChannels: Option[];
  timelines: Option[];
  labels: {
    formTitle: string;
    formIntro: string;
    nextTitle: string;
    nextSteps: string[];
    placeholders: {
      name: string;
      email: string;
      business: string;
      description: string;
    };
    phonePlaceholder: string;
    phoneError: string;
    submitHint: string;
    name: string;
    email: string;
    phone: string;
    business: string;
    services: string;
    country: string;
    countryPlaceholder: string;
    budget: string;
    budgetPlaceholder: string;
    description: string;
    descriptionHint: string;
    optionalTitle: string;
    optionalPlaceholder: string;
    howFound: string;
    preferredChannel: string;
    timeline: string;
    submit: string;
    sending: string;
    successTitle: string;
    success: string;
    error: string;
    privacyPrefix: string;
    privacyLink: string;
    privacySuffix: string;
    required: string;
    requiredTip: string;
  };
  privacyHref: string;
}

const {
  lang,
  currency,
  services,
  countries,
  defaultCountry,
  budgetRanges,
  howFound,
  preferredChannels,
  timelines,
  labels,
  privacyHref,
} = Astro.props;
---

<div class="quote-form-wrap">
  <form
    class="quote-form"
    data-quote-form
    data-gramm="false"
    data-currency={currency}
    data-locale={lang}
    data-legacy-services={JSON.stringify(LEGACY_QUOTE_SERVICE_IDS)}
    aria-labelledby="quote-form-title"
    novalidate
  >
    <div class="quote-intro">
      <h2 id="quote-form-title" class="h2-sub">{labels.formTitle}</h2>
      <p class="body-md m-0">{labels.formIntro}</p>
      <p class="quote-next-title" id="quote-next-title">{labels.nextTitle}</p>
      <ol class="quote-next" aria-labelledby="quote-next-title">
        {labels.nextSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>

    <p class="quote-required-note">
      <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
      {labels.required}
    </p>

    <div class="quote-field quote-honeypot" aria-hidden="true">
      <label for="quote-website">Website</label>
      <input id="quote-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="quote-form-grid">
      <label class="quote-field">
        <span>
          {labels.name}
          <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
        </span>
        <input
          name="name"
          type="text"
          autocomplete="name"
          placeholder={labels.placeholders.name}
          required
          minlength="2"
          maxlength="120"
        />
      </label>
      <label class="quote-field">
        <span>
          {labels.email}
          <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
        </span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder={labels.placeholders.email}
          required
          maxlength="254"
        />
      </label>
      <label class="quote-field">
        <span>
          {labels.phone}
          <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
        </span>
        <input
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          placeholder={labels.phonePlaceholder}
          data-quote-phone
          data-error={labels.phoneError}
          required
          maxlength="24"
        />
      </label>
      <label class="quote-field">
        <span>
          {labels.business}
          <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
        </span>
        <input
          name="business"
          type="text"
          autocomplete="organization"
          placeholder={labels.placeholders.business}
          required
          minlength="2"
          maxlength="160"
        />
      </label>
    </div>

    <fieldset class="quote-fieldset" data-quote-group="services">
      <legend>
        {labels.services}
        <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
      </legend>
      <div class="quote-checklist">
        {
          services.map((service) => (
            <label class="quote-check">
              <input name="services" type="checkbox" value={service.id} />
              <span>{service.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="quote-form-grid">
      <label class="quote-field">
        <span>
          {labels.country}
          <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
        </span>
        <select name="country" autocomplete="country" required>
          <option value="" disabled selected={!defaultCountry}>{labels.countryPlaceholder}</option>
          {
            countries.map((country) => (
              <option value={country.id} selected={country.id === defaultCountry}>
                {country.label}
              </option>
            ))
          }
        </select>
      </label>
      <label class="quote-field">
        <span>
          {labels.budget}
          <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
        </span>
        <select name="budgetRange" required data-quote-budget>
          <option value="" disabled selected>{labels.budgetPlaceholder}</option>
          {budgetRanges.map((range) => <option value={range.id}>{range.label}</option>)}
        </select>
      </label>
    </div>

    <label class="quote-field">
      <span>
        {labels.description}
        <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
      </span>
      <textarea
        name="description"
        rows="7"
        maxlength="5000"
        placeholder={labels.placeholders.description}
        required
        data-quote-description></textarea>
      <small class="quote-hint" data-quote-words>{labels.descriptionHint}</small>
    </label>

    <fieldset class="quote-fieldset" data-quote-group="optional">
      <legend>{labels.optionalTitle}</legend>
      <div class="quote-form-grid quote-form-grid-3">
        <label class="quote-field">
          <span>{labels.howFound}</span>
          <select name="howFound">
            <option value="">{labels.optionalPlaceholder}</option>
            {howFound.map((option) => <option value={option.id}>{option.label}</option>)}
          </select>
        </label>
        <label class="quote-field">
          <span>{labels.preferredChannel}</span>
          <select name="preferredChannel">
            <option value="">{labels.optionalPlaceholder}</option>
            {preferredChannels.map((option) => <option value={option.id}>{option.label}</option>)}
          </select>
        </label>
        <label class="quote-field">
          <span>{labels.timeline}</span>
          <select name="timeline">
            <option value="">{labels.optionalPlaceholder}</option>
            {timelines.map((option) => <option value={option.id}>{option.label}</option>)}
          </select>
        </label>
      </div>
    </fieldset>

    <label class="quote-consent">
      <input name="privacy" type="checkbox" required data-quote-consent />
      <span>
        {labels.privacyPrefix}
        <a class="inline-link" href={privacyHref} target="_blank" rel="noopener noreferrer"
          >{labels.privacyLink}</a
        >{labels.privacySuffix}
        <abbr class="quote-required" title={labels.requiredTip} aria-hidden="true">*</abbr>
      </span>
    </label>
    <p class="quote-error" role="alert" data-quote-error hidden>{labels.error}</p>
    <Button
      type="submit"
      icon="send-email-white"
      disabled
      aria-describedby="quote-submit-hint"
      data-sending={labels.sending}>{labels.submit}</Button
    >
    <p class="quote-status" id="quote-submit-hint" data-quote-hint>{labels.submitHint}</p>
  </form>

  <section class="quote-success" data-quote-success hidden tabindex="-1" aria-live="polite">
    <p class="eyebrow">Wavival</p>
    <h2 class="h2-section">{labels.successTitle}</h2>
    <p class="body-md m-0">{labels.success}</p>
  </section>
</div>

<script>
  const setupQuoteForm = () => {
    const form = document.querySelector<HTMLFormElement>("[data-quote-form]");
    if (!form || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const description = form.querySelector<HTMLTextAreaElement>("[data-quote-description]");
    const words = form.querySelector<HTMLElement>("[data-quote-words]");
    const error = form.querySelector<HTMLElement>("[data-quote-error]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const hint = form.querySelector<HTMLElement>("[data-quote-hint]");
    const phone = form.querySelector<HTMLInputElement>("[data-quote-phone]");
    const submitLabel = submit?.textContent ?? "";
    const success = document.querySelector<HTMLElement>("[data-quote-success]");
    const maxWords = 500;
    const services = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="services"]'));

    // `?service=<id>` (repeatable) preselects catalog services; the ids of the
    // previous form are mapped to the current ones. Anything else is ignored.
    const legacy: Record<string, string> = JSON.parse(form.dataset.legacyServices ?? "{}");
    const params = new URLSearchParams(window.location.search);
    for (const requested of params.getAll("service")) {
      const id = legacy[requested] ?? requested;
      const input = services.find((candidate) => candidate.value === id);
      if (input) input.checked = true;
    }

    const updateWordCount = () => {
      if (!description || !words) return;
      const count = description.value.trim() ? description.value.trim().split(/\s+/).length : 0;
      words.textContent = `${count}/${maxWords}`;
      description.setCustomValidity(count > maxWords ? "Maximum word count exceeded." : "");
    };

    // Same rule as api/quote.ts: spaces, parentheses and hyphens are ignored.
    const validatePhone = () => {
      if (!phone) return;
      const valid = /^\+[1-9]\d{7,14}$/.test(phone.value.replace(/[\s()-]/g, ""));
      phone.setCustomValidity(valid ? "" : (phone.dataset.error ?? ""));
    };

    const selectedServices = () => services.filter((input) => input.checked);

    // The submit button is enabled only when every required field, one service and
    // the privacy consent are filled in.
    const refreshSubmit = () => {
      updateWordCount();
      validatePhone();
      const complete = form.checkValidity() && selectedServices().length > 0;
      if (submit && submit.dataset.busy !== "true") submit.disabled = !complete;
      hint?.toggleAttribute("hidden", complete);
      return complete;
    };

    form.addEventListener("input", refreshSubmit);
    form.addEventListener("change", refreshSubmit);
    refreshSubmit();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!refreshSubmit()) {
        form.reportValidity();
        return;
      }

      error?.setAttribute("hidden", "");
      if (submit) {
        submit.dataset.busy = "true";
        submit.disabled = true;
        submit.textContent = submit.dataset.sending ?? submit.textContent;
      }

      const data = new FormData(form);
      const field = (name: string) => String(data.get(name) ?? "");
      const payload: Record<string, unknown> = {
        name: field("name"),
        email: field("email"),
        phone: field("phone"),
        business: field("business"),
        description: field("description"),
        website: field("website"),
        services: selectedServices().map((input) => input.value),
        country: field("country"),
        budgetRange: field("budgetRange"),
        currency: form.dataset.currency,
        locale: form.dataset.locale,
        consent: true,
        source: window.location.pathname + window.location.search,
      };
      for (const name of ["howFound", "preferredChannel", "timeline"]) {
        if (field(name)) payload[name] = field(name);
      }

      try {
        const response = await fetch("/api/quote", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error("Quote request failed");
        form.hidden = true;
        success?.removeAttribute("hidden");
        success?.focus();
      } catch {
        error?.removeAttribute("hidden");
        if (submit) {
          submit.dataset.busy = "false";
          submit.textContent = submitLabel;
        }
        refreshSubmit();
      }
    });
  };

  document.addEventListener("astro:page-load", setupQuoteForm);
</script>

---
import ProjectMeta from "@/components/molecules/ProjectMeta.astro";
import ProjectActions from "@/components/molecules/ProjectActions.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import type { ProjectView } from "@/data/projectView";

interface Props {
  project: ProjectView;
  index: string;
}

const { project: p, index } = Astro.props;
---

<article
  class="group flex flex-col border border-line bg-bg transition-colors hover:border-blue hover:bg-surface"
  data-project-card
  data-filters={p.filters.join(" ")}
>
  {
    p.image && (
      <a
        href={p.caseHref}
        aria-label={p.title}
        class="media-frame"
        style="border-width:0 0 1px"
        tabindex={p.caseHref ? undefined : -1}
      >
        <img
          src={p.image.src}
          alt={p.image.alt}
          width={p.image.width}
          height={p.image.height}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="flex flex-1 flex-col gap-[18px] p-7">
    <ProjectMeta index={index} tag={p.tag} tone={p.tone} overline={p.overline} />
    <h2
      class="h-title m-0 leading-[1.05]"
      style="font-size:clamp(28px,3vw,40px);letter-spacing:-0.03em"
    >
      {
        p.caseHref ? (
          <a href={p.caseHref} class="text-ink no-underline hover:text-link">
            {p.title}
          </a>
        ) : (
          p.title
        )
      }
    </h2>
    <p class="m-0 text-sm leading-[1.7] text-muted">{p.summary}</p>
    <ChipList items={p.stack} />
    <ProjectActions actions={p.actions} class="mt-auto pt-2" />
  </div>
</article>

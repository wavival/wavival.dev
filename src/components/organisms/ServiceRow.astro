---
import Badge from "@/components/atoms/Badge.astro";
import Chip from "@/components/atoms/Chip.astro";
import Index from "@/components/atoms/Index.astro";
import TextLink from "@/components/atoms/TextLink.astro";

interface Example {
  name: string;
  description: string;
  href: string;
}

interface Props {
  index: string;
  title: string;
  body: string;
  tools: string[];
  timeline: string;
  specialty?: boolean;
  examples?: Example[];
  quoteHref: string;
  labels: {
    specialty: string;
    duration: string;
    tools: string;
    examples: string;
    quote: string;
  };
}

const {
  index,
  title,
  body,
  tools,
  timeline,
  specialty = false,
  examples = [],
  quoteHref,
  labels,
} = Astro.props;
const dtClass = "label-sm sm:flex-[0_0_260px]";
---

<article
  class={`flex flex-col border-b border-line py-10 ${specialty ? "bg-tint px-6" : ""}`.trim()}
>
  <div class="flex flex-wrap items-center gap-4">
    <Index>{index}</Index>
    {specialty && <Badge>{labels.specialty}</Badge>}
  </div>
  <h2
    class="h-title m-0 mt-4 leading-none tracking-[-0.035em]"
    style="font-size:clamp(32px,4.4vw,64px);text-wrap:pretty"
  >
    {title}
  </h2>
  <p class="body-lg mb-6 mt-5 text-[17px]">{body}</p>
  <dl class="m-0 border-t border-line">
    <div class="flex flex-wrap gap-x-12 gap-y-2 border-b border-line py-[18px]">
      <dt class={`${dtClass} pt-1`}>{labels.duration}</dt>
      <dd class="h-title m-0 text-[20px] sm:flex-[1_1_480px]">{timeline}</dd>
    </div>
    <div class="flex flex-wrap gap-x-12 gap-y-3 border-b border-line py-[18px]">
      <dt class={`${dtClass} pt-1.5`}>{labels.tools}</dt>
      <dd class="m-0 flex flex-wrap gap-1.5 sm:flex-[1_1_480px]">
        {tools.map((t) => <Chip>{t}</Chip>)}
      </dd>
    </div>
    {
      examples.length > 0 && (
        <div class="flex flex-wrap gap-x-12 gap-y-2 pb-0 pt-[18px]">
          <dt class={`${dtClass} pt-1`}>{labels.examples}</dt>
          <dd class="m-0 sm:flex-[1_1_480px]">
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
              {examples.map((ex) => (
                <li class="text-sm leading-normal text-muted" style="text-wrap:pretty">
                  <TextLink href={ex.href} variant="inline" class="font-display font-extrabold">
                    {ex.name}:
                  </TextLink>{" "}
                  {ex.description}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
  <div class="mt-6">
    <TextLink href={quoteHref}>{labels.quote}</TextLink>
  </div>
</article>

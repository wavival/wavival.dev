---
import Button from "@/components/atoms/Button.astro";
import ProjectActions from "@/components/molecules/ProjectActions.astro";
import StatusDot from "@/components/atoms/StatusDot.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import PartDisclosure from "@/components/molecules/PartDisclosure.astro";
import CaseToc from "@/components/organisms/CaseToc.astro";
import PartBody from "@/components/organisms/PartBody.astro";
import ContactBand from "@/components/organisms/ContactBand.astro";
import { caseLabels, partSections } from "@/data/caseStudyLabels";
import { projects, type Project } from "@/data/projects";
import { projectView, toAction, type ProjectAction } from "@/data/projectView";
import { quoteTypesHref } from "@/data/quoteTypes";
import { siteRoutes, type Lang } from "@/i18n/utils";

interface Props {
  project: Project;
  lang: Lang;
  dateLabel: string;
}

const { project, lang, dateLabel } = Astro.props;
const base = import.meta.env.BASE_URL;
const r = siteRoutes(lang, base);
const t = caseLabels(lang);
const view = projectView(project, lang, base);
const multi = view.parts.length > 1;
const primary = view.parts[0].content;

// One part reads like a classic case study (header buttons include its design links, numbered
// sections, sticky contents). Several parts read as an ecosystem: one accordion per part.
const singleSections = multi ? [] : partSections(primary, t, "cs-");
const partItems = view.parts.map((part, i) => ({
  id: part.id,
  n: String(i + 1).padStart(2, "0"),
  label: part.label,
}));
const lead = multi ? view.summary : view.solution;
const headerLinks: ProjectAction[] = [
  ...view.links,
  ...(!multi && primary.designLink ? [toAction(primary.designLink)] : []),
  ...(!multi && primary.designSystemLink ? [toAction(primary.designSystemLink)] : []),
];

const idx = projects.findIndex((p) => p.slug === project.slug);
const prevProject = idx > 0 ? projects[idx - 1] : null;
const nextProject = idx < projects.length - 1 ? projects[idx + 1] : null;
const number = String(idx + 1).padStart(2, "0");
---

<article>
  <header class="wrap" style="padding-top:clamp(40px,5vw,80px);padding-bottom:48px">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4 border-b border-line pb-[18px]">
      <TextLink href={r.projects} aria-label={t.backAria} class="label-sm label-sm-link">
        {t.projects}
      </TextLink>
      <span class="text-line-2" aria-hidden="true">/</span>
      <span class="label-sm">{number} &middot; {project.name}</span>
      <StatusDot tone={view.tone} class="ml-auto text-xs font-semibold text-ink">
        {view.tag}
      </StatusDot>
    </div>
    <h1 class="display-case m-0 [text-wrap:pretty]" style="margin-top:clamp(32px,4vw,56px)">
      {project.name}
    </h1>
    <div class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
      <p
        class="body-lg m-0 max-w-[760px] flex-[1_1_520px] leading-[1.65]"
        style="font-size:clamp(17px,1.5vw,20px)"
      >
        {lead}
      </p>
      <div class="flex flex-[0_1_300px] flex-col gap-5">
        <p class="m-0 text-[13px] text-muted">
          {t.by}
          <a href={r.about} class="text-ink">Valentina Ramírez</a><br />{dateLabel}
        </p>
        <div class="flex flex-col items-center gap-6 min-[640px]:items-start">
          <ProjectActions
            actions={headerLinks}
            stacked
            class="items-center min-[640px]:items-start"
          />
          <Button
            href={quoteTypesHref(r.quote)}
            size="sm"
            data-umami-event="cotizar-desde-proyecto"
          >
            {t.quote}
          </Button>
        </div>
      </div>
    </div>
  </header>

  <div class="wrap">
    {
      view.image && (
        <div class="media-frame">
          <img
            src={view.image.src}
            alt={view.image.alt}
            width={view.image.width ?? 1200}
            height={view.image.height ?? 630}
            decoding="async"
          />
        </div>
      )
    }
  </div>

  <div
    class="wrap flex items-start gap-16"
    style="padding-top:clamp(56px,7vw,112px);padding-bottom:var(--sec)"
  >
    <aside class="sticky top-24 hidden w-[220px] flex-none min-[900px]:block">
      <CaseToc items={multi ? partItems : singleSections} label={multi ? t.tocParts : t.toc} />
      {
        !multi && (
          <>
            <div class="label-sm mt-8 mb-3">{t.stack}</div>
            <ChipList items={primary.stack ?? []} label={t.stack} />
          </>
        )
      }
    </aside>

    <div class="flex min-w-0 flex-auto flex-col" style="gap:clamp(64px,7vw,104px)">
      <div class="border-t-2 border-blue bg-tint px-8 py-7">
        <div class="label-sm label-sm-link mb-[10px]">{t.summary}</div>
        <p
          class="h-title m-0 leading-[1.45]"
          style="font-weight:700;font-size:clamp(18px,1.6vw,22px);text-wrap:pretty"
        >
          {multi ? view.summary : (primary.summary ?? view.summary)}
        </p>
      </div>
      {
        !multi && (
          <ChipList items={primary.stack ?? []} label={t.stack} class="min-[900px]:hidden" />
        )
      }

      {
        multi ? (
          <div class="flex flex-col border-t border-ink">
            {view.parts.map((part, i) => {
              const n = String(i + 1).padStart(2, "0");
              const actions = part.actions;
              const design = part.content.designLink;
              return (
                <PartDisclosure
                  id={part.id}
                  index={n}
                  label={part.label}
                  blurb={part.blurb}
                  openLabel={t.partOpen}
                  closeLabel={t.partClose}
                  open={i === 0}
                >
                  <div class="flex flex-col" style="gap:clamp(48px,5vw,72px)">
                    <ProjectActions
                      actions={design ? [...actions, toAction(design)] : actions}
                      stacked
                      class="items-start"
                    />
                    {part.content.summary && (
                      <div class="border-t-2 border-blue bg-tint px-8 py-7">
                        <div class="label-sm label-sm-link mb-[10px]">{t.summary}</div>
                        <p
                          class="h-title m-0 leading-[1.45]"
                          style="font-weight:700;font-size:clamp(18px,1.6vw,22px);text-wrap:pretty"
                        >
                          {part.content.summary}
                        </p>
                      </div>
                    )}
                    {part.content.stack && <ChipList items={part.content.stack} label={t.stack} />}
                    <PartBody
                      part={part.content}
                      lang={lang}
                      idPrefix={`cs-${part.id}-`}
                      level="h3"
                    />
                  </div>
                </PartDisclosure>
              );
            })}
          </div>
        ) : (
          <PartBody part={primary} lang={lang} idPrefix="cs-" />
        )
      }
    </div>
  </div>

  {
    (prevProject || nextProject) && (
      <nav aria-label={t.navLabel} class="border-y border-line">
        <div
          class="wrap grid"
          style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))"
        >
          {prevProject ? (
            <a
              href={r.project(prevProject.slug)}
              class="flex flex-col gap-2 py-10 pr-6 text-ink no-underline transition-colors hover:text-link"
            >
              <span class="label-sm">{t.prev}</span>
              <span
                class="h-title leading-[1.1]"
                style="font-size:clamp(24px,3vw,40px);letter-spacing:-0.02em"
              >
                {prevProject.name}
              </span>
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
          {nextProject && (
            <a
              href={r.project(nextProject.slug)}
              class="flex flex-col items-end gap-2 py-10 pl-6 text-right text-ink no-underline transition-colors hover:text-link"
            >
              <span class="label-sm">{t.next}</span>
              <span
                class="h-title leading-[1.1]"
                style="font-size:clamp(24px,3vw,40px);letter-spacing:-0.02em"
              >
                {nextProject.name}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }

  <ContactBand lang={lang} />
</article>

---
import Button from "@/components/atoms/Button.astro";
import StatusDot from "@/components/atoms/StatusDot.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import Bento from "@/components/molecules/Bento.astro";
import Metric from "@/components/molecules/Metric.astro";
import Disclosure from "@/components/molecules/Disclosure.astro";
import CaseToc from "@/components/organisms/CaseToc.astro";
import CaseSection from "@/components/organisms/CaseSection.astro";
import ContactBand from "@/components/organisms/ContactBand.astro";
import { caseStudies, type Project } from "@/data/projects";
import { projectView } from "@/data/projectView";
import { quoteTypeHref } from "@/data/quoteTypes";
import { siteRoutes, type Lang } from "@/i18n/utils";
import { bentoStyles } from "@/utils/bento";

interface Props {
  project: Project;
  lang: Lang;
  dateLabel: string;
}

const { project, lang, dateLabel } = Astro.props;
const isEn = lang === "en";
const base = import.meta.env.BASE_URL;
const r = siteRoutes(lang, base);
const view = projectView(project, lang, base);
const en = isEn ? project.en : undefined;
const designLink = en?.designLink ?? project.designLink;
const designSystemLink = en?.designSystemLink ?? project.designSystemLink;

const architecture = en?.architecture ?? project.architecture;
const decisions = en?.decisions ?? project.decisions;
const results = en?.results ?? project.results;
const learnings = en?.learnings ?? project.learnings;
const painPoints = en?.painPoints ?? project.painPoints;
const modules = en?.modules ?? project.modules;
const chainSteps = en?.chainSteps ?? project.chainSteps;
const chainTitle =
  en?.chainStepsTitle ??
  project.chainStepsTitle ??
  (isEn ? "Example action chain" : "Ejemplo de cadena de acciones");
const chains =
  en?.chains ??
  project.chains ??
  (chainSteps ? [{ title: chainTitle, steps: chainSteps }] : undefined);
const design = en?.design ?? project.design;
const roadmap = en?.roadmap ?? project.roadmap;
const metrics = project.metrics;
const painStyles = bentoStyles(painPoints?.length ?? 0);
const moduleStyles = bentoStyles(modules?.length ?? 0);
const learningStyles = bentoStyles(learnings?.length ?? 0);

const t = isEn
  ? {
      projects: "Projects",
      by: "By",
      toc: "Contents",
      stack: "Stack",
      summary: "Summary",
      problem: "The problem",
      architecture: "What I built",
      decisions: "Architecture decisions",
      design: "Design",
      results: "Results",
      learnings: "Learnings",
      roadmap: "Roadmap",
      roadmapNow: "Now",
      roadmapNext: "Next",
      roadmapLater: "Later",
      roadmapOut: "Out of scope for the MVP",
      context: "Context",
      tradeoff: "Trade-off",
      decision: "Decision",
      view: "View",
      close: "Close",
      prev: "Previous",
      next: "Next",
      navLabel: "Project navigation",
      prevAria: "Previous project",
      nextAria: "Next project",
      backAria: "Back to all projects",
      quote: "Quote a project like this",
    }
  : {
      projects: "Proyectos",
      by: "Por",
      toc: "Contenido",
      stack: "Stack",
      summary: "Resumen",
      problem: "El problema",
      architecture: "Qué construí",
      decisions: "Decisiones de arquitectura",
      design: "Diseño",
      results: "Resultados",
      learnings: "Aprendizajes",
      roadmap: "Roadmap",
      roadmapNow: "Ahora",
      roadmapNext: "Siguiente",
      roadmapLater: "Después",
      roadmapOut: "Fuera del alcance del MVP",
      context: "Contexto",
      tradeoff: "Trade-off",
      decision: "Decisión",
      view: "Ver",
      close: "Cerrar",
      prev: "Anterior",
      next: "Siguiente",
      navLabel: "Navegación entre proyectos",
      prevAria: "Proyecto anterior",
      nextAria: "Proyecto siguiente",
      backAria: "Volver a todos los proyectos",
      quote: "Cotizar un proyecto así",
    };

const roadmapColumns = roadmap
  ? [
      { label: t.roadmapNow, items: roadmap.now },
      { label: t.roadmapNext, items: roadmap.next },
      ...(roadmap.later?.length ? [{ label: t.roadmapLater, items: roadmap.later }] : []),
      ...(roadmap.out ? [{ label: t.roadmapOut, items: roadmap.out }] : []),
    ].filter((c) => c.items.length > 0)
  : [];
const roadmapStyles = bentoStyles(roadmapColumns.length);

const sections = [
  { key: "problem", label: t.problem, show: true },
  { key: "architecture", label: t.architecture, show: !!architecture },
  { key: "design", label: t.design, show: !!design },
  { key: "decisions", label: t.decisions, show: !!decisions },
  { key: "results", label: t.results, show: !!results },
  { key: "learnings", label: t.learnings, show: !!learnings },
  { key: "roadmap", label: t.roadmap, show: !!roadmap },
]
  .filter((s) => s.show)
  .map((s, i) => ({
    ...s,
    id: `cs-${s.key}`,
    n: String(i + 1).padStart(2, "0"),
  }));
const sec = (key: string) => sections.find((s) => s.key === key)!;

const idx = caseStudies.findIndex((p) => p.slug === project.slug);
const prevProject = idx > 0 ? caseStudies[idx - 1] : null;
const nextProject = idx < caseStudies.length - 1 ? caseStudies[idx + 1] : null;
const number = String(idx + 1).padStart(2, "0");
const externalActions = [
  ...view.actions.filter((a) => a.external),
  ...(designLink ? [{ ...designLink, external: true }] : []),
  ...(designSystemLink ? [{ ...designSystemLink, external: true }] : []),
];
---

<article>
  <header class="wrap" style="padding-top:clamp(40px,5vw,80px);padding-bottom:48px">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4 border-b border-line pb-[18px]">
      <TextLink href={r.projects} aria-label={t.backAria} class="label-sm label-sm-link">
        {t.projects}
      </TextLink>
      <span class="text-line-2" aria-hidden="true">/</span>
      <span class="label-sm">{number} &middot; {project.title}</span>
      <StatusDot tone={view.tone} class="ml-auto text-xs font-semibold text-ink">
        {view.tag}
      </StatusDot>
    </div>
    <h1 class="display-case m-0 [text-wrap:pretty]" style="margin-top:clamp(32px,4vw,56px)">
      {project.title}
    </h1>
    <div class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
      <p
        class="body-lg m-0 max-w-[760px] flex-[1_1_520px] leading-[1.65]"
        style="font-size:clamp(17px,1.5vw,20px)"
      >
        {view.solution}
      </p>
      <div class="flex flex-[0_1_300px] flex-col gap-5">
        <p class="m-0 text-[13px] text-muted">
          {t.by}
          <a href={r.about} class="text-ink">Valentina Ramírez</a><br />{dateLabel}
        </p>
        <div class="flex flex-wrap justify-center gap-3 min-[640px]:justify-start">
          {
            externalActions.map((a) => (
              <Button
                href={a.href}
                target="_blank"
                variant="secondary"
                size="sm"
                aria-label={a.ariaLabel}
                data-umami-event={a.event}
              >
                {a.text}
              </Button>
            ))
          }
          <Button
            href={quoteTypeHref(r.quote, project.quoteType)}
            size="sm"
            data-umami-event="cotizar-desde-proyecto"
          >
            {t.quote}
          </Button>
        </div>
      </div>
    </div>
  </header>

  <div class="wrap">
    {
      view.image && (
        <div class="media-frame">
          <img
            src={view.image.src}
            alt={view.image.alt}
            width={view.image.width ?? 1200}
            height={view.image.height ?? 630}
            decoding="async"
          />
        </div>
      )
    }
    {
      metrics && metrics.length > 0 && (
        <dl
          class="cell-grid m-0"
          style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-top:-1px"
        >
          {metrics.map((m) => (
            <Metric value={m.metric} label={m.label} note={m.note} />
          ))}
        </dl>
      )
    }
  </div>

  <div
    class="wrap flex items-start gap-16"
    style="padding-top:clamp(56px,7vw,112px);padding-bottom:var(--sec)"
  >
    <aside class="sticky top-24 hidden w-[220px] flex-none min-[900px]:block">
      <CaseToc items={sections} label={t.toc} />
      <div class="label-sm mt-8 mb-3">{t.stack}</div>
      <ChipList items={project.stack} label={t.stack} />
    </aside>

    <div class="flex min-w-0 flex-auto flex-col" style="gap:clamp(64px,7vw,104px)">
      <div class="border-t-2 border-blue bg-tint px-8 py-7">
        <div class="label-sm label-sm-link mb-[10px]">{t.summary}</div>
        <p
          class="h-title m-0 leading-[1.45]"
          style="font-weight:700;font-size:clamp(18px,1.6vw,22px);text-wrap:pretty"
        >
          {view.summary}
        </p>
      </div>
      <ChipList items={project.stack} label={t.stack} class="min-[900px]:hidden" />

      <CaseSection id={sec("problem").id} n={sec("problem").n} title={t.problem}>
        <p class="m-0 max-w-[820px] text-[18px] leading-[1.75] text-ink" style="text-wrap:pretty">
          {view.problem}
        </p>
        {
          painPoints && (
            <Bento cells class="mt-10">
              {painPoints.map((pp, i) => (
                <div class="p-6" style={painStyles[i]}>
                  <h3 class="h-title m-0 text-lg">{pp.title}</h3>
                  <p class="mt-2 mb-0 text-sm leading-[1.7] text-muted" style="text-wrap:pretty">
                    {pp.text}
                  </p>
                </div>
              ))}
            </Bento>
          )
        }
      </CaseSection>

      {
        architecture && (
          <CaseSection id={sec("architecture").id} n={sec("architecture").n} title={t.architecture}>
            <ol
              class="m-0 grid list-none gap-x-10 gap-y-0 p-0"
              style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))"
            >
              {architecture.map((a, i) => (
                <li class="flex gap-4 border-b border-line py-[18px]">
                  <span class="index w-7 flex-none text-sm index-link">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p class="body m-0 text-[15px] leading-[1.7]">{a}</p>
                </li>
              ))}
            </ol>
            {modules && (
              <Bento class="mt-10 gap-4">
                {modules.map((m, i) => (
                  <div class="border border-line bg-surface p-6" style={moduleStyles[i]}>
                    <h3 class="h-title m-0 text-lg">{m.name}</h3>
                    <p class="mt-2 mb-0 text-sm leading-[1.7] text-muted" style="text-wrap:pretty">
                      {m.text}
                    </p>
                  </div>
                ))}
              </Bento>
            )}
            {chains &&
              chains.map((chain) => (
                <div class="mt-10 border border-line bg-tint px-8 py-7">
                  <h3 class="h-title m-0 mb-5 text-lg">{chain.title}</h3>
                  <ol class="m-0 flex list-none flex-col p-0">
                    {chain.steps.map((step, i) => (
                      <li class="flex items-start gap-4 border-t border-dashed border-line-2 py-[10px]">
                        <span class="index w-6 flex-none pt-[3px] text-xs">
                          {String(i + 1).padStart(2, "0")}
                        </span>
                        <span class="text-sm leading-[1.65] text-ink" style="text-wrap:pretty">
                          {step}
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
          </CaseSection>
        )
      }

      {
        design && (
          <CaseSection id={sec("design").id} n={sec("design").n} title={t.design}>
            <ol
              class="m-0 grid list-none gap-x-10 gap-y-0 p-0"
              style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))"
            >
              {design.map((d, i) => (
                <li class="flex gap-4 border-b border-line py-[18px]">
                  <span class="index w-7 flex-none text-sm index-link">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p class="body m-0 text-[15px] leading-[1.7]">{d}</p>
                </li>
              ))}
            </ol>
          </CaseSection>
        )
      }

      {
        decisions && (
          <CaseSection
            id={sec("decisions").id}
            n={sec("decisions").n}
            title={t.decisions}
            gap="mb-4"
          >
            <div class="flex flex-col">
              {decisions.map((d, i) => (
                <Disclosure
                  index={String(i + 1).padStart(2, "0")}
                  title={d.title}
                  openLabel={t.view}
                  closeLabel={t.close}
                >
                  <dl
                    class="m-0 grid gap-x-8 gap-y-6"
                    style="grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))"
                  >
                    <div>
                      <dt class="label-sm">{t.context}</dt>
                      <dd class="body m-0 mt-2 text-sm">{d.context}</dd>
                    </div>
                    <div>
                      <dt class="label-sm">{t.tradeoff}</dt>
                      <dd class="body m-0 mt-2 text-sm">{d.tradeoff}</dd>
                    </div>
                    <div>
                      <dt class="label-sm label-sm-link">{t.decision}</dt>
                      <dd class="m-0 mt-2 text-sm leading-[1.7] text-ink" style="text-wrap:pretty">
                        {d.decision}
                      </dd>
                    </div>
                  </dl>
                </Disclosure>
              ))}
            </div>
          </CaseSection>
        )
      }

      {
        results && (
          <CaseSection id={sec("results").id} n={sec("results").n} title={t.results} gap="mb-6">
            <ul class="m-0 list-none p-0">
              {results.map((x) => (
                <li
                  class="mb-3 border-l-2 border-blue py-[18px] pr-0 pl-6 text-base leading-[1.7] text-ink"
                  style="text-wrap:pretty"
                >
                  {x}
                </li>
              ))}
            </ul>
          </CaseSection>
        )
      }

      {
        learnings && (
          <CaseSection
            id={sec("learnings").id}
            n={sec("learnings").n}
            title={t.learnings}
            gap="mb-6"
          >
            <Bento class="gap-4" data-learnings-cards>
              {learnings.map((x, i) => (
                <article class="border border-line bg-surface p-6" style={learningStyles[i]}>
                  <span class="index">{String(i + 1).padStart(2, "0")}</span>
                  <p class="mt-4 mb-0 text-base leading-[1.7] text-muted" style="text-wrap:pretty">
                    {x}
                  </p>
                </article>
              ))}
            </Bento>
          </CaseSection>
        )
      }

      {
        roadmap && (
          <CaseSection id={sec("roadmap").id} n={sec("roadmap").n} title={t.roadmap} gap="mb-6">
            <Bento cells>
              {roadmapColumns.map((col, i) => (
                <div class="p-6" style={roadmapStyles[i]}>
                  <h3 class="label-sm m-0">{col.label}</h3>
                  <ul class="m-0 mt-4 flex list-none flex-col gap-3 p-0">
                    {col.items.map((item) => (
                      <li class="text-sm leading-[1.7] text-ink" style="text-wrap:pretty">
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </Bento>
          </CaseSection>
        )
      }
    </div>
  </div>

  {
    (prevProject || nextProject) && (
      <nav aria-label={t.navLabel} class="border-y border-line">
        <div
          class="wrap grid"
          style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))"
        >
          {prevProject ? (
            <a
              href={r.project(prevProject.slug)}
              aria-label={`${t.prevAria}: ${prevProject.title}`}
              class="flex flex-col gap-2 py-10 pr-6 text-ink no-underline transition-colors hover:text-link"
            >
              <span class="label-sm">{t.prev}</span>
              <span
                class="h-title leading-[1.1]"
                style="font-size:clamp(24px,3vw,40px);letter-spacing:-0.02em"
              >
                {prevProject.title}
              </span>
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
          {nextProject && (
            <a
              href={r.project(nextProject.slug)}
              aria-label={`${t.nextAria}: ${nextProject.title}`}
              class="flex flex-col items-end gap-2 py-10 pl-6 text-right text-ink no-underline transition-colors hover:text-link"
            >
              <span class="label-sm">{t.next}</span>
              <span
                class="h-title leading-[1.1]"
                style="font-size:clamp(24px,3vw,40px);letter-spacing:-0.02em"
              >
                {nextProject.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }

  <ContactBand lang={lang} />
</article>

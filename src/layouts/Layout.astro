---
import "@/styles/global.css";
import NavBar from "@/components/ui/NavBar.astro";
import Footer from "@/components/ui/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  ogPublishedTime?: string;
  ogModifiedTime?: string;
  noindex?: boolean;
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
  /** Preload /images/profile.webp as the LCP image. Only set on pages that render it (home, about). */
  preloadHero?: boolean;
}

const {
  title = "Valentina Ramírez | Full Stack Developer",
  description = "Desarrolladora Full Stack: construyo productos con Django, React y Next.js, integración de IA y seguridad desde el diseño.",
  image = "/images/profile.webp",
  ogImage,
  ogImageAlt,
  ogType = "website",
  ogPublishedTime,
  ogModifiedTime,
  noindex = false,
  alternates = [],
  preloadHero = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ogLocale = lang === "en" ? "en_US" : "es_CO";
const t = useTranslations(lang as Lang);
const personDescription =
  "Full Stack Developer con experiencia en Django, React y Next.js. Fundadora de Lúmina W. Construyo productos con IA integrada y seguridad desde el diseño.";

const site = "https://wavival.dev";
const canonicalURL = new URL(Astro.url.pathname, site);
const isHome = ["/", "/en", "/en/"].includes(Astro.url.pathname);
const buildDate = new Date().toISOString().slice(0, 10);
const personImage = new URL(image, site);
const socialCard = ogImage ? new URL(ogImage, site) : new URL("/images/og-card.webp", site);
const socialCardType = (ogImage ?? "/images/og-card.webp").endsWith(".webp")
  ? "image/webp"
  : "image/png";
const socialCardAlt =
  ogImageAlt ??
  (lang === "en"
    ? "Valentina Ramírez: Full Stack Developer · Django · React · Next.js"
    : "Valentina Ramírez: Full Stack Developer · Django · React · Next.js");

const UMAMI_SRC = import.meta.env.PUBLIC_UMAMI_SRC;
const UMAMI_ID = import.meta.env.PUBLIC_UMAMI_ID;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site}/#person`,
      name: "Valentina Ramírez",
      url: site,
      image: {
        "@type": "ImageObject",
        "@id": `${site}/#personimage`,
        url: personImage.toString(),
        width: 640,
        height: 640,
        caption: "Valentina Ramírez",
      },
      jobTitle: "Full Stack Developer",
      description: personDescription,
      knowsAbout: [
        "Full Stack Development",
        "Django",
        "Django REST Framework",
        "Next.js",
        "React",
        "TypeScript",
        "PostgreSQL",
        "REST APIs",
        "AI integration",
        "OpenAI",
        "OpenClaw",
        "LLM workflows",
        "Application Security",
        "OWASP",
      ],
      knowsLanguage: ["es", "en"],
      nationality: { "@type": "Country", name: "Colombia" },
      alumniOf: [
        { "@type": "EducationalOrganization", name: "SENA" },
        { "@type": "EducationalOrganization", name: "Universidad de San Buenaventura" },
        { "@type": "EducationalOrganization", name: "Platzi", url: "https://platzi.com" },
      ],
      worksFor: { "@id": `${site}/#organization` },
      sameAs: [
        "https://www.linkedin.com/in/wavival/",
        "https://github.com/wavival",
        "https://x.com/wavival0",
        "https://www.instagram.com/wavival/",
        "https://platzi.com/p/wavival",
      ],
    },
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: "Lúmina W",
      url: "https://luminaw.co",
      foundingDate: "2025-11",
      founder: { "@id": `${site}/#person` },
      logo: {
        "@type": "ImageObject",
        url: `${site}/brand/logo-w.webp`,
        width: 619,
        height: 464,
      },
      contactPoint: {
        "@type": "ContactPoint",
        email: "wavival.dev@luminaw.co",
        contactType: "customer support",
        availableLanguage: ["es", "en"],
      },
      sameAs: ["https://blog.luminaw.co"],
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: site,
      name: "Valentina Ramírez",
      description: description,
      author: { "@id": `${site}/#person` },
    },
    ...(isHome
      ? [
          {
            "@type": "ProfilePage",
            "@id": `${site}/#profilepage`,
            url: canonicalURL.toString(),
            name: "Valentina Ramírez",
            inLanguage: lang === "en" ? "en-US" : "es-CO",
            isPartOf: { "@id": `${site}/#website` },
            dateModified: buildDate,
            mainEntity: { "@id": `${site}/#person` },
          },
        ]
      : []),
  ],
});
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            const t = localStorage.getItem("theme");
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            const dark = t === "dark" || (t === null && prefersDark);
            document.documentElement.classList.toggle("dark", dark);
            // Keep browser chrome (theme-color) in sync with the class-based theme,
            // which can diverge from the OS prefers-color-scheme. Null on first parse
            // (meta not yet reached); set on astro:after-swap when the doc is parsed.
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute("content", dark ? "#0f1117" : "#f0f4ff");
          } catch {
            /* localStorage unavailable: keep default theme */
          }
        }
        applyTheme();
        // Re-apply before paint after a View Transitions swap: the incoming static
        // document has no .dark class, so without this the theme flashes on navigation.
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Valentina Ramírez" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content={ogType} />
    {
      ogType === "article" && ogPublishedTime && (
        <meta property="article:published_time" content={ogPublishedTime} />
      )
    }
    {
      ogType === "article" && ogModifiedTime && (
        <meta property="article:modified_time" content={ogModifiedTime} />
      )
    }
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:type" content={socialCardType} />
    <meta property="og:image:alt" content={socialCardAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocale === "en_US" ? "es_CO" : "en_US"} />
    <meta property="og:site_name" content="Valentina Ramírez" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wavival0" />
    <meta name="twitter:creator" content="@wavival0" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCard} />
    <meta name="twitter:image:alt" content={socialCardAlt} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}icon-192.png`}
      sizes="192x192"
    />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta name="theme-color" content="#f0f4ff" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/poppins-400.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/raleway-var.woff2`}
      crossorigin
    />
    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          href={`${import.meta.env.BASE_URL}images/profile.webp`}
          fetchpriority="high"
        />
      )
    }
    {UMAMI_SRC && UMAMI_ID && <script is:inline defer src={UMAMI_SRC} data-website-id={UMAMI_ID} />}
    {UMAMI_SRC && UMAMI_ID && <script>import "@/scripts/vitals";</script>}
    <script>
      function revealOnScroll() {
        const els = document.querySelectorAll("[data-aos]");
        if (!els.length) return;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("aos-in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("aos-in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: "0px 0px -100px 0px" }
        );
        els.forEach((el) => io.observe(el));
      }

      // astro:page-load fires on the initial load and after every View Transitions
      // navigation, so freshly-swapped [data-aos] elements get re-observed.
      document.addEventListener("astro:page-load", revealOnScroll);
    </script>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="bg-[var(--bg-page)] text-[var(--text-primary)] antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[#1565c0] focus:text-white focus:rounded-lg focus:font-semibold focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2"
    >
      {t("common.skip")}
    </a>
    <NavBar lang={lang as Lang} />
    <main id="main-content" class="pt-16">
      <slot />
    </main>
    <Footer lang={lang as Lang} />
  </body>
</html>

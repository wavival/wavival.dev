---
import "@/styles/global.css";
import NavBar from "@/components/organisms/NavBar.astro";
import Footer from "@/components/organisms/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  ogPublishedTime?: string;
  ogModifiedTime?: string;
  noindex?: boolean;
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
  /** Preload /images/profile.webp as the LCP image. Only set on pages that render it (home, about). */
  preloadHero?: boolean;
}

const {
  title = "Valentina Ramírez | Full Stack Developer, Backend e IA",
  description = "Desarrolladora Full Stack con enfoque en backend e IA: construyo productos con Django, React y Next.js, con seguridad desde el diseño.",
  image = "/images/profile.webp",
  ogImage,
  ogImageAlt,
  ogType = "website",
  ogPublishedTime,
  ogModifiedTime,
  noindex = false,
  alternates = [],
  preloadHero = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ogLocale = lang === "en" ? "en_US" : "es_CO";
const t = useTranslations(lang as Lang);
const personDescription =
  "Full Stack Developer con enfoque en backend e IA y experiencia en Django, React y Next.js. Construyo productos con IA integrada y seguridad desde el diseño. Fundadora de Lúmina W, su empresa de software aparte (luminaw.co).";

const site = "https://www.wavival.dev";
const canonicalURL = new URL(Astro.url.pathname, site);
const isHome = ["/", "/en", "/en/"].includes(Astro.url.pathname);
const buildDate = new Date().toISOString();
const personImage = new URL(image, site);
const defaultSocialCard = `/images/og-card-${lang}.webp`;
const socialCard = ogImage ? new URL(ogImage, site) : new URL(defaultSocialCard, site);
const socialCardType = (ogImage ?? defaultSocialCard).endsWith(".webp")
  ? "image/webp"
  : "image/png";
const socialCardAlt =
  ogImageAlt ??
  (lang === "en"
    ? "Valentina Ramírez: Full Stack Developer · Backend and AI · Django · React · Next.js"
    : "Valentina Ramírez: Full Stack Developer · Backend e IA · Django · React · Next.js");

const UMAMI_SRC = import.meta.env.PUBLIC_UMAMI_SRC;
const UMAMI_ID = import.meta.env.PUBLIC_UMAMI_ID;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site}/#person`,
      name: "Valentina Ramírez",
      url: site,
      image: {
        "@type": "ImageObject",
        "@id": `${site}/#personimage`,
        url: personImage.toString(),
        width: 640,
        height: 640,
        caption: "Valentina Ramírez",
      },
      jobTitle: "Full Stack Developer",
      email: "wavival.dev@luminaw.co",
      description: personDescription,
      knowsAbout: [
        "Full Stack Development",
        "Backend Development",
        "Django",
        "Django REST Framework",
        "Next.js",
        "React",
        "TypeScript",
        "PostgreSQL",
        "REST APIs",
        "AI integration",
        "OpenAI",
        "OpenClaw",
        "LLM workflows",
        "Application Security",
        "OWASP",
      ],
      knowsLanguage: ["es", "en"],
      nationality: { "@type": "Country", name: "Colombia" },
      alumniOf: [
        { "@type": "EducationalOrganization", name: "SENA" },
        { "@type": "EducationalOrganization", name: "Universidad de San Buenaventura" },
        { "@type": "EducationalOrganization", name: "Platzi", url: "https://platzi.com" },
      ],
      sameAs: [
        "https://www.linkedin.com/in/wavival/",
        "https://github.com/wavival",
        "https://x.com/wavival0",
        "https://www.instagram.com/wavival/",
        "https://platzi.com/p/wavival",
      ],
    },
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: "Lúmina W",
      url: "https://luminaw.co",
      foundingDate: "2025-11",
      founder: { "@id": `${site}/#person` },
      logo: {
        "@type": "ImageObject",
        url: `${site}/brand/logo-w.webp`,
        width: 619,
        height: 464,
      },
      sameAs: ["https://blog.luminaw.co"],
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: site,
      name: "Valentina Ramírez",
      description: description,
      author: { "@id": `${site}/#person` },
      publisher: { "@id": `${site}/#person` },
    },
    ...(isHome
      ? [
          {
            "@type": "ProfilePage",
            "@id": `${site}/#profilepage`,
            url: canonicalURL.toString(),
            name: "Valentina Ramírez",
            inLanguage: lang === "en" ? "en-US" : "es-CO",
            isPartOf: { "@id": `${site}/#website` },
            dateModified: buildDate,
            mainEntity: { "@id": `${site}/#person` },
          },
        ]
      : []),
  ],
});
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        if (window.__navigationLoaderReady) return;
        window.__navigationLoaderReady = true;

        const minimumDuration = 1000;
        let startedAt = 0;
        let hideTimer;
        const loader = () => document.getElementById("navigation-loader");
        const showLoader = () => {
          window.clearTimeout(hideTimer);
          startedAt = performance.now();
          loader()?.classList.add("is-active");
        };

        document.addEventListener(
          "click",
          (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey
            ) {
              return;
            }

            const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
            if (!link || link.target === "_blank" || link.hasAttribute("download")) return;

            const target = new URL(link.href, window.location.href);
            const current = new URL(window.location.href);
            const isSameDocument =
              target.pathname === current.pathname &&
              target.search === current.search &&
              target.hash !== "";

            if (target.origin === current.origin && !isSameDocument) showLoader();
          },
          true
        );

        document.addEventListener("astro:before-preparation", () => {
          if (!loader()?.classList.contains("is-active")) showLoader();
        });

        document.addEventListener("astro:page-load", () => {
          const remaining = Math.max(0, minimumDuration - (performance.now() - startedAt));
          hideTimer = window.setTimeout(() => loader()?.classList.remove("is-active"), remaining);
        });
      })();
    </script>
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            const dark = localStorage.getItem("theme") !== "light";
            document.documentElement.classList.toggle("dark", dark);
            // Keep browser chrome (theme-color) in sync with the class-based theme.
            // Null on first parse (meta not yet reached); set on astro:after-swap.
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute("content", dark ? "#0f1117" : "#f0f4ff");
          } catch {
            /* localStorage unavailable: default to the dark theme */
            document.documentElement.classList.add("dark");
          }
        }
        applyTheme();
        // Re-apply before paint after a View Transitions swap: the incoming static
        // document has no .dark class, so without this the theme flashes on navigation.
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Valentina Ramírez" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content={ogType} />
    {
      ogType === "article" && ogPublishedTime && (
        <meta property="article:published_time" content={ogPublishedTime} />
      )
    }
    {
      ogType === "article" && ogModifiedTime && (
        <meta property="article:modified_time" content={ogModifiedTime} />
      )
    }
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:type" content={socialCardType} />
    <meta property="og:image:alt" content={socialCardAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocale === "en_US" ? "es_CO" : "en_US"} />
    <meta property="og:site_name" content="Valentina Ramírez" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wavival0" />
    <meta name="twitter:creator" content="@wavival0" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCard} />
    <meta name="twitter:image:alt" content={socialCardAlt} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}icon-192.png`}
      sizes="192x192"
    />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta name="theme-color" content="#0f1117" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/poppins-400.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/raleway-var.woff2`}
      crossorigin
    />
    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          href={`${import.meta.env.BASE_URL}images/profile.webp`}
          fetchpriority="high"
        />
      )
    }
    {UMAMI_SRC && UMAMI_ID && <script is:inline defer src={UMAMI_SRC} data-website-id={UMAMI_ID} />}
    {UMAMI_SRC && UMAMI_ID && <script>import "@/scripts/vitals";</script>}
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="bg-bg text-ink antialiased">
    <div id="navigation-loader" transition:persist aria-hidden="true">
      <img src={`${import.meta.env.BASE_URL}brand/logo-w.webp`} alt="" width="54" height="40" />
    </div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-100 focus:rounded-control focus:bg-btn focus:px-4 focus:py-2 focus:font-display focus:text-xs focus:font-bold focus:uppercase focus:tracking-widest focus:text-white focus:outline-hidden focus:ring-2 focus:ring-white focus:ring-offset-2"
    >
      {t("common.skip")}
    </a>
    <NavBar lang={lang as Lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang as Lang} />
  </body>
</html>

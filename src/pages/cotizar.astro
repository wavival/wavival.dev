---
import QuoteForm from "@/components/organisms/QuoteForm.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import { countryOptions } from "@/data/countries";
import { budgetRangeOptions } from "@/data/pricing";
import {
  howFoundOptions,
  preferredChannelOptions,
  quoteServiceOptions,
  timelineOptions,
} from "@/data/quoteOptions";
import { siteRoutes } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { COP_COUNTRY, currencyForPathname } from "@/utils/currency";

const base = import.meta.env.BASE_URL;
const r = siteRoutes("es", base);
// The COP variant is served only to visitors in Colombia, so it can prefill the country.
const currency = currencyForPathname(Astro.url.pathname);
const defaultCountry = currency === "COP" ? COP_COUNTRY : undefined;
---

<Layout
  title="Cotiza tu proyecto | Valentina Ramírez"
  contactBand={false}
  description="Cuéntame sobre tu proyecto y recibe una respuesta en un máximo de 24 horas."
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/cotizar/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/quote/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/cotizar/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="Cotización">
      <Fragment slot="title">Hablemos de tu proyecto</Fragment>
      <p class="body-lg m-0">Cuéntame qué necesitas. Te responderé en un máximo de 24 horas.</p>
    </PageIntro>
    <div class="mt-16 border-t border-ink pt-10">
      <QuoteForm
        lang="es"
        currency={currency}
        services={quoteServiceOptions("es")}
        countries={countryOptions("es")}
        defaultCountry={defaultCountry}
        budgetRanges={budgetRangeOptions(currency, "es")}
        howFound={howFoundOptions("es")}
        preferredChannels={preferredChannelOptions("es")}
        timelines={timelineOptions("es")}
        privacyHref={r.privacy}
        labels={{
          formTitle: "Solicitud de cotización",
          formIntro:
            "Usa este formulario para pedir una cotización: elige los servicios que te interesan, indica tu país y tu rango de presupuesto y cuéntame qué necesitas.",
          nextTitle: "Qué pasa después de enviarlo",
          nextSteps: [
            "Tu solicitud se guarda para darle seguimiento y llega al correo de Wavival.",
            "Te respondo en un máximo de 24 horas.",
            "Si seguimos adelante, el trabajo sigue el proceso publicado en Servicios: conversación, propuesta, build iterativo y entrega.",
          ],
          placeholders: {
            name: "Tu nombre completo",
            email: "tucorreo@empresa.com",
            business: "Nombre de tu negocio o empresa",
            description: "Cuéntame qué necesitas, para quién es y qué problema resuelve.",
          },
          phonePlaceholder: "+57 300 000 0000",
          phoneError: "Incluye el indicativo del país, por ejemplo +57 300 000 0000.",
          submitHint:
            "Completa los campos obligatorios, elige al menos un servicio y acepta la política de privacidad para poder enviar.",
          name: "Nombre",
          email: "Correo",
          phone: "Teléfono con indicativo",
          business: "Nombre del negocio",
          services: "Servicios que te interesan",
          country: "País",
          countryPlaceholder: "Selecciona tu país",
          budget: "Rango de presupuesto",
          budgetPlaceholder: "Selecciona un rango",
          description: "Describe tu proyecto",
          descriptionHint: "0/500",
          optionalTitle: "Opcional",
          optionalPlaceholder: "Selecciona una opción",
          howFound: "¿Cómo me conociste?",
          preferredChannel: "Canal preferido de contacto",
          timeline: "¿Para cuándo lo necesitas?",
          submit: "Enviar cotización",
          sending: "Enviando",
          successTitle: "Gracias por contactar",
          success: "Recibí tu información. Te responderé en un máximo de 24 horas.",
          error: "No fue posible enviar la cotización. Inténtalo de nuevo.",
          developmentClientsOnly:
            "El posicionamiento mensual es solo para clientes de desarrollo. Usa el correo con el que trabajamos o quita ese servicio.",
          privacyPrefix: "Acepto la",
          privacyLink: "política de privacidad",
          privacySuffix: " y el tratamiento de mis datos personales.",
          required: "Campos obligatorios",
          requiredTip: "Obligatorio",
        }}
      />
    </div>
  </section>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import Button from "@/components/atoms/Button.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import Badge from "@/components/atoms/Badge.astro";
import Index from "@/components/atoms/Index.astro";
import Eyebrow from "@/components/atoms/Eyebrow.astro";
import { siteRoutes } from "@/i18n/utils";
import RepoCard from "@/components/organisms/RepoCard.astro";
import StickyContentSection from "@/components/organisms/StickyContentSection.astro";
import SocialProfileCard from "@/components/organisms/SocialProfileCard.astro";
import { usesStack as stack } from "@/data/stack";
import { fetchGithubProfile, curateRepos } from "@/data/github";
import { SOCIAL_PROFILES } from "@/data/social";
import { usesSectionIndices } from "@/utils/sections";

const routes = siteRoutes("en", import.meta.env.BASE_URL);

const { user: githubUser, repos: githubRepos } = await fetchGithubProfile("wavival");
const { featured: featuredRepos, resources: resourceRepos } = curateRepos(githubRepos);
const indices = usesSectionIndices(Boolean(githubUser));

const pageTitle = "Uses: Tools and stack | Valentina Ramírez";
const pageDescription =
  "The stack and tools I use as a software developer focused on backend, AI and security (Django, Next.js, React, PostgreSQL, Astro, AI, and security) and why I choose each one.";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.wavival.dev/en/" },
    { "@type": "ListItem", position: 2, name: "Uses", item: "https://www.wavival.dev/en/uses/" },
  ],
});
const hardwareItems = [
  {
    title: "Linux machine",
    sub: "My everyday machine",
    tools: ["Intel Core i5", "16 GB RAM", "1 TB", "Linux · Fedora"],
  },
  {
    title: "Windows machine",
    sub: "My other machine",
    tools: [
      "AMD Ryzen 5 3400G",
      "Radeon RX Vega 11",
      "16 GB RAM",
      "224 GB",
      "Windows 11 Pro (25H2)",
      "WSL2 · Ubuntu",
    ],
  },
  {
    title: "Phone and recording",
    sub: "For the content",
    tools: ["Motorola Edge 60 Fusion", "DJI gimbal with extendable selfie stick"],
  },
  {
    title: "Peripherals",
    sub: "What I touch daily",
    tools: [
      'LG 27" ultrawide monitor (built-in audio)',
      "Genius keyboard",
      "Wired ergonomic mouse",
      "HP 1080p camera (built-in mic)",
    ],
  },
];
const softwareItems = [
  {
    title: "Code and AI",
    sub: "Where I write and reason",
    tools: [
      "VS Code",
      "Cursor",
      "Claude (app · chat · Code · Design)",
      "OpenAI",
      "OpenClaw",
      "ChatGPT",
      "Codex",
    ],
  },
  {
    title: "Terminal and APIs",
    sub: "The backend of the day",
    tools: ["Warp", "WSL (Ubuntu)", "Postman"],
  },
  {
    title: "Marketing and content",
    sub: "Visuals, audio and video",
    tools: ["Claude (see Code and AI)", "CapCut", "Canva", "ElevenLabs", "Higgsfield"],
  },
  {
    title: "Productivity and browsing",
    sub: "To not lose track",
    tools: ["Todoist", "Focus To-Do", "Notepad", "Firefox"],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/herramientas/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/uses/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/herramientas/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="Tools" size="uses">
      <Fragment slot="title">What I build with</Fragment>
      <p class="body-lg m-0">
        Everything I use to build: the stack, the machine, and everyday apps. Not a list of trends,
        these are the tools I use to deliver real products.
      </p>
    </PageIntro>

    <StickyContentSection
      index={indices.stack}
      eyebrow="Stack"
      title="What I develop with"
      description="The stack I use daily and the reasoning behind each choice: solid backend, functional frontend, applied AI, and security by design."
      class="section-gap"
    >
      {
        stack.map((s) => (
          <div
            class={`flex flex-col gap-3 border-b border-line py-7 ${s.category === "Backend" ? "border-l-2 border-l-blue bg-tint px-5" : ""}`.trim()}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="h-title m-0 text-2xl">{s.category}</h3>
                <span class="text-[13px] text-muted">{s.descriptionEn ?? s.description}</span>
              </div>
              {s.category === "Backend" && (
                <span class="label-sm label-sm-link shrink-0">Featured</span>
              )}
            </div>
            {(s.whyEn ?? s.why) && <p class="body m-0">{s.whyEn ?? s.why}</p>}
            <ChipList
              items={s.toolsEn ?? s.tools}
              class={s.category === "Backend" ? "[&_.chip]:border-blue [&_.chip]:text-link" : ""}
            />
          </div>
        ))
      }
    </StickyContentSection>

    <StickyContentSection
      index={indices.hardware}
      eyebrow="Hardware"
      title="Where I build it"
      description="Modest setup on purpose. If an app runs smoothly here, it runs anywhere: it forces me to really optimize, not cover up with hardware."
      class="section-gap"
    >
      {
        hardwareItems.map((it) => (
          <div class="flex flex-col gap-3 border-b border-line py-7">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="h-title m-0 text-2xl">{it.title}</h3>
              <span class="text-[13px] text-muted">{it.sub}</span>
            </div>
            <ChipList items={it.tools} />
          </div>
        ))
      }
    </StickyContentSection>

    <StickyContentSection
      index={indices.software}
      eyebrow="Software"
      title="My everyday tools"
      description="The apps where I live while building: editing, AI, terminal, and the productivity flow that keeps me focused."
      class="section-gap"
    >
      {
        softwareItems.map((it) => (
          <div class="flex flex-col gap-3 border-b border-line py-7">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="h-title m-0 text-2xl">{it.title}</h3>
              <span class="text-[13px] text-muted">{it.sub}</span>
            </div>
            <ChipList items={it.tools} />
          </div>
        ))
      }
    </StickyContentSection>

    {
      githubUser && (
        <div
          id="repos"
          class="rule-section section-gap flex scroll-mt-24 flex-wrap gap-x-12 gap-y-6"
        >
          <div class="flex shrink-0 grow-0 basis-full flex-col min-[790px]:basis-[260px] lg:self-start">
            <div class="flex items-baseline gap-[14px]">
              <Fragment>
                <Index>{indices.github}</Index>
                <Eyebrow>GitHub</Eyebrow>
              </Fragment>
            </div>
            <h2 class="h-title m-0 mt-4 text-[32px] leading-[1.05] tracking-[-0.02em]">
              Learn, build, share
            </h2>
            <p class="m-0 mt-3 text-sm leading-[1.7] text-muted">
              {githubUser.public_repos} public repos · {githubUser.followers} followers
            </p>
            <TextLink
              href={githubUser.html_url}
              target="_blank"
              class="mt-3 self-start"
              aria-label="See Valentina Ramírez's full GitHub profile"
            >
              See full profile
            </TextLink>
          </div>
          <div class="flex min-w-0 flex-1 basis-[480px] flex-col gap-10">
            {featuredRepos.length > 0 && (
              <div class="border border-line border-t-2 border-t-blue bg-surface p-6 md:p-10">
                <Badge>Featured</Badge>
                <h3 class="h-title m-0 mt-4 text-4xl tracking-[-0.03em]">NullBreach</h3>
                <p class="body m-0 mt-[10px]">
                  My flagship project: AI-powered security analysis. A Next.js app using OpenAI and
                  Prisma, with its source open on GitHub.
                </p>
                <div
                  class="mt-5 grid gap-3"
                  style="grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))"
                >
                  {featuredRepos.map((repo) => (
                    <RepoCard repo={repo} lang="en" />
                  ))}
                </div>
              </div>
            )}
            {resourceRepos.length > 0 && (
              <div>
                <h3 class="h-title m-0 text-2xl">Resources to learn from</h3>
                <p class="body m-0 mt-2">
                  I take courses on Platzi, YouTube, and other sources, and turn what I learn into
                  public repos so other people can learn too.
                </p>
                <ul
                  class="m-0 mt-6 grid list-none gap-3 p-0"
                  role="list"
                  style="grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))"
                >
                  {resourceRepos.map((repo) => (
                    <li>
                      <RepoCard repo={repo} lang="en" variant="resource" />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )
    }

    <StickyContentSection
      id="social"
      index={indices.social}
      eyebrow="Social"
      title="I build in public"
      description="On Instagram and TikTok I show how I build secure software and AI automations, and what I keep learning along the way."
      class="section-gap scroll-mt-24"
      sticky={false}
    >
      <TextLink
        slot="label"
        href={SOCIAL_PROFILES.instagram.href}
        target="_blank"
        class="mt-3 self-start"
        aria-label="See profiles of Valentina Ramírez on Instagram and TikTok"
      >
        See profiles
      </TextLink>
      <div
        class="grid gap-3"
        style="grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))"
      >
        <SocialProfileCard network="instagram" name="Instagram">
          Reels and posts with the behind the scenes of each project and what I learn along the way.
        </SocialProfileCard>
        <SocialProfileCard network="tiktok" name="TikTok">
          Short videos where I explain how I build secure software and AI automations.
        </SocialProfileCard>
      </div>
    </StickyContentSection>

    <div class="section-gap rule-line flex flex-wrap justify-center gap-3 pt-8">
      <Button variant="primary" href={routes.services} aria-label="See services"
        >See services</Button
      >
      <Button
        variant="secondary"
        href={routes.projects}
        aria-label="See projects where I use this stack">See projects</Button
      >
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

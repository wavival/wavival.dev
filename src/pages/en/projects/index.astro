---
import Layout from "@/layouts/Layout.astro";
import Projects from "@/components/sections/Projects.astro";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.wavival.dev/en/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Projects",
      item: "https://www.wavival.dev/en/projects/",
    },
  ],
});
---

<Layout
  title="Projects & Lab | Valentina Ramírez"
  description="Products I've built: agri-industrial SaaS, PWAs, AI-powered security analysis, and pentesting. Django, React, Next.js, PostgreSQL, and more."
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/proyectos/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/projects/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/proyectos/" },
  ]}
>
  <Projects lang="en" heading="h1" />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Stack from "@/components/sections/Stack.astro";
import About from "@/components/sections/About.astro";
import Contact from "@/components/sections/Contact.astro";

const title = "Valentina Ramírez | Full Stack Developer";
const description =
  "Full Stack Developer building products with Django, React, and Next.js, applied AI, and security by design.";
---

<Layout
  title={title}
  description={description}
  lang="en"
  ogType="profile"
  preloadHero
  alternates={[
    { hreflang: "es", href: "https://wavival.dev/" },
    { hreflang: "en", href: "https://wavival.dev/en/" },
    { hreflang: "x-default", href: "https://wavival.dev/" },
  ]}
>
  <Hero lang="en" />
  <Projects featured lang="en" />
  <Stack lang="en" />
  <About lang="en" />
  <Contact lang="en" />
</Layout>

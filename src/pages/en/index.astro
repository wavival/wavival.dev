---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/organisms/Hero.astro";
import FeaturedProjects from "@/components/organisms/FeaturedProjects.astro";
import StackSection from "@/components/organisms/StackSection.astro";
import AboutSection from "@/components/organisms/AboutSection.astro";

const title = "Valentina Ramírez | Software and digital marketing";
const description =
  "I help entrepreneurs save time and sell more with software and digital marketing: landing pages, websites, chatbots, custom apps and digital strategy.";
---

<Layout
  title={title}
  description={description}
  lang="en"
  ogType="profile"
  ogImageAlt="Software and digital marketing for entrepreneurs. Landing pages, websites, chatbots and custom apps that save you time and help you sell. Valentina Ramírez · @wavival · wavival.dev"
  preloadHero
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/" },
  ]}
>
  <Hero lang="en" />
  <FeaturedProjects lang="en" />
  <StackSection lang="en" />
  <AboutSection lang="en" />
</Layout>

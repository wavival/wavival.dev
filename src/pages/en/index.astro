---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/organisms/Hero.astro";
import FeaturedProjects from "@/components/organisms/FeaturedProjects.astro";
import StackSection from "@/components/organisms/StackSection.astro";
import AboutSection from "@/components/organisms/AboutSection.astro";

const title = "Valentina Ramírez | Secure software and AI automation";
const description =
  "I help entrepreneurs save time with secure software and AI automation: landing pages, websites, chatbots and custom apps, built in public.";
---

<Layout
  title={title}
  description={description}
  lang="en"
  ogType="profile"
  ogImageAlt="Secure software and AI automation for entrepreneurs. Landing pages, websites, chatbots and custom apps that save you time. Valentina Ramírez · @wavival · wavival.dev"
  preloadHero
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/" },
  ]}
>
  <Hero lang="en" />
  <FeaturedProjects lang="en" />
  <StackSection lang="en" />
  <AboutSection lang="en" />
</Layout>

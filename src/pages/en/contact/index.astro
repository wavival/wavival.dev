---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import Button from "@/components/atoms/Button.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import MaskIcon from "@/components/atoms/MaskIcon.astro";
import Index from "@/components/atoms/Index.astro";

const email = "wavival.dev@luminaw.co";
const whatsappNumber = "573016560222";
const whatsappMessage =
  "Hi Valentina, I am coming from your portfolio and want to talk about a project.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const calendlyUrl = "https://calendly.com/wavival/descubrimiento-servicios-wavival";

const pageTitle = "Contact: build your product | Valentina Ramirez";
const pageDescription =
  "Three ways to start: email, WhatsApp, or a 30-minute discovery call. I design and build complete products, from backend to interface.";

const site = "https://www.wavival.dev";
const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.wavival.dev/en/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Contact",
      item: "https://www.wavival.dev/en/contact/",
    },
  ],
});
const contactSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${site}/en/contact/#contactpage`,
  url: `${site}/en/contact/`,
  name: pageTitle,
  description: pageDescription,
  inLanguage: "en-US",
  mainEntity: { "@id": `${site}/#person` },
});

const channels = [
  {
    icon: "send-email-white",
    title: "Email",
    body: "Tell me about your project at your own pace. I respond within 24h.",
    href: `mailto:${email}`,
    target: "_self" as const,
    cta: "Write to me",
    ariaLabel: "Send an email to Valentina Ramirez",
    event: "contacto-email",
  },
  {
    icon: "whatsapp",
    title: "WhatsApp",
    body: "For quick questions or getting started right away.",
    href: whatsappHref,
    target: "_blank" as const,
    cta: "Chat",
    ariaLabel: "Message Valentina Ramirez on WhatsApp",
    event: "contacto-whatsapp",
  },
  {
    icon: "calendar-blue",
    title: "30-min call",
    body: "No commitment. Book in your time zone; I coordinate from COT (UTC-5).",
    href: "#agenda",
    target: "_self" as const,
    cta: "Schedule",
    ariaLabel: "Go to the calendar to schedule a call",
    event: "contacto-calendly",
  },
];
const steps = [
  "Pick a time that works for you.",
  "We talk 30 min about your idea.",
  "I send you a clear proposal.",
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/contacto/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/contact/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/contacto/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="Let's talk" size="contact">
      <Fragment slot="title"
        >Your next idea deserves <span class="accent">code that can carry it.</span></Fragment
      >
      <p class="body-lg m-0">
        Have a product in mind? Choose how you would like to start. I design and build complete
        products, from backend to interface, with integrated AI and security by design.
      </p>
    </PageIntro>

    <div
      class="mt-16 grid border-t border-ink"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))"
    >
      {
        channels.map((c, i) => (
          <article class="flex flex-col gap-5 border-b border-line py-8 pr-7">
            <div class="flex items-center justify-between">
              <Index>{String(i + 1).padStart(2, "0")}</Index>
              <span class="inline-flex h-12 w-12 items-center justify-center border border-line bg-tint">
                <MaskIcon name={c.icon} size="lg" />
              </span>
            </div>
            <h2 class="h-title m-0 text-[32px] tracking-[-0.02em]">{c.title}</h2>
            <p class="m-0 text-[15px] leading-[1.65] text-muted">{c.body}</p>
            <Button
              variant="secondary"
              size="sm"
              class="mt-auto self-start"
              href={c.href}
              target={c.target}
              aria-label={c.ariaLabel}
              data-umami-event={c.event}
            >
              {c.cta}
            </Button>
          </article>
        ))
      }
    </div>

    <p class="mb-0 mt-6 text-sm text-muted">
      Projects from <strong class="font-semibold text-ink">USD 250 / COP 1,000,000</strong> depending
      on scope. Limited availability.
    </p>
  </section>

  <section id="agenda" class="wrap pb-[var(--sec)]">
    <SectionHeader
      label="30-minute call"
      title="Schedule a discovery call"
      titleClass="h2-sub"
      class="mb-10"
    >
      <ol
        class="m-0 mt-8 grid list-none gap-x-8 gap-y-4 p-0"
        style="grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))"
      >
        {
          steps.map((text, i) => (
            <li class="flex items-baseline gap-[14px] text-[15px] text-ink">
              <span class="h-title text-[28px] text-blue">{i + 1}</span>
              {text}
            </li>
          ))
        }
      </ol>
    </SectionHeader>

    <div
      id="calendly-embed"
      role="region"
      aria-label="Calendar to book a 30-minute call"
      class="overflow-hidden border border-line bg-bg"
    >
      <noscript>
        <p class="body m-0 p-6">
          The calendar requires JavaScript. Schedule directly on
          <TextLink
            variant="inline"
            href={calendlyUrl}
            target="_blank"
            aria-label="Open the Calendly calendar">Calendly</TextLink
          > or write to me at <TextLink variant="inline" href={`mailto:${email}`}>{email}</TextLink
          >.
        </p>
      </noscript>
    </div>
  </section>

  <script is:inline define:vars={{ calendlyUrl }}>
    (function () {
      const dark = document.documentElement.classList.contains("dark");
      let url = calendlyUrl + "?hide_gdpr_banner=1&primary_color=1565c0";
      if (dark) url += "&background_color=0f1117&text_color=e5e7eb";

      const container = document.getElementById("calendly-embed");
      const widget = document.createElement("div");
      widget.className = "calendly-inline-widget";
      widget.setAttribute("data-url", url);
      widget.style.minWidth = "320px";
      widget.style.height = "1000px";
      container.appendChild(widget);

      window.addEventListener("message", function (e) {
        if (e.origin.indexOf("calendly.com") === -1) return;
        if (!e.data || e.data.event !== "calendly.page_height") return;
        const h = e.data.payload && e.data.payload.height;
        if (!h) return;
        widget.style.height = h;
        const iframe = widget.querySelector("iframe");
        if (iframe) {
          iframe.style.height = h;
          if (!iframe.getAttribute("title"))
            iframe.setAttribute("title", "Calendly calendar to book a call");
        }
      });

      const s = document.createElement("script");
      s.src = "https://assets.calendly.com/assets/external/widget.js";
      s.async = true;
      document.body.appendChild(s);
    })();
  </script>

  <script is:inline type="application/ld+json" set:html={contactSchema} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/ui/Link.astro";

const email = "wavival.dev@luminaw.co";
const whatsappNumber = "573016560222";
const whatsappMessage =
  "Hi Valentina, I am coming from your portfolio and want to talk about a project.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const calendlyUrl = "https://calendly.com/wavival/descubrimiento-servicios-wavival";

const pageTitle = "Contact: build your product | Valentina Ramirez";
const pageDescription =
  "Three ways to start: email, WhatsApp, or a 30-minute discovery call. I design and build complete products, from backend to interface.";

const site = "https://wavival.dev";
const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://wavival.dev/en/" },
    { "@type": "ListItem", position: 2, name: "Contact", item: "https://wavival.dev/en/contact/" },
  ],
});
const contactSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${site}/en/contact#contactpage`,
  url: `${site}/en/contact`,
  name: pageTitle,
  description: pageDescription,
  inLanguage: "en-US",
  mainEntity: { "@id": `${site}/#person` },
});

const channels = [
  {
    icon: "send-email-white",
    iconWrap: "bg-[var(--brand-blue)]",
    title: "Email",
    body: "Tell me about your project at your own pace. I respond within 24h.",
    href: `mailto:${email}`,
    target: "_self" as const,
    cta: "Write to me",
    ariaLabel: "Send an email to Valentina Ramirez",
    event: "contacto-email",
  },
  {
    icon: "whatsapp",
    iconWrap: "bg-[var(--bg-blur)]",
    title: "WhatsApp",
    body: "For quick questions or getting started right away.",
    href: whatsappHref,
    target: "_blank" as const,
    cta: "Chat",
    ariaLabel: "Message Valentina Ramirez on WhatsApp",
    event: "contacto-whatsapp",
  },
  {
    icon: "calendar-blue",
    iconWrap: "bg-[var(--bg-blur)]",
    title: "30-min call",
    body: "No commitment. Book in your time zone; I coordinate from COT (UTC-5).",
    href: "#agenda",
    target: "_self" as const,
    cta: "Schedule",
    ariaLabel: "Go to the calendar to schedule a call",
    event: "contacto-calendly",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://wavival.dev/contacto/" },
    { hreflang: "en", href: "https://wavival.dev/en/contact/" },
    { hreflang: "x-default", href: "https://wavival.dev/contacto/" },
  ]}
>
  <section class="section" data-aos="fade-up">
    <p class="section-subtitle">Let's talk</p>
    <h1 class="section-title">
      Your next idea deserves <span class="text-[var(--brand-blue)]">code that can carry it.</span>
    </h1>
    <p class="text-[var(--text-muted)] leading-relaxed mt-4 max-w-2xl">
      Have a product in mind? Choose how you would like to start. I design and build complete
      products, from backend to interface, with integrated AI and security by design.
    </p>

    <div class="grid gap-6 md:grid-cols-3 mt-10">
      {
        channels.map((c) => (
          <article class="card flex flex-col gap-4 !p-6">
            <span
              class={`flex items-center justify-center w-12 h-12 rounded-[var(--radius-md)] ${c.iconWrap}`}
            >
              <img
                src={`${import.meta.env.BASE_URL}icons/ui/${c.icon}.svg`}
                alt=""
                width="24"
                height="24"
                class="w-[24px] h-[24px]"
              />
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="font-display font-bold text-lg text-[var(--text-primary)]">{c.title}</h3>
              <p class="text-sm text-[var(--text-muted)] leading-relaxed">{c.body}</p>
            </div>
            <Link
              href={c.href}
              target={c.target}
              class="!text-sm mt-auto"
              aria-label={c.ariaLabel}
              data-umami-event={c.event}
            >
              {c.cta}
            </Link>
          </article>
        ))
      }
    </div>

    <p class="text-xs text-[var(--text-muted)] mt-6">
      Projects from <strong class="text-[var(--text-primary)]">COP 2,000,000 / USD 500</strong> depending
      on scope. Limited availability.
    </p>
  </section>

  <section id="agenda" class="section !pt-0" data-aos="fade-up">
    <h2 class="font-display font-bold text-2xl text-[var(--text-primary)] mb-6">
      Schedule a discovery call
    </h2>

    <ol class="grid gap-4 md:grid-cols-3 mb-10">
      {
        [
          { n: "1", text: "Pick a time that works for you." },
          { n: "2", text: "We talk 30 min about your idea." },
          { n: "3", text: "I send you a clear proposal." },
        ].map((step) => (
          <li class="flex items-center gap-3 text-sm text-[var(--text-muted)]">
            <span class="flex items-center justify-center w-8 h-8 shrink-0 rounded-full bg-[var(--brand-blue)] text-white font-display font-bold">
              {step.n}
            </span>
            {step.text}
          </li>
        ))
      }
    </ol>

    <div
      id="calendly-embed"
      role="region"
      aria-label="Calendar to book a 30-minute call"
      class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--border-base)]"
    >
      <noscript>
        <p class="text-[var(--text-muted)] leading-relaxed p-6">
          The calendar requires JavaScript. Schedule directly on
          <Link
            href={calendlyUrl}
            target="_blank"
            class="inline"
            aria-label="Open the Calendly calendar">Calendly</Link
          > or write to me at <Link href={`mailto:${email}`} class="inline">{email}</Link>.
        </p>
      </noscript>
    </div>
  </section>

  <script is:inline define:vars={{ calendlyUrl }}>
    (function () {
      const dark = document.documentElement.classList.contains("dark");
      let url = calendlyUrl + "?hide_gdpr_banner=1&primary_color=1565c0";
      if (dark) url += "&background_color=0f1117&text_color=e5e7eb";

      const container = document.getElementById("calendly-embed");
      const widget = document.createElement("div");
      widget.className = "calendly-inline-widget";
      widget.setAttribute("data-url", url);
      widget.style.minWidth = "320px";
      widget.style.height = "1000px";
      container.appendChild(widget);

      window.addEventListener("message", function (e) {
        if (e.origin.indexOf("calendly.com") === -1) return;
        if (!e.data || e.data.event !== "calendly.page_height") return;
        const h = e.data.payload && e.data.payload.height;
        if (!h) return;
        widget.style.height = h;
        const iframe = widget.querySelector("iframe");
        if (iframe) {
          iframe.style.height = h;
          if (!iframe.getAttribute("title"))
            iframe.setAttribute("title", "Calendly calendar to book a call");
        }
      });

      const s = document.createElement("script");
      s.src = "https://assets.calendly.com/assets/external/widget.js";
      s.async = true;
      document.body.appendChild(s);
    })();
  </script>

  <script is:inline type="application/ld+json" set:html={contactSchema} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

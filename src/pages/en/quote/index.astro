---
import QuoteForm from "@/components/organisms/QuoteForm.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import { countryOptions } from "@/data/countries";
import { budgetRangeOptions } from "@/data/pricing";
import {
  howFoundOptions,
  preferredChannelOptions,
  quoteServiceOptions,
  timelineOptions,
} from "@/data/quoteOptions";
import { siteRoutes } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { COP_COUNTRY, currencyForPathname } from "@/utils/currency";

const base = import.meta.env.BASE_URL;
const r = siteRoutes("en", base);
// The COP variant is served only to visitors in Colombia, so it can prefill the country.
const currency = currencyForPathname(Astro.url.pathname);
const defaultCountry = currency === "COP" ? COP_COUNTRY : undefined;
---

<Layout
  title="Request a quote | Valentina Ramírez"
  contactBand={false}
  description="Tell me about your project and receive a response within 24 hours."
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/cotizar/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/quote/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/cotizar/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="Quote">
      <Fragment slot="title">Let's talk about your project</Fragment>
      <p class="body-lg m-0">Tell me what you need. I will reply within 24 hours.</p>
    </PageIntro>
    <div class="mt-16 border-t border-ink pt-10">
      <QuoteForm
        lang="en"
        currency={currency}
        services={quoteServiceOptions("en")}
        countries={countryOptions("en")}
        defaultCountry={defaultCountry}
        budgetRanges={budgetRangeOptions(currency, "en")}
        howFound={howFoundOptions("en")}
        preferredChannels={preferredChannelOptions("en")}
        timelines={timelineOptions("en")}
        privacyHref={r.privacy}
        labels={{
          formTitle: "Quote request",
          formIntro:
            "Use this form to ask for a quote: choose the services you are interested in, tell me your country and budget range, and describe what you need.",
          nextTitle: "What happens after you send it",
          nextSteps: [
            "Your request is stored for follow-up and goes to Wavival's email.",
            "I reply within 24 hours.",
            "If we move forward, the work follows the process published on Services: conversation, proposal, iterative build, and delivery.",
          ],
          placeholders: {
            name: "Your full name",
            email: "you@company.com",
            business: "Your business or company name",
            description: "Tell me what you need, who it is for, and what problem it solves.",
          },
          phonePlaceholder: "+57 300 000 0000",
          phoneError: "Include the country code, for example +57 300 000 0000.",
          submitHint:
            "Fill in the required fields, choose at least one service, and accept the privacy policy to send.",
          name: "Name",
          email: "Email",
          phone: "Phone with country code",
          business: "Business name",
          services: "Services you are interested in",
          country: "Country",
          countryPlaceholder: "Select your country",
          budget: "Budget range",
          budgetPlaceholder: "Select a range",
          description: "Describe your project",
          descriptionHint: "0/500",
          optionalTitle: "Optional",
          optionalPlaceholder: "Choose an option",
          howFound: "How did you find me?",
          preferredChannel: "Preferred contact channel",
          timeline: "When do you need it?",
          submit: "Send quote request",
          sending: "Sending",
          successTitle: "Thank you for reaching out",
          success: "I received your information. I will reply within 24 hours.",
          error: "Your quote request could not be sent. Please try again.",
          developmentClientsOnly:
            "Monthly SEO is for development clients only. Use the email we worked with or remove that service.",
          privacyPrefix: "I accept the",
          privacyLink: "privacy policy",
          privacySuffix: " and the processing of my personal data.",
          required: "Required fields",
          requiredTip: "Required",
        }}
      />
    </div>
  </section>
</Layout>

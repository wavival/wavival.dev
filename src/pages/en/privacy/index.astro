---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/ui/Link.astro";

const email = "wavival.dev@luminaw.co";

const pageTitle = "Privacy policy | Valentina Ramirez";
const pageDescription =
  "How wavival.dev handles your data: analytics, cookies, third-party services, and your rights.";

const lastUpdate = "June 17, 2026";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://wavival.dev/privacidad/" },
    { hreflang: "en", href: "https://wavival.dev/en/privacy/" },
    { hreflang: "x-default", href: "https://wavival.dev/privacidad/" },
  ]}
>
  <section class="section">
    <p class="section-subtitle">Legal</p>
    <h1 class="section-title">Privacy policy</h1>
    <p class="text-sm text-[var(--text-muted)] mt-2">Last updated: {lastUpdate}</p>

    <div class="flex flex-col gap-10 mt-10 max-w-3xl">
      <section data-aos="fade-up">
        <h2 class="font-display font-bold text-xl text-[var(--brand-blue)]">Controller</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mt-2">
          This site (wavival.dev) is the personal portfolio of Valentina Ramirez, Full Stack
          Developer and founder of Lumina W. For any matter regarding your data, write to
          <Link href={`mailto:${email}`} class="!lowercase">{email}</Link>.
        </p>
      </section>

      <section data-aos="fade-up">
        <h2 class="font-display font-bold text-xl text-[var(--brand-blue)]">What data I collect</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mt-2">
          This site is static and has no contact forms: I do not collect your name, email, or any
          data you type here. Contact happens through external channels (email, WhatsApp, Calendly),
          where each service's own policy applies.
        </p>
      </section>

      <section data-aos="fade-up">
        <h2 class="font-display font-bold text-xl text-[var(--brand-blue)]">
          Analytics and cookies
        </h2>
        <p class="text-[var(--text-muted)] leading-relaxed mt-2">
          If analytics are enabled, I use Umami: a cookieless, privacy-focused tool. It measures, in
          aggregate and anonymous form, how the site is used (page views, country, device type,
          where the visit comes from). It sets no cookies, does not track across sites, and does not
          identify individuals; nor is data shared for advertising purposes.
        </p>
        <p class="text-[var(--text-muted)] leading-relaxed mt-3">
          Since no tracking cookies are used, this site does not need a consent banner.
        </p>
      </section>

      <section data-aos="fade-up">
        <h2 class="font-display font-bold text-xl text-[var(--brand-blue)]">
          Third-party services
        </h2>
        <p class="text-[var(--text-muted)] leading-relaxed mt-2">
          On the contact page, the site loads the Calendly calendar. This service may record your IP
          simply by serving the resource. Typefaces are served from the site itself (no third
          party). Hosting is provided by Vercel, which maintains standard server technical logs.
          Each provider handles that data under their own policy.
        </p>
      </section>

      <section data-aos="fade-up">
        <h2 class="font-display font-bold text-xl text-[var(--brand-blue)]">Your rights</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mt-2">
          Under applicable regulations including GDPR and Colombia's Ley 1581 de 2012 (Habeas Data),
          you have the right to access, rectify, erase, and restrict processing of your personal
          data, and to withdraw any consent. Since this site does not store your personal data, most
          of these requests are handled with the third-party services mentioned above. For
          questions, write to <Link href={`mailto:${email}`} class="!lowercase">{email}</Link>.
        </p>
      </section>

      <section data-aos="fade-up">
        <h2 class="font-display font-bold text-xl text-[var(--brand-blue)]">Changes</h2>
        <p class="text-[var(--text-muted)] leading-relaxed mt-2">
          If this policy changes, I will update the date above. Continued use of the site implies
          acceptance of the current version.
        </p>
      </section>
    </div>
  </section>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import ServicesCatalog from "@/components/organisms/ServicesCatalog.astro";
import ServicesDetail from "@/components/organisms/ServicesDetail.astro";
import { servicesFaq, servicesFaqLd } from "@/data/servicesFaq";
import { servicesLd } from "@/data/servicesLd";

const site = "https://www.wavival.dev";

const pageTitle = "Services: software development and digital marketing";
const pageDescription =
  "Landing pages, websites, AI chatbots, custom apps, offer strategy and digital launches, each with a clear timeline. Software and strategy that sell.";

const fit = {
  yes: [
    "Owners of small service businesses (1 to 10 people) that already sell and have customers",
    "Businesses that run on WhatsApp, Instagram, Excel or Google Sheets and email",
    "Anyone who answers the same messages, schedules and quotes by hand, loses leads, or has an outdated website or none at all",
    "Non-technical people who want results: time saved and more sales",
    "Appointment-based services (clinics, beauty, psychology, lawyers, accountants), academies and trainers, and small shops that sell through Instagram or WhatsApp",
    "Creators, experts and trainers with a community or specialized knowledge who need to structure an educational offer or plan its launch",
  ],
  no: [
    "Your team has more than 10 people, or the project needs a team or exceeds the wavival budget ceiling: those projects go to Lúmina\u00a0W",
    "You are looking for a certified pentest or a compliance certification",
    "You are looking for daily social media management or a marketing agency",
  ],
};

const process = [
  {
    step: "01",
    title: "Conversation",
    body: "I understand your business or your offer before talking technology or strategy. What you need, for whom, and why.",
  },
  {
    step: "02",
    title: "Proposal",
    body: "I define scope, deliverables, and timelines. No surprises: you know what is being built or planned and in what order.",
  },
  {
    step: "03",
    title: "Iterative deliveries",
    body: "I work in visible deliveries. You see real progress, not weeks of silence followed by a big bang.",
  },
  {
    step: "04",
    title: "Delivery",
    body: "Software in production, documented and maintainable, or a strategy ready to execute. Built to last beyond the first delivery.",
  },
];

// Structured data is the same for every visitor: every price in COP and in USD, with the region each applies to.
const serviceLd = JSON.stringify(
  servicesLd({
    lang: "en",
    site,
    url: `${site}/en/services/`,
    name: "Valentina Ramírez: software development and digital marketing",
    description: pageDescription,
  })
);

const faqLd = JSON.stringify(servicesFaqLd("en"));

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.wavival.dev/en/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Services",
      item: "https://www.wavival.dev/en/services/",
    },
  ],
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  contactBandSecondary="contact"
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/servicios/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/services/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/servicios/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="How I can help" size="page">
      <Fragment slot="title">I build your software and the strategy to sell it</Fragment>
      <p class="body-lg m-0">
        I am a software developer and digital strategist: I take a business problem and deliver it
        as real software in production, and I design the digital strategy to sell what you offer,
        from the offer and the launch to the presence that gets you found. Every service shows its
        price or how it is quoted, its timeline and its scope, so you know what you get before we
        start.
      </p>
    </PageIntro>

    <ServicesCatalog lang="en" />

    <ServicesDetail
      fit={{
        ...fit,
        yesTitle: "I work best with",
        noTitle: "Not the right fit if",
        yesMark: "YES",
        noMark: "NO",
      }}
      processLabel="Process"
      processTitle="How I work"
      process={process}
      faqTitle="Frequently asked questions"
      faqs={servicesFaq("en")}
      faqOpenLabel="View"
      faqCloseLabel="Close"
    />
  </section>

  <script is:inline type="application/ld+json" set:html={serviceLd} />
  <script is:inline type="application/ld+json" set:html={faqLd} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

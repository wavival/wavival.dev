---
import Layout from "@/layouts/Layout.astro";
import Contact from "@/components/sections/Contact.astro";

const base = import.meta.env.BASE_URL;
const site = "https://wavival.dev";

const pageTitle = "Services: Custom Full Stack Development | Valentina Ramirez";
const pageDescription =
  "Full Stack Developer freelance: custom web apps with Django, React, Next.js, and Supabase, AI integrations, and security by design.";

interface ServiceExample {
  name: string;
  description: string;
  href: string;
}

interface Service {
  title: string;
  body: string;
  tools: string[];
  timeline: string;
  featured?: boolean;
  specialty?: boolean;
  examples?: ServiceExample[];
}

const services: Service[] = [
  {
    title: "Custom web applications",
    body: "Complete product end to end: Django + DRF or Next.js with Supabase, React + TypeScript interfaces, and deployment. For founders who need something real, not a demo.",
    tools: ["Django", "DRF", "Next.js", "Supabase", "React", "TypeScript", "PostgreSQL"],
    timeline: "8 to 14 weeks",
    featured: true,
    examples: [
      {
        name: "TerraCore",
        description: "multi-tenancy agri-industrial platform",
        href: `${base}en/projects/terracore`,
      },
      {
        name: "OKroot",
        description: "offline-first food health PWA",
        href: `${base}en/projects/root`,
      },
    ],
  },
  {
    title: "REST APIs and backend",
    body: "I design and build clean, authenticated, and documented APIs. Relational modeling, role-based access control, multitenancy, and complex business logic that holds up as you grow.",
    tools: ["Django REST Framework", "JWT", "PostgreSQL", "Multitenancy"],
    timeline: "3 to 6 weeks",
    examples: [
      {
        name: "NullBreach",
        description: "Next.js OWASP analysis application",
        href: `${base}en/projects/nullbreach`,
      },
    ],
  },
  {
    title: "Security and AppSec",
    body: "I review applications with OWASP Top 10 criteria and a pentester mindset. Security integrated from the design: authentication, secrets handling, validation, and protected endpoints.",
    tools: ["OWASP", "AppSec", "PTES", "MITRE ATT&CK"],
    timeline: "1 to 2 weeks",
    examples: [
      {
        name: "Forgotten Portal",
        description: "offensive pentesting on DockerLabs",
        href: `${base}en/projects/forgotten-portal`,
      },
    ],
  },
  {
    title: "AI integrations",
    body: "I integrate OpenAI, OpenClaw, and Claude API in LLM workflows where they add value: analysis, context-aware assistance, and automation. AI as the product's co-pilot, not decoration.",
    tools: ["OpenAI", "OpenClaw", "Claude API", "LLM Workflows", "n8n", "Prompt Engineering"],
    timeline: "2 to 4 weeks",
    specialty: true,
    examples: [
      {
        name: "OKroot",
        description: "label scanner with Claude API",
        href: `${base}en/projects/root`,
      },
      {
        name: "NullBreach",
        description: "OWASP analysis and security chat with per-user history",
        href: `${base}en/projects/nullbreach`,
      },
    ],
  },
];

const fit = {
  yes: [
    "Founders with a real product who need speed",
    "Teams that need API and frontend in one contract",
    "Startups that value security by design",
  ],
  no: [
    "The project is only design or static mockups",
    "You need someone available in office 9-5",
    "You are looking for the lowest price, not the best result",
  ],
};

const process = [
  {
    step: "01",
    title: "Conversation",
    body: "I understand the business problem before talking technology. What you need, for whom, and why.",
  },
  {
    step: "02",
    title: "Proposal",
    body: "I define scope, architecture, and deliverables. No surprises: you know what is being built and in what order.",
  },
  {
    step: "03",
    title: "Iterative build",
    body: "I build in visible deliveries. You see real progress, not weeks of silence followed by a big bang.",
  },
  {
    step: "04",
    title: "Delivery",
    body: "Product in production, documented and maintainable. Built to last beyond the first release.",
  },
];

const faqs = [
  {
    q: "Do you handle design?",
    a: "Yes, I am a UX/UI designer and can work on it without issues. If you come with references or a clear visual direction, even better. If you need the full design process from scratch, we include it in the proposal.",
  },
  {
    q: "What do I need to get started?",
    a: "To be clear on the problem and who the product is for. You do not need to arrive with a PRD (product requirements document: the detailed list of features, flows, and business rules that defines what the software should do). We build that together in the proposal.",
  },
  {
    q: "Do you work with teams or only founders?",
    a: "Both. I can lead the full development as sole dev or join an existing team as backend, API, or security support.",
  },
];

const serviceLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site}/en/services#service`,
  name: "Valentina Ramirez: Full Stack Development",
  description: pageDescription,
  url: `${site}/en/services/`,
  provider: { "@id": `${site}/#person` },
  areaServed: "Worldwide",
  serviceType: services.map((s) => s.title),
  priceRange: "COP 2.000.000 — USD 500+",
});

const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://wavival.dev/en/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Services",
      item: "https://wavival.dev/en/services/",
    },
  ],
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://wavival.dev/servicios/" },
    { hreflang: "en", href: "https://wavival.dev/en/services/" },
    { hreflang: "x-default", href: "https://wavival.dev/servicios/" },
  ]}
>
  <section class="section">
    <p class="section-subtitle">How I can help</p>
    <h1 class="section-title">I build the product your business needs</h1>
    <p class="text-[var(--text-muted)] leading-relaxed max-w-3xl mt-4">
      I am a Full Stack Developer: I take a business problem and deliver it as real software in
      production. Solid backend, functional frontend, applied AI, and security by design, without
      depending on three different providers.
    </p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        services.map((s, index) => {
          const spanClass = s.featured || s.specialty ? "col-span-1 md:col-span-2" : "col-span-1";
          const headingSize = s.featured || s.specialty ? "text-2xl" : "text-xl";
          return (
            <article
              class={`card flex flex-col gap-3 ${spanClass}`}
              style={
                s.specialty
                  ? "background-color: var(--bg-blur); border-color: var(--brand-blue);"
                  : ""
              }
              data-aos="fade-up"
              data-aos-delay={index * 80}
            >
              {s.specialty && (
                <p class="text-[var(--brand-blue-text)] font-semibold text-xs uppercase tracking-widest">
                  Specialty
                </p>
              )}
              <h2 class={`font-display font-bold ${headingSize} text-[var(--text-primary)]`}>
                {s.title}
              </h2>
              <p class="text-sm text-[var(--text-muted)] leading-relaxed">{s.body}</p>
              <div class="flex flex-wrap gap-2 mt-1">
                {s.tools.map((t) => (
                  <span class="chip !text-[var(--text-primary)]">{t}</span>
                ))}
              </div>
              <p class="text-xs text-[var(--text-muted)] mt-1">
                Estimated timeline:
                <span class="font-display font-semibold text-[var(--brand-blue-text)]">
                  {" "}
                  {s.timeline}
                </span>
              </p>
              {s.examples && (
                <div class="flex flex-col gap-2 pt-3 border-t border-[var(--border-base)]">
                  <p class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
                    Examples of this service
                  </p>
                  <ul class="flex flex-col gap-1">
                    {s.examples.map((ex) => (
                      <li>
                        <a
                          href={ex.href}
                          class="text-xs text-[var(--text-muted)] hover:text-[var(--brand-blue-text)] transition-colors duration-200"
                        >
                          <span class="font-display font-semibold text-[var(--brand-blue-text)]">
                            {ex.name}:
                          </span>{" "}
                          {ex.description}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          );
        })
      }
    </div>

    <div
      class="mt-16 rounded-2xl border border-[var(--border-base)] p-8 grid grid-cols-1 md:grid-cols-2 gap-8"
      data-aos="fade-up"
    >
      <div class="flex flex-col gap-4">
        <h3
          class="font-display font-bold text-sm uppercase tracking-widest text-[var(--text-primary)]"
        >
          I work best with
        </h3>
        <ul class="flex flex-col gap-2 text-sm text-[var(--text-muted)] leading-relaxed">
          {
            fit.yes.map((item) => (
              <li class="flex gap-2 items-start">
                <span class="text-[var(--brand-blue)] font-bold mt-0.5 shrink-0" aria-hidden="true">
                  ·
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="flex flex-col gap-4 border-t md:border-t-0 md:border-l border-[var(--border-base)] md:pl-8 pt-6 md:pt-0"
      >
        <h3
          class="font-display font-bold text-sm uppercase tracking-widest text-[var(--text-muted)]"
        >
          Not the right fit if
        </h3>
        <ul class="flex flex-col gap-2 text-sm text-[var(--text-muted)] leading-relaxed">
          {
            fit.no.map((item) => (
              <li class="flex gap-2 items-start">
                <span class="font-bold mt-0.5 shrink-0" aria-hidden="true">
                  ·
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <h2 class="section-title mt-20">How I work</h2>
    <div class="relative mt-10">
      <div
        class="hidden md:block absolute h-px"
        style="top: 44px; left: 12.5%; right: 12.5%; background-color: var(--border-base);"
        aria-hidden="true"
      >
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-4 gap-0 md:gap-4" role="list">
        {
          process.map((p, i) => (
            <li
              class="flex flex-col gap-3 px-6 py-6 relative border-l-2 md:border-l-0 border-[var(--border-base)]"
              data-aos="fade-up"
              data-aos-delay={i * 80}
            >
              <span class="font-display font-bold text-sm w-10 h-10 rounded-full flex items-center justify-center bg-[var(--bg-card)] border-2 border-[var(--brand-blue)] text-[var(--brand-blue-text)] relative z-10 md:mx-auto mb-2 shrink-0">
                {p.step}
              </span>
              <h3 class="font-display font-bold text-base text-[var(--text-primary)] md:text-center">
                {p.title}
              </h3>
              <p class="text-sm text-[var(--text-muted)] leading-relaxed md:text-center">
                {p.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <h2 class="section-title mt-20">Frequently asked questions</h2>
    <div class="mt-6 flex flex-col gap-4">
      {
        faqs.map((f, i) => (
          <div
            class="rounded-2xl border border-[var(--border-base)] px-6 py-5 flex flex-col gap-2 transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={i * 60}
          >
            <h3 class="font-display font-semibold text-base text-[var(--text-primary)]">{f.q}</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <Contact lang="en" showServicesLink={false} />

  <script is:inline type="application/ld+json" set:html={serviceLd} />
  <script is:inline type="application/ld+json" set:html={faqLd} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

---
import { siteRoutes } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import ServiceRow from "@/components/organisms/ServiceRow.astro";
import ServicesDetail from "@/components/organisms/ServicesDetail.astro";
import ContactBand from "@/components/organisms/ContactBand.astro";

const base = import.meta.env.BASE_URL;
const r = siteRoutes("en", base);
const site = "https://www.wavival.dev";

const pageTitle = "Services: Custom Full Stack Development | Valentina Ramirez";
const pageDescription =
  "Full Stack Developer freelance focused on backend and AI: custom web apps with Django, React, Next.js, and Supabase, AI integrations, and security by design.";

interface ServiceExample {
  name: string;
  description: string;
  href: string;
}

interface Service {
  id: string;
  title: string;
  body: string;
  tools: string[];
  timeline: string;
  featured?: boolean;
  specialty?: boolean;
  examples?: ServiceExample[];
}

const labels = {
  specialty: "Specialty",
  duration: "Estimated timeline",
  tools: "Tools",
  examples: "Examples",
  quote: "Request a quote",
};

const services: Service[] = [
  {
    id: "custom-web-applications",
    title: "Custom web applications",
    body: "Complete product end to end: Django + DRF or Next.js with Supabase, React + TypeScript interfaces, and deployment. For founders who need something real, not a demo.",
    tools: ["Django", "DRF", "Next.js", "Supabase", "React", "TypeScript", "PostgreSQL"],
    timeline: "8 to 14 weeks",
    featured: true,
    examples: [
      {
        name: "TerraCore",
        description: "multi-tenancy agri-industrial platform",
        href: r.project("terracore"),
      },
      {
        name: "OKroot",
        description: "offline-first food health PWA",
        href: r.project("okroot"),
      },
    ],
  },
  {
    id: "rest-apis-backend",
    title: "REST APIs and backend",
    body: "I design and build clean, authenticated, and documented APIs. Relational modeling, role-based access control, multitenancy, and complex business logic that holds up as you grow.",
    tools: ["Django REST Framework", "JWT", "PostgreSQL", "Multitenancy"],
    timeline: "3 to 6 weeks",
    examples: [
      {
        name: "NullBreach",
        description: "Next.js OWASP analysis application",
        href: r.project("nullbreach"),
      },
    ],
  },
  {
    id: "security-appsec",
    title: "Security and AppSec",
    body: "I review applications with OWASP Top 10 criteria and a pentester mindset. Security integrated from the design: authentication, secrets handling, validation, and protected endpoints.",
    tools: ["OWASP", "AppSec", "PTES", "MITRE ATT&CK"],
    timeline: "1 to 2 weeks",
    examples: [
      {
        name: "Forgotten Portal",
        description: "offensive pentesting on DockerLabs",
        href: r.project("forgotten-portal"),
      },
    ],
  },
  {
    id: "ai-integrations",
    title: "AI integrations",
    body: "I integrate OpenAI, OpenClaw, and Claude API in LLM workflows where they add value: analysis, context-aware assistance, and automation. AI as the product's co-pilot, not decoration.",
    tools: ["OpenAI", "OpenClaw", "Claude API", "LLM Workflows", "n8n", "Prompt Engineering"],
    timeline: "2 to 4 weeks",
    specialty: true,
    examples: [
      {
        name: "OKroot",
        description: "label scanner with Claude API",
        href: r.project("okroot"),
      },
      {
        name: "NullBreach",
        description: "OWASP analysis and security chat with per-user history",
        href: r.project("nullbreach"),
      },
    ],
  },
];

const fit = {
  yes: [
    "Founders with a real product who need speed",
    "Teams that need API and frontend in one contract",
    "Startups that value security by design",
  ],
  no: [
    "The project is only design or static mockups",
    "You need someone available in office 9-5",
    "You are looking for the lowest price, not the best result",
  ],
};

const process = [
  {
    step: "01",
    title: "Conversation",
    body: "I understand the business problem before talking technology. What you need, for whom, and why.",
  },
  {
    step: "02",
    title: "Proposal",
    body: "I define scope, architecture, and deliverables. No surprises: you know what is being built and in what order.",
  },
  {
    step: "03",
    title: "Iterative build",
    body: "I build in visible deliveries. You see real progress, not weeks of silence followed by a big bang.",
  },
  {
    step: "04",
    title: "Delivery",
    body: "Product in production, documented and maintainable. Built to last beyond the first release.",
  },
];

const faqs = [
  {
    q: "Do you handle design?",
    a: "Yes, I am a UX/UI designer and can work on it without issues. If you come with references or a clear visual direction, even better. If you need the full design process from scratch, we include it in the proposal.",
  },
  {
    q: "What do I need to get started?",
    a: "To be clear on the problem and who the product is for. You do not need to arrive with a PRD (product requirements document: the detailed list of features, flows, and business rules that defines what the software should do). We build that together in the proposal.",
  },
  {
    q: "Do you work with teams or only founders?",
    a: "Both. I can lead the full development as sole dev or join an existing team as backend, API, or security support.",
  },
];

const serviceLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site}/en/services/#service`,
  name: "Valentina Ramirez: Full Stack Development",
  description: pageDescription,
  url: `${site}/en/services/`,
  provider: { "@id": `${site}/#person` },
  areaServed: "Worldwide",
  serviceType: services.map((s) => s.title),
  priceRange: "USD 250+ / COP 1.000.000+",
});

const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.wavival.dev/en/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Services",
      item: "https://www.wavival.dev/en/services/",
    },
  ],
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/servicios/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/services/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/servicios/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="How I can help" size="page">
      <Fragment slot="title">I build the product your business needs</Fragment>
      <p class="body-lg m-0">
        I am a Full Stack Developer focused on backend and AI: I take a business problem and deliver
        it as real software in production. Solid backend, functional frontend, applied AI, and
        security by design, without depending on three different providers.
      </p>
    </PageIntro>

    <div class="mt-[72px] border-t border-ink">
      {
        services.map((s, i) => (
          <ServiceRow
            index={String(i + 1).padStart(2, "0")}
            title={s.title}
            body={s.body}
            tools={s.tools}
            timeline={s.timeline}
            specialty={s.specialty}
            examples={s.examples}
            quoteHref={`${r.quote}?service=${s.id}`}
            labels={labels}
          />
        ))
      }
    </div>

    <ServicesDetail
      fit={{
        ...fit,
        yesTitle: "I work best with",
        noTitle: "Not the right fit if",
        yesMark: "YES",
        noMark: "NO",
      }}
      processLabel="Process"
      processTitle="How I work"
      process={process}
      faqTitle="Frequently asked questions"
      faqs={faqs}
    />
  </section>

  <ContactBand lang="en" showServicesLink={false} />

  <script is:inline type="application/ld+json" set:html={serviceLd} />
  <script is:inline type="application/ld+json" set:html={faqLd} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

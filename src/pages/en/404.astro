---
import Layout from "@/layouts/Layout.astro";
import NotFound from "@/components/organisms/NotFound.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="404: Page not found"
  lang="en"
  noindex={true}
  description="This page doesn't exist. Either it moved or it was never here. Head back to the homepage."
>
  <NotFound
    title="This page doesn't exist."
    text="Either we moved it, or it was never here. Either way, we can take you back."
    homeHref={`${base}en`}
    homeLabel="Back to home"
  />
</Layout>

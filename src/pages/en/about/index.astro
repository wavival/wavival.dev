---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import Bento from "@/components/molecules/Bento.astro";
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import PullQuote from "@/components/molecules/PullQuote.astro";
import SocialLinks from "@/components/molecules/SocialLinks.astro";
import Button from "@/components/atoms/Button.astro";
import { siteRoutes } from "@/i18n/utils";
import { SOCIAL_PROFILES } from "@/data/social";

const base = import.meta.env.BASE_URL;
const lang = "en";
const r = siteRoutes(lang, base);

const summary = [
  { value: "Software and marketing", label: "Apps in production and content that sells" },
  { value: "Lúmina\u00a0W", label: "Founder, custom product" },
  { value: "Self-taught student", label: "Continuous learning, no shortcuts" },
];

const method = [
  {
    title: "The problem first",
    body: "Before opening the editor I want to know who will use this, what decision they need to make, and what happens when the data does not arrive. The framework comes after.",
  },
  {
    title: "Understanding the why",
    body: "Django and DRF for a solid foundation, React, TypeScript, and Next.js for interfaces and apps that do not feel fragile, PostgreSQL when the relational model matters. Every choice with a reason.",
  },
  {
    title: "Security and AI from the start",
    body: "They are not decorations glued on at the end: they are part of the design from the first endpoint, not when something has already broken in production.",
  },
];
// Equal columns: the three method steps weigh the same.
const methodStyles = method.map(() => "--span:4");

const education = [{ name: "U. de San Buenaventura", detail: "English Language" }];

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.wavival.dev/en/" },
    { "@type": "ListItem", position: 2, name: "About", item: "https://www.wavival.dev/en/about/" },
  ],
});
---

<Layout
  title="About me | Valentina Ramírez"
  description="Self-taught software developer and digital strategist, founder of Lúmina W. Outside the code: drums, cooking, music and reading."
  lang="en"
  preloadHero
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/sobre-mi/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/about/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/sobre-mi/" },
  ]}
>
  <section class="wrap page-top pb-sec">
    <PageIntro eyebrow="Who's behind the code" size="about">
      <Fragment slot="title">About me</Fragment>
    </PageIntro>

    <div
      class="mt-14 flex flex-col gap-x-[clamp(32px,5vw,80px)] gap-y-10 min-[900px]:flex-row min-[900px]:items-start"
    >
      <div class="flex min-w-0 flex-col gap-7 min-[900px]:flex-[1_1_480px]">
        <p
          class="h-title m-0"
          style="font-size:clamp(24px,2.6vw,36px);line-height:1.2;letter-spacing:-0.02em;text-wrap:pretty"
        >
          I'm Valentina Ramírez. I build products end to end, from the data model to the interface
          people use, and I founded <span class="accent">Lúmina&nbsp;W</span> to do it on my own terms.
        </p>
        <ChipList
          loose
          label="Focus areas"
          items={[
            "Django · DRF",
            "React · TypeScript",
            "AI",
            "Security",
            "Digital marketing",
            "Content creation",
            "Social selling",
          ]}
        />
        <p class="m-0 max-w-[640px] text-[17px] leading-[1.75] text-muted text-pretty">
          I came to code without a mapped-out path and learned it by building. That self-taught
          route left me with a concrete way of working: it is not enough for something to work: I
          need to understand why it works. That is the difference between copying a solution and
          being able to keep it running when it breaks at 2 a.m.
        </p>
        <p
          class="m-0 max-w-[640px] text-[17px] leading-[1.75] text-muted text-pretty"
          data-about-marketing
        >
          Beyond code, I know how to sell on social media. I design digital strategies for Instagram
          and TikTok, I trained in digital marketing, and I understand how a post turns into a
          message, and a message into a client. So when I build a landing page or automate a
          conversation, I don't only think about the software: I think about how you will sell with
          it.
        </p>
      </div>
      <figure
        class="m-0 mx-auto w-full max-w-[360px] min-[900px]:mx-0 min-[900px]:flex-[0_1_360px]"
      >
        <div class="photo-frame">
          <img
            src={`${base}images/profile.webp`}
            alt="Profile photo of Valentina Ramírez"
            decoding="async"
            fetchpriority="high"
            width="320"
            height="400"
          />
        </div>
      </figure>
    </div>

    <dl
      aria-label="Summary"
      class="section-gap grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] border-t border-ink border-b border-b-line"
    >
      {
        summary.map((s) => (
          <div class="flex flex-col justify-center py-10 pr-6 min-[900px]:items-center min-[900px]:px-6 min-[900px]:text-center">
            <dt
              class="h-title leading-none"
              style="font-size:clamp(32px,3.4vw,48px);letter-spacing:-0.03em;color:var(--blue)"
            >
              {s.value}
            </dt>
            <dd class="m-0 mt-[10px] text-sm text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>

    <SectionHeader label="Method" title="How I work" class="section-gap mb-10" />
    <Bento cells>
      {
        method.map((m, i) => (
          <div class="px-7 py-8" style={methodStyles[i]}>
            <span class="index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h-title m-0 mt-4 text-2xl leading-[1.15]">{m.title}</h3>
            <p class="m-0 mt-3 text-[15px] leading-[1.7] text-muted text-pretty">{m.body}</p>
          </div>
        ))
      }
    </Bento>

    <div
      class="section-gap flex flex-wrap items-end gap-x-16 gap-y-6 border border-line bg-surface p-[clamp(32px,4vw,64px)]"
    >
      <div class="flex-[1_1_480px]">
        <h2 class="h2-sub m-0">What I build</h2>
        <p class="body-md m-0 mt-5 max-w-[760px]">
          Real applications, not demos, and the way to get them to the people who need them. From an
          offline-first agri-industrial SaaS to OWASP code analysis, I am drawn to software that
          solves a measurable problem for a real person, and to the content that brings that person
          to it. Through wavival, I bring that idea to clients: a custom product, built to last and
          to sell, not to impress in a screenshot.
        </p>
      </div>
      <Button href={r.projects} variant="secondary" aria-label="View Valentina Ramírez's projects">
        View projects
      </Button>
    </div>

    <div
      class="section-gap grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-x-12 gap-y-12"
    >
      <div data-parallel-education>
        <h3 class="h-title m-0 mb-2 text-[28px] tracking-[-0.02em]">Ongoing education</h3>
        {
          education.map((e) => (
            <div class="flex justify-between gap-4 border-b border-line py-[18px]">
              <span class="h-title">{e.name}</span>
              <span class="text-right text-sm text-muted">{e.detail}</span>
            </div>
          ))
        }
        <div class="flex justify-between gap-4 border-b border-line py-[18px]">
          <span class="h-title">Platzi</span>
          <span class="max-w-[300px] text-right text-sm text-muted">
            Self-taught training in Web Development, Artificial Intelligence, and Information
            Security
          </span>
        </div>
        <div
          class="flex justify-between gap-4 border-b border-line py-[18px]"
          data-marketing-training
        >
          <span class="h-title">Marketing and content</span>
          <span class="max-w-[300px] text-right text-sm text-muted">
            Marketing and social media at Platzi, self-taught learning and hands-on practice as a
            digital strategist on Instagram and TikTok
          </span>
        </div>
      </div>
      <div>
        <h3 class="h-title m-0 mb-5 text-[28px] tracking-[-0.02em]">Outside the code</h3>
        <p class="body m-0 text-pretty">
          What I enjoy most also teaches me how to work: drums gave me structure and rhythm, cooking
          taught me to follow a process and improvise when needed, and music and reading keep my
          curiosity alive. Learning does not turn off when I close the laptop: it is the way I live
          inside and outside of code.
        </p>
        <ChipList
          loose
          class="mt-5"
          label="Interests outside the code"
          items={["Drums", "Cooking", "Music", "Reading"]}
        />
      </div>
    </div>

    <PullQuote class="section-gap border-t border-line pt-16 min-[900px]:text-center">
      "Learning is not a stage that ends: it is the way I work. Every project leaves me knowing
      something I did not know when I started."
    </PullQuote>

    <div class="mt-14 flex flex-wrap items-center gap-3 min-[900px]:justify-center">
      <Button
        href={SOCIAL_PROFILES["blog-w"].href}
        target="_blank"
        variant="secondary"
        aria-label={SOCIAL_PROFILES["blog-w"].label[lang]}
      >
        Read Blog W
      </Button>
      <SocialLinks
        lang={lang}
        size="lg"
        networks={["instagram", "tiktok", "linkedin", "github", "platzi"]}
      />
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

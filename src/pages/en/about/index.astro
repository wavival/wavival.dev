---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import Bento from "@/components/molecules/Bento.astro";
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import PullQuote from "@/components/molecules/PullQuote.astro";
import SocialLinks from "@/components/molecules/SocialLinks.astro";
import Button from "@/components/atoms/Button.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import ContactBand from "@/components/organisms/ContactBand.astro";
import { cvHref, siteRoutes } from "@/i18n/utils";
import { bentoStyles } from "@/utils/bento";

const base = import.meta.env.BASE_URL;
const lang = "en";
const r = siteRoutes(lang, base);
const cv = cvHref(lang, base);
const cvFile = cv.slice(base.length);

const summary = [
  { value: "Full Stack", label: "Django · React, in production" },
  { value: "Lumina W", label: "Founder, custom product" },
  { value: "Self-taught", label: "Continuous learning, no shortcuts" },
];

const method = [
  {
    title: "The problem first",
    body: "Before opening the editor I want to know who will use this, what decision they need to make, and what happens when the data does not arrive. The framework comes after.",
  },
  {
    title: "Understanding the why",
    body: "Django and DRF for a solid foundation, React, TypeScript, and Next.js for interfaces and apps that do not feel fragile, PostgreSQL when the relational model matters. Every choice with a reason.",
  },
  {
    title: "Security and AI from the start",
    body: "They are not decorations glued on at the end: they enter the design from the first endpoint, not when something has already broken in production.",
  },
];
const methodStyles = bentoStyles(method.length);

const education = [
  { name: "SENA", detail: "Software Analysis and Development" },
  { name: "U. de San Buenaventura", detail: "English Language" },
];

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.wavival.dev/en/" },
    { "@type": "ListItem", position: 2, name: "About", item: "https://www.wavival.dev/en/about/" },
  ],
});
---

<Layout
  title="About me | Valentina Ramirez"
  description="Self-taught Full Stack Developer, founder of Lumina W. Experience with Django, React, and Next.js, building real products through continuous learning."
  lang="en"
  preloadHero
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/sobre-mi/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/about/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/sobre-mi/" },
  ]}
>
  <section class="wrap page-top pb-sec">
    <PageIntro eyebrow="Who's behind the code" size="about">
      <Fragment slot="title">About me</Fragment>
    </PageIntro>

    <div class="mt-14 flex flex-wrap items-start gap-x-[clamp(32px,5vw,80px)] gap-y-10">
      <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-7">
        <p
          class="h-title m-0"
          style="font-size:clamp(24px,2.6vw,36px);line-height:1.2;letter-spacing:-0.02em;text-wrap:pretty"
        >
          I'm Valentina Ramirez. I build products end to end, from the data model to the interface
          people use, and I founded <span class="accent">Lumina W</span> to do it on my own terms.
        </p>
        <ChipList
          loose
          label="Focus areas"
          items={["Django · DRF", "React · TypeScript", "Next.js", "PostgreSQL", "AI", "Security"]}
        />
        <p class="m-0 max-w-[640px] text-[17px] leading-[1.75] text-muted [text-wrap:pretty]">
          I came to code without a laid-out path and learned it by building. That self-taught route
          left me with a concrete way of working: I am not satisfied with something that works, I
          need to understand why it works. That is the difference between copying a solution and
          being able to sustain it when it breaks at 2am.
        </p>
      </div>
      <figure class="m-0 min-w-[240px] flex-[0_1_360px]">
        <div class="photo-frame">
          <img
            src={`${base}images/profile.webp`}
            alt="Profile photo of Valentina Ramirez"
            decoding="async"
            fetchpriority="high"
            width="320"
            height="320"
          />
        </div>
      </figure>
    </div>

    <dl
      aria-label="Summary"
      class="section-gap grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] border-t border-ink border-b border-b-line"
    >
      {
        summary.map((s) => (
          <div class="flex flex-col justify-center py-10 pr-6">
            <dt
              class="h-title leading-none"
              style="font-size:clamp(32px,3.4vw,48px);letter-spacing:-0.03em;color:var(--blue)"
            >
              {s.value}
            </dt>
            <dd class="m-0 mt-[10px] text-sm text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>

    <SectionHeader label="Method" title="How I work" class="section-gap mb-10" />
    <Bento cells>
      {
        method.map((m, i) => (
          <div class="px-7 py-8" style={methodStyles[i]}>
            <span class="index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h-title m-0 mt-4 text-2xl leading-[1.15]">{m.title}</h3>
            <p class="m-0 mt-3 text-[15px] leading-[1.7] text-muted [text-wrap:pretty]">{m.body}</p>
          </div>
        ))
      }
    </Bento>

    <div
      class="section-gap flex flex-wrap items-end gap-x-16 gap-y-6 border border-line bg-surface p-[clamp(32px,4vw,64px)]"
    >
      <div class="flex-[1_1_480px]">
        <h2 class="h2-sub m-0">What I build</h2>
        <p class="body-md m-0 mt-5 max-w-[760px]">
          Real applications, not demos: multi-user systems with complex business logic, custom APIs,
          and products that live in production. From an offline-first agro-industrial SaaS to OWASP
          code analysis, I am drawn to software that solves a measurable problem for a real person.
          Through Lumina W I bring that same idea to clients: a custom product, built to last and
          not to impress in a screenshot.
        </p>
      </div>
      <Button href={r.projects} variant="secondary" aria-label="See Valentina Ramirez's projects">
        See projects
      </Button>
    </div>

    <div
      class="section-gap grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-x-12 gap-y-12"
    >
      <div>
        <h3 class="h-title m-0 mb-2 text-[28px] tracking-[-0.02em]">Parallel education</h3>
        {
          education.map((e) => (
            <div class="flex justify-between gap-4 border-b border-line py-[18px]">
              <span class="h-title">{e.name}</span>
              <span class="text-right text-sm text-muted">{e.detail}</span>
            </div>
          ))
        }
        <div class="flex justify-between gap-4 border-b border-line py-[18px]">
          <span class="h-title">Platzi</span>
          <span class="max-w-[300px] text-right text-sm text-muted">
            Self-taught training in Web Development, Artificial Intelligence, and Information
            Security
            <br />
            <TextLink
              href="https://platzi.com/p/wavival"
              target="_blank"
              class="mt-2"
              aria-label="Valentina Ramirez's Platzi profile"
            >
              My Platzi profile
            </TextLink>
          </span>
        </div>
      </div>
      <div>
        <h3 class="h-title m-0 mb-5 text-[28px] tracking-[-0.02em]">Outside the code</h3>
        <p class="body m-0 [text-wrap:pretty]">
          What I enjoy most also teaches me how to work: drums gave me structure and rhythm, cooking
          taught me to follow a process and improvise when needed, and music and reading keep my
          curiosity alive. Learning does not turn off when I close the laptop: it is the way I live
          inside and outside of code.
        </p>
        <ChipList
          loose
          class="mt-5"
          label="Interests outside the code"
          items={["Drums", "Cooking", "Music", "Reading"]}
        />
      </div>
    </div>

    <PullQuote class="section-gap border-t border-line pt-10">
      "Learning is not a stage that ends: it is the way I work. Every project leaves me knowing
      something I did not know when I started."
      <footer slot="footer" class="mt-5 text-sm text-muted">
        Author of the <TextLink
          href="https://blog.luminaw.co/"
          target="_blank"
          variant="inline"
          aria-label="Lumina W blog written by Valentina Ramirez"
        >
          Blog W
        </TextLink>, where I write what I learn.
      </footer>
    </PullQuote>

    <div class="mt-14 flex flex-wrap items-center gap-3">
      <Button
        href={cv}
        download={cvFile}
        icon="download-cv-white"
        data-umami-event="cv-descarga-en"
        aria-label="Download Valentina Ramirez's CV as PDF"
      >
        Download CV
      </Button>
      <SocialLinks lang={lang} size="lg" items={["linkedin", "github", "instagram", "whatsapp"]} />
    </div>
  </section>

  <ContactBand lang={lang} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

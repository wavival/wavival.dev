---
import Layout from "@/layouts/Layout.astro";
import Projects from "@/components/sections/Projects.astro";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://wavival.dev/" },
    { "@type": "ListItem", position: 2, name: "Proyectos", item: "https://wavival.dev/proyectos/" },
  ],
});
---

<Layout
  title="Proyectos & Laboratorio | Valentina Ramírez"
  description="Productos que he construido: SaaS agroindustrial, PWAs y análisis de seguridad con IA. Django, React, Next.js, PostgreSQL y más."
  alternates={[
    { hreflang: "es", href: "https://wavival.dev/proyectos/" },
    { hreflang: "en", href: "https://wavival.dev/en/projects/" },
    { hreflang: "x-default", href: "https://wavival.dev/proyectos/" },
  ]}
>
  <Projects heading="h1" />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

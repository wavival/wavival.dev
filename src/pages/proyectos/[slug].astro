---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/ui/Link.astro";
import Contact from "@/components/sections/Contact.astro";
import { caseStudies, type Project } from "@/data/projects";

export function getStaticPaths() {
  return caseStudies.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = "https://www.wavival.dev";

const tagStyles: Record<string, string> = {
  green: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400",
  blue: "bg-blue-100 text-blue-900 dark:bg-blue-900/30 dark:text-blue-300",
  orange: "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
  gray: "bg-[var(--bg-blur)] text-[var(--text-muted)]",
};

const pageTitle = `${project.title}: Caso de estudio | Valentina Ramírez`;
const pageURL = `${site}${base}proyectos/${project.slug}/`;
const siteLink = project.links.find((l) => l.text === "Ver sitio" || l.text === "Ver app");
const otherLinks = project.links.filter((l) => l.text !== "Ver sitio");

const order = [
  "problema",
  project.architecture && "arquitectura",
  project.decisions && "decisiones",
  project.results && "resultados",
  project.learnings && "aprendizajes",
].filter(Boolean) as string[];
const num = (id: string) => String(order.indexOf(id) + 1).padStart(2, "0");

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "Proyectos", item: `${site}${base}proyectos/` },
    { "@type": "ListItem", position: 3, name: project.title, item: pageURL },
  ],
});

const schemaType = project.schemaType ?? "SoftwareApplication";
const buildDate = new Date().toISOString().slice(0, 10);
const datePublished = project.datePublished ?? buildDate;
const dateModified = project.dateModified ?? datePublished;
const toIsoDateTime = (d: string) => (d.length === 10 ? `${d}T00:00:00-05:00` : d);
const fmtDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("es-CO", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
const dateLabel =
  datePublished !== dateModified
    ? `Publicado: ${fmtDate(datePublished)} · Actualizado: ${fmtDate(dateModified)}`
    : `Actualizado: ${fmtDate(dateModified)}`;

const firstSentence = (s: string) => {
  const i = s.indexOf(". ");
  return i === -1 ? s : s.slice(0, i + 1);
};
const summary = project.summary ?? firstSentence(project.solution);

const projectLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": schemaType,
  "@id": `${pageURL}#project`,
  name: project.title,
  description: project.metaDescription ?? project.solution,
  url: pageURL,
  author: { "@id": `${site}/#person` },
  datePublished: toIsoDateTime(datePublished),
  dateModified: toIsoDateTime(dateModified),
  ...(schemaType === "SoftwareApplication"
    ? {
        applicationCategory: project.appCategory ?? "WebApplication",
        operatingSystem: "Web",
        ...(project.programmingLanguage
          ? { programmingLanguage: project.programmingLanguage }
          : {}),
        softwareRequirements: project.stack.join(", "),
      }
    : {}),
});

const headerCls = "flex items-baseline gap-4 mb-7";
const numCls =
  "font-display font-bold text-2xl md:text-3xl leading-none tabular-nums text-[var(--brand-blue)]/40 dark:text-[var(--brand-blue)]/50";
const titleCls = "font-display font-bold text-2xl md:text-3xl text-[var(--text-primary)]";

const idx = caseStudies.findIndex((p) => p.slug === project.slug);
const prevProject = idx > 0 ? caseStudies[idx - 1] : null;
const nextProject = idx < caseStudies.length - 1 ? caseStudies[idx + 1] : null;
---

<Layout
  title={pageTitle}
  description={project.metaDescription ?? project.solution}
  ogImage={project.image ? `/${project.image}` : undefined}
  ogImageAlt={project.imageAlt}
  ogType="article"
  ogPublishedTime={toIsoDateTime(datePublished)}
  ogModifiedTime={toIsoDateTime(dateModified)}
  alternates={[
    { hreflang: "es", href: `https://www.wavival.dev/proyectos/${project.slug}/` },
    { hreflang: "en", href: `https://www.wavival.dev/en/projects/${project.slug}/` },
    { hreflang: "x-default", href: `https://www.wavival.dev/proyectos/${project.slug}/` },
  ]}
>
  <!-- HERO (full-bleed, centered) -->
  <section
    class="w-full border-b border-[var(--border-base)] bg-gradient-to-b from-[var(--bg-blur)] to-[var(--bg-page)]"
  >
    <div class="section !py-16 md:!py-24 flex flex-col items-center text-center gap-6">
      <Link
        href={`${base}proyectos`}
        class="!text-xs self-center"
        aria-label="Volver a todos los proyectos"
      >
        Proyectos
      </Link>

      <span
        class={`text-xs font-semibold px-3 py-1 rounded-full ${tagStyles[project.tagColor]}`}
        data-aos="fade-up"
      >
        {project.tag}
      </span>

      <h1
        class="font-display font-bold text-4xl md:text-6xl leading-[1.1] text-[var(--text-primary)] max-w-5xl"
        data-aos="fade-up"
      >
        {project.title}
      </h1>

      <p
        class="text-[var(--text-muted)] text-base md:text-lg leading-relaxed max-w-3xl"
        data-aos="fade-up"
      >
        {project.solution}
      </p>

      <p class="text-xs text-[var(--text-muted)]">
        Por <a
          href={`${base}sobre-mi`}
          class="underline hover:text-[var(--brand-blue-text)] transition-colors"
          >Valentina Ramírez</a
        > · {dateLabel}
      </p>

      {
        (siteLink || otherLinks.length > 0) && (
          <div class="flex flex-wrap items-center justify-center gap-5 mt-1" data-aos="fade-up">
            {siteLink && (
              <Link
                href={siteLink.href}
                target="_blank"
                aria-label={siteLink.ariaLabel}
                data-umami-event={siteLink.event}
              >
                {siteLink.text}
              </Link>
            )}
            {otherLinks.map((l) => (
              <Link
                href={l.href}
                target="_blank"
                aria-label={l.ariaLabel}
                data-umami-event={l.event}
              >
                {l.text}
              </Link>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- CONTENT -->
  <div class="w-full max-w-5xl mx-auto px-6 pt-16 pb-24 flex flex-col gap-20">
    <!-- Resumen (TL;DR) -->
    <div
      class="rounded-[var(--radius-md)] border border-[var(--border-base)] bg-[var(--bg-blur)] p-6"
      data-aos="fade-up"
    >
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)] mb-2">
        Resumen
      </p>
      <p class="text-[var(--text-muted)] leading-relaxed text-sm">{summary}</p>
    </div>

    <!-- Stack -->
    <div class="flex flex-col gap-2 items-center" data-aos="fade-up">
      <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)]"
        >Stack</span
      >
      <div class="flex flex-wrap gap-1.5 justify-center">
        {project.stack.map((s) => <span class="chip !text-[var(--text-primary)]">{s}</span>)}
      </div>
    </div>

    <!-- El problema -->
    <section data-aos="fade-up">
      <header class={headerCls}>
        <span class={numCls}>{num("problema")}</span>
        <h2 class={titleCls}>El problema</h2>
      </header>
      <div
        class="rounded-[var(--radius-md)] border border-[var(--border-base)] border-l-4 border-l-[var(--brand-blue)] bg-[var(--bg-blur)] p-8"
      >
        <p class="text-[var(--text-muted)] leading-relaxed">{project.problem}</p>
      </div>
      {
        project.painPoints && (
          <div class="flex flex-wrap gap-4 mt-6">
            {project.painPoints.map((pp, i) => (
              <article
                class="card !min-h-0 flex flex-col gap-2 flex-1 basis-[220px]"
                data-aos="fade-up"
                data-aos-delay={i * 80}
              >
                <h3 class="font-display font-bold text-base text-[var(--text-primary)]">
                  {pp.title}
                </h3>
                <p class="text-sm text-[var(--text-muted)] leading-relaxed">{pp.text}</p>
              </article>
            ))}
          </div>
        )
      }
    </section>

    <!-- Que construi -->
    {
      project.architecture && (
        <section data-aos="fade-up">
          <header class={headerCls}>
            <span class={numCls}>{num("arquitectura")}</span>
            <h2 class={titleCls}>Qué construí</h2>
          </header>
          <ol class="grid sm:grid-cols-2 gap-x-8 gap-y-5">
            {project.architecture.map((a, i) => (
              <li class="flex gap-4 items-start">
                <span class="font-display font-bold text-lg text-[var(--brand-blue-text)] w-7 shrink-0 leading-none mt-1 tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <p class="text-[var(--text-muted)] leading-relaxed text-sm">{a}</p>
              </li>
            ))}
          </ol>
          {project.modules && (
            <div class="flex flex-wrap gap-4 mt-10">
              {project.modules.map((m, i) => (
                <article
                  class="card !min-h-0 flex flex-col gap-2 flex-1 basis-[220px]"
                  data-aos="fade-up"
                  data-aos-delay={i * 60}
                >
                  <h3 class="font-display font-bold text-base text-[var(--text-primary)]">
                    {m.name}
                  </h3>
                  <p class="text-sm text-[var(--text-muted)] leading-relaxed">{m.text}</p>
                </article>
              ))}
            </div>
          )}
          {project.chainSteps && (
            <div class="mt-8 rounded-[var(--radius-md)] border border-[var(--border-base)] border-l-4 border-l-[var(--brand-blue)] bg-[var(--bg-blur)] p-6">
              <h3 class="font-display font-bold text-base text-[var(--text-primary)]">
                {project.chainStepsTitle ?? "Ejemplo de cadena de acciones"}
              </h3>
              <ol class="mt-4 flex flex-col gap-2">
                {project.chainSteps.map((step) => (
                  <li class="flex items-start gap-3 text-sm text-[var(--text-muted)]">
                    <span class="text-[var(--brand-blue)] font-bold shrink-0" aria-hidden="true">
                      ·
                    </span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </section>
      )
    }

    <!-- Decisiones de arquitectura -->
    {
      project.decisions && (
        <section data-aos="fade-up">
          <header class={headerCls}>
            <span class={numCls}>{num("decisiones")}</span>
            <h2 class={titleCls}>Decisiones de arquitectura</h2>
          </header>
          <div class="flex flex-col gap-4">
            {project.decisions.map((d, i) => (
              <details
                class="card !min-h-0 group"
                data-accordion
                data-aos="fade-up"
                data-aos-delay={i * 60}
              >
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <h3 class="font-display font-bold text-lg text-[var(--text-primary)]">
                    {i + 1}. {d.title}
                  </h3>
                  <span
                    class="text-[var(--brand-blue)] text-2xl font-light leading-none shrink-0 transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <div data-acc-body class="overflow-hidden">
                  <dl class="mt-4 flex flex-col gap-3 text-sm leading-relaxed">
                    <div>
                      <dt class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)]">
                        Contexto
                      </dt>
                      <dd class="text-[var(--text-muted)] mt-1">{d.context}</dd>
                    </div>
                    <div>
                      <dt class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)]">
                        Trade-off
                      </dt>
                      <dd class="text-[var(--text-muted)] mt-1">{d.tradeoff}</dd>
                    </div>
                    <div>
                      <dt class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue-text)]">
                        Decisión
                      </dt>
                      <dd class="text-[var(--text-primary)] mt-1">{d.decision}</dd>
                    </div>
                  </dl>
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <!-- Resultados -->
    {
      project.results && (
        <section data-aos="fade-up">
          <header class={headerCls}>
            <span class={numCls}>{num("resultados")}</span>
            <h2 class={titleCls}>Resultados</h2>
          </header>
          <ul class="flex flex-col gap-3">
            {project.results.map((r) => (
              <li class="flex gap-4 items-start border-l-2 border-[var(--brand-blue)] pl-5 py-1">
                <p class="text-[var(--text-muted)] leading-relaxed text-sm">{r}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Aprendizajes -->
    {
      project.learnings && (
        <section data-aos="fade-up">
          <header class={headerCls}>
            <span class={numCls}>{num("aprendizajes")}</span>
            <h2 class={titleCls}>Aprendizajes</h2>
          </header>
          <ul class="flex flex-col gap-4">
            {project.learnings.map((l) => (
              <li class="flex gap-4 items-start border-l-2 border-[var(--border-base)] pl-5 py-1">
                <p class="text-[var(--text-muted)] leading-relaxed text-sm">{l}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <!-- Navegacion entre proyectos -->
  {
    (prevProject || nextProject) && (
      <nav
        aria-label="Navegacion entre proyectos"
        class="w-full border-t border-[var(--border-base)]"
      >
        <div class="section !py-10 flex justify-between gap-4">
          <div class="flex flex-col gap-1">
            {prevProject && (
              <>
                <span class="text-xs font-display font-bold uppercase tracking-widest text-[var(--text-muted)]">
                  Anterior
                </span>
                <Link
                  href={`${base}proyectos/${prevProject.slug}`}
                  aria-label={`Proyecto anterior: ${prevProject.title}`}
                >
                  {prevProject.title}
                </Link>
              </>
            )}
          </div>
          <div class="flex flex-col gap-1 items-end text-right">
            {nextProject && (
              <>
                <span class="text-xs font-display font-bold uppercase tracking-widest text-[var(--text-muted)]">
                  Siguiente
                </span>
                <Link
                  href={`${base}proyectos/${nextProject.slug}`}
                  aria-label={`Proyecto siguiente: ${nextProject.title}`}
                >
                  {nextProject.title}
                </Link>
              </>
            )}
          </div>
        </div>
      </nav>
    )
  }

  <!-- Contacto -->
  <Contact />

  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) {
      document.querySelectorAll<HTMLDetailsElement>("details[data-accordion]").forEach((detail) => {
        const summary = detail.querySelector("summary");
        const body = detail.querySelector<HTMLElement>("[data-acc-body]");
        if (!summary || !body) return;
        let currentAnim: Animation | null = null;

        summary.addEventListener("click", (e) => {
          e.preventDefault();
          if (currentAnim) currentAnim.cancel();
          const opening = !detail.open;
          if (opening) detail.open = true;
          const h = body.scrollHeight;
          const frames = [
            { height: "0px", opacity: 0 },
            { height: `${h}px`, opacity: 1 },
          ];
          const anim = body.animate(opening ? frames : [...frames].reverse(), {
            duration: opening ? 280 : 220,
            easing: "ease",
          });
          currentAnim = anim;
          anim.onfinish = () => {
            if (!opening) detail.open = false;
            currentAnim = null;
          };
        });
      });
    }
  </script>

  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
  <script is:inline type="application/ld+json" set:html={projectLd} />
</Layout>

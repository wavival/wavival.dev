---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/organisms/Hero.astro";
import FeaturedProjects from "@/components/organisms/FeaturedProjects.astro";
import StackSection from "@/components/organisms/StackSection.astro";
import AboutSection from "@/components/organisms/AboutSection.astro";
import ContactBand from "@/components/organisms/ContactBand.astro";
---

<Layout
  ogType="profile"
  preloadHero
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/" },
  ]}
>
  <Hero />
  <FeaturedProjects />
  <StackSection />
  <AboutSection />
  <ContactBand />
</Layout>

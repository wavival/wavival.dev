---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import Bento from "@/components/molecules/Bento.astro";
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import PullQuote from "@/components/molecules/PullQuote.astro";
import SocialLinks from "@/components/molecules/SocialLinks.astro";
import Button from "@/components/atoms/Button.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import ContactBand from "@/components/organisms/ContactBand.astro";
import { cvHref, siteRoutes } from "@/i18n/utils";
import { bentoStyles } from "@/utils/bento";

const base = import.meta.env.BASE_URL;
const lang = "es";
const r = siteRoutes(lang, base);
const cv = cvHref(lang, base);
const cvFile = cv.slice(base.length);

const summary = [
  { value: "Full Stack", label: "Django · React, en producción" },
  { value: "Lúmina W", label: "Fundadora, producto a medida" },
  { value: "Autodidacta", label: "Aprendizaje continuo, sin atajos" },
];

const method = [
  {
    title: "El problema primero",
    body: "Antes de abrir el editor quiero saber quién usará esto, qué decisión necesita tomar y qué pasa cuando los datos no llegan. El framework viene después.",
  },
  {
    title: "Entender el porqué",
    body: "Django y DRF para una base sólida, React, TypeScript y Next.js para interfaces y apps que no se sienten frágiles, PostgreSQL cuando el modelo relacional importa. Cada elección con un motivo.",
  },
  {
    title: "Seguridad e IA desde el diseño",
    body: "No son adornos que se pegan al final: entran en el diseño desde el primer endpoint, no cuando algo ya se rompió en producción.",
  },
];
const methodStyles = bentoStyles(method.length);

const education = [
  { name: "SENA", detail: "Análisis y Desarrollo de Software" },
  { name: "U. de San Buenaventura", detail: "Lengua Inglesa" },
];

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.wavival.dev/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Sobre mi",
      item: "https://www.wavival.dev/sobre-mi/",
    },
  ],
});
---

<Layout
  title="Sobre mí | Valentina Ramírez"
  description="Desarrolladora Full Stack autodidacta con enfoque en backend e IA, fundadora de Lúmina W. Experiencia con Django, React y Next.js. Más allá del código: fotografía y batería."
  preloadHero
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/sobre-mi/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/about/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/sobre-mi/" },
  ]}
>
  <section class="wrap page-top pb-sec">
    <PageIntro eyebrow="Quién está detrás del código" size="about">
      <Fragment slot="title">Sobre mí</Fragment>
    </PageIntro>

    <div
      class="mt-14 flex flex-col gap-x-[clamp(32px,5vw,80px)] gap-y-10 min-[900px]:flex-row min-[900px]:items-start"
    >
      <div class="flex min-w-0 flex-col gap-7 min-[900px]:flex-[1_1_480px]">
        <p
          class="h-title m-0"
          style="font-size:clamp(24px,2.6vw,36px);line-height:1.2;letter-spacing:-0.02em;text-wrap:pretty"
        >
          Soy Valentina Ramírez. Construyo productos de principio a fin, del modelo de datos a la
          interfaz que la gente usa, y fundé <span class="accent">Lúmina W</span> para hacerlo con criterio
          propio.
        </p>
        <ChipList
          loose
          label="Áreas de foco"
          items={["Django · DRF", "React · TypeScript", "Next.js", "PostgreSQL", "IA", "Seguridad"]}
        />
        <p class="m-0 max-w-[640px] text-[17px] leading-[1.75] text-muted [text-wrap:pretty]">
          Llegué al código sin un camino trazado y lo aprendí a fuerza de construir. Esa ruta
          autodidacta me dejó una forma de trabajar concreta: no me conformo con que algo funcione,
          necesito entender por qué funciona. Es la diferencia entre copiar una solución y poder
          sostenerla cuando se rompe a las dos de la mañana.
        </p>
      </div>
      <figure
        class="m-0 mx-auto w-full max-w-[360px] min-[900px]:mx-0 min-[900px]:flex-[0_1_360px]"
      >
        <div class="photo-frame">
          <img
            src={`${base}images/profile.webp`}
            alt="Foto de perfil de Valentina Ramírez"
            decoding="async"
            fetchpriority="high"
            width="320"
            height="320"
          />
        </div>
      </figure>
    </div>

    <dl
      aria-label="En resumen"
      class="section-gap grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] border-t border-ink border-b border-b-line"
    >
      {
        summary.map((s) => (
          <div class="flex flex-col justify-center py-10 pr-6 min-[900px]:items-center min-[900px]:px-6 min-[900px]:text-center">
            <dt
              class="h-title leading-none"
              style="font-size:clamp(32px,3.4vw,48px);letter-spacing:-0.03em;color:var(--blue)"
            >
              {s.value}
            </dt>
            <dd class="m-0 mt-[10px] text-sm text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>

    <SectionHeader label="Método" title="Cómo trabajo" class="section-gap mb-10" />
    <Bento cells>
      {
        method.map((m, i) => (
          <div class="px-7 py-8" style={methodStyles[i]}>
            <span class="index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h-title m-0 mt-4 text-2xl leading-[1.15]">{m.title}</h3>
            <p class="m-0 mt-3 text-[15px] leading-[1.7] text-muted [text-wrap:pretty]">{m.body}</p>
          </div>
        ))
      }
    </Bento>

    <div
      class="section-gap flex flex-wrap items-end gap-x-16 gap-y-6 border border-line bg-surface p-[clamp(32px,4vw,64px)]"
    >
      <div class="flex-[1_1_480px]">
        <h2 class="h2-sub m-0">Qué construyo</h2>
        <p class="body-md m-0 mt-5 max-w-[760px]">
          Aplicaciones reales, no demos: sistemas multiusuario con lógica de negocio compleja, APIs
          propias y productos que viven en producción. Desde un SaaS agroindustrial offline-first
          hasta análisis de código con criterio OWASP, me interesa el software que resuelve un
          problema medible para alguien concreto. Bajo Lúmina W llevo esa misma idea a clientes:
          producto a medida, pensado para durar y no para impresionar en una captura.
        </p>
      </div>
      <Button href={r.projects} variant="secondary" aria-label="Ver proyectos de Valentina Ramírez">
        Ver proyectos
      </Button>
    </div>

    <div
      class="section-gap grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-x-12 gap-y-12"
    >
      <div>
        <h3 class="h-title m-0 mb-2 text-[28px] tracking-[-0.02em]">Formación en paralelo</h3>
        {
          education.map((e) => (
            <div class="flex justify-between gap-4 border-b border-line py-[18px]">
              <span class="h-title">{e.name}</span>
              <span class="text-right text-sm text-muted">{e.detail}</span>
            </div>
          ))
        }
        <div class="flex justify-between gap-4 border-b border-line py-[18px]">
          <span class="h-title">Platzi</span>
          <span class="max-w-[300px] text-right text-sm text-muted">
            Formación autodidacta en Desarrollo Web, Inteligencia Artificial y Seguridad Informática
            <br />
            <TextLink
              href="https://platzi.com/p/wavival"
              target="_blank"
              class="mt-2"
              aria-label="Perfil de Valentina Ramírez en Platzi"
            >
              Mi perfil en Platzi
            </TextLink>
          </span>
        </div>
      </div>
      <div>
        <h3 class="h-title m-0 mb-5 text-[28px] tracking-[-0.02em]">Fuera del código</h3>
        <p class="body m-0 [text-wrap:pretty]">
          Lo que más disfruto también me enseña a trabajar: la batería me dio estructura y ritmo, la
          cocina me enseñó a seguir un proceso y a improvisar cuando hace falta, y la música y la
          lectura me mantienen la curiosidad encendida. Aprender no se apaga cuando cierro el
          portátil: es la forma en que vivo dentro y fuera del código.
        </p>
        <ChipList
          loose
          class="mt-5"
          label="Intereses fuera del código"
          items={["Batería", "Cocina", "Música", "Lectura"]}
        />
      </div>
    </div>

    <PullQuote class="section-gap border-t border-line pt-10 min-[900px]:text-center">
      "Aprender no es una etapa que se termina: es la forma en que trabajo. Cada proyecto me deja
      sabiendo algo que no sabía al empezarlo."
      <footer slot="footer" class="mt-5 text-sm text-muted">
        Autora del <TextLink
          href="https://blog.luminaw.co/"
          target="_blank"
          variant="inline"
          aria-label="Blog de Lúmina W escrito por Valentina Ramírez"
        >
          Blog W
        </TextLink>, donde escribo lo que aprendo.
      </footer>
    </PullQuote>

    <div class="mt-14 flex flex-wrap items-center gap-3 min-[900px]:justify-center">
      <Button
        href={cv}
        download={cvFile}
        icon="download-cv-white"
        data-umami-event="cv-descarga-es"
        aria-label="Descargar CV de Valentina Ramírez en PDF"
      >
        Descargar CV
      </Button>
      <SocialLinks lang={lang} size="lg" items={["linkedin", "github", "instagram", "whatsapp"]} />
    </div>
  </section>

  <ContactBand lang={lang} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

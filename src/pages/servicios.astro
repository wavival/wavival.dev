---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import ServicesCatalog from "@/components/organisms/ServicesCatalog.astro";
import ServicesDetail from "@/components/organisms/ServicesDetail.astro";
import ContactBand from "@/components/organisms/ContactBand.astro";
import { servicesLd } from "@/data/servicesLd";

const site = "https://www.wavival.dev";

const pageTitle = "Desarrollo Full Stack a medida | Valentina Ramírez";
const pageDescription =
  "Desarrolladora Full Stack freelance con enfoque en backend e IA: apps web con Django, React, Next.js y Supabase, IA y seguridad desde el diseño. Del problema al producto en producción.";

const fit = {
  yes: [
    "Fundadores con producto real que necesitan velocidad",
    "Equipos que necesitan API y frontend en un solo contrato",
    "Startups que valoran seguridad desde el diseño",
  ],
  no: [
    "El proyecto es solo diseño o maquetado estático",
    "Necesitas alguien disponible en oficina 9-5",
    "Buscas el precio más bajo, no el mejor resultado",
  ],
};

const process = [
  {
    step: "01",
    title: "Conversación",
    body: "Entiendo el problema de negocio antes de hablar de tecnología. Qué necesitas, para quién y por qué.",
  },
  {
    step: "02",
    title: "Propuesta",
    body: "Defino alcance, arquitectura y entregables. Sin sorpresas: sabes qué se construye y en qué orden.",
  },
  {
    step: "03",
    title: "Build iterativo",
    body: "Construyo en entregas visibles. Ves avances reales, no un silencio de semanas seguido de un big bang.",
  },
  {
    step: "04",
    title: "Entrega",
    body: "Producto en producción, documentado y mantenible. Pensado para durar más allá del primer release.",
  },
];

const faqs = [
  {
    q: "¿Manejas el diseño?",
    a: "Sí, soy diseñadora UX/UI y puedo trabajarlo sin problema. Si llegas con referencias o una dirección visual clara, mejor. Si necesitas el proceso de diseño completo desde cero, lo incluimos en la propuesta.",
  },
  {
    q: "¿Qué necesito para empezar?",
    a: "Tener claro el problema y a quién va dirigido el producto. No necesitas llegar con un PRD (documento de requerimientos de producto: el listado detallado de funciones, flujos y reglas de negocio que define qué debe hacer el software). Eso lo construimos juntos en la propuesta.",
  },
  {
    q: "¿Trabajas con equipos o solo con founders?",
    a: "Con ambos. Puedo llevar el desarrollo completo como dev única o integrarme a un equipo existente como refuerzo backend, API o seguridad.",
  },
];

// Structured data is the same for every visitor: every price in COP and in USD, with the region each applies to.
const serviceLd = JSON.stringify(
  servicesLd({
    lang: "es",
    site,
    url: `${site}/servicios/`,
    name: "Valentina Ramírez: Desarrollo Full Stack",
    description: pageDescription,
  })
);

const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.wavival.dev/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Servicios",
      item: "https://www.wavival.dev/servicios/",
    },
  ],
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/servicios/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/services/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/servicios/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="En qué te puedo ayudar" size="page">
      <Fragment slot="title">Construyo el producto que tu negocio necesita</Fragment>
      <p class="body-lg m-0">
        Soy Full Stack Developer con enfoque en backend e IA: tomo un problema de negocio y lo
        entrego como software real en producción. Cada servicio tiene precio fijo, plazo y alcance
        claros, para que sepas qué recibes antes de empezar.
      </p>
    </PageIntro>

    <ServicesCatalog lang="es" />

    <ServicesDetail
      fit={{
        ...fit,
        yesTitle: "Trabajo mejor con",
        noTitle: "No es para mí si",
        yesMark: "SÍ",
        noMark: "NO",
      }}
      processLabel="Proceso"
      processTitle="Cómo trabajo"
      process={process}
      faqTitle="Preguntas frecuentes"
      faqs={faqs}
    />
  </section>

  <ContactBand showServicesLink={false} />

  <script is:inline type="application/ld+json" set:html={serviceLd} />
  <script is:inline type="application/ld+json" set:html={faqLd} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import ServicesCatalog from "@/components/organisms/ServicesCatalog.astro";
import ServicesDetail from "@/components/organisms/ServicesDetail.astro";
import { servicesFaq, servicesFaqLd } from "@/data/servicesFaq";
import { servicesLd } from "@/data/servicesLd";

const site = "https://www.wavival.dev";

const pageTitle = "Servicios: software y marketing digital";
const pageDescription =
  "Landing pages, sitios web, n8n, chatbots con IA, apps a medida y seguridad, con precio fijo y plazo claro. Software seguro que le ahorra tiempo a tu negocio.";

const fit = {
  yes: [
    "Dueños de micro negocios de servicios, de 1 a 10 personas, que ya venden y tienen clientes",
    "Negocios que operan con WhatsApp, Instagram, Excel o Google Sheets y correo",
    "Quien responde a mano los mismos mensajes, agenda y cotiza a mano, pierde leads o no tiene web, o la tiene desactualizada",
    "Personas no técnicas que buscan resultados: tiempo ahorrado y más ventas",
    "Servicios con agenda (consultorios, estética, psicología, abogados, contadores), academias y formadores, y comercio pequeño que vende por Instagram o WhatsApp",
  ],
  no: [
    "Tu negocio está en etapa de idea y todavía no vende",
    "Tu equipo tiene más de 10 personas, o el proyecto necesita un equipo o supera el presupuesto máximo de wavival: esos proyectos van a Lúmina\u00a0W",
    "Buscas un pentest certificado o una certificación de cumplimiento",
    "Buscas manejo diario de redes o una agencia de marketing",
  ],
};

const process = [
  {
    step: "01",
    title: "Conversación",
    body: "Entiendo el problema de negocio antes de hablar de tecnología. Qué necesitas, para quién y por qué.",
  },
  {
    step: "02",
    title: "Propuesta",
    body: "Defino alcance, arquitectura y entregables. Sin sorpresas: sabes qué se construye y en qué orden.",
  },
  {
    step: "03",
    title: "Build iterativo",
    body: "Construyo en entregas visibles. Ves avances reales, no un silencio de semanas seguido de un big bang.",
  },
  {
    step: "04",
    title: "Entrega",
    body: "Producto en producción, documentado y mantenible. Pensado para durar más allá del primer release.",
  },
];

// Structured data is the same for every visitor: every price in COP and in USD, with the region each applies to.
const serviceLd = JSON.stringify(
  servicesLd({
    lang: "es",
    site,
    url: `${site}/servicios/`,
    name: "Valentina Ramírez: Software y marketing digital",
    description: pageDescription,
  })
);

const faqLd = JSON.stringify(servicesFaqLd("es"));

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.wavival.dev/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Servicios",
      item: "https://www.wavival.dev/servicios/",
    },
  ],
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  contactBandSecondary="contact"
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/servicios/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/services/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/servicios/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="En qué te puedo ayudar" size="page">
      <Fragment slot="title">Construyo el producto que tu negocio necesita</Fragment>
      <p class="body-lg m-0">
        Soy desarrolladora de software y marketing digital: tomo un problema de negocio y lo entrego
        como software real en producción, que te ahorra tiempo y trae clientes. Cada servicio tiene
        precio fijo, plazo y alcance claros, para que sepas qué recibes antes de empezar.
      </p>
    </PageIntro>

    <ServicesCatalog lang="es" />

    <ServicesDetail
      fit={{
        ...fit,
        yesTitle: "Trabajo mejor con",
        noTitle: "No es para ti si",
        yesMark: "SÍ",
        noMark: "NO",
      }}
      processLabel="Proceso"
      processTitle="Cómo trabajo"
      process={process}
      faqTitle="Preguntas frecuentes"
      faqs={servicesFaq("es")}
      faqOpenLabel="Ver"
      faqCloseLabel="Cerrar"
    />
  </section>

  <script is:inline type="application/ld+json" set:html={serviceLd} />
  <script is:inline type="application/ld+json" set:html={faqLd} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

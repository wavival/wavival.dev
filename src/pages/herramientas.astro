---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import Button from "@/components/atoms/Button.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import Badge from "@/components/atoms/Badge.astro";
import Index from "@/components/atoms/Index.astro";
import Eyebrow from "@/components/atoms/Eyebrow.astro";
import { siteRoutes } from "@/i18n/utils";
import RepoCard from "@/components/organisms/RepoCard.astro";
import { stack } from "@/data/stack";
import { fetchGithubProfile, curateRepos } from "@/data/github";

const routes = siteRoutes("es", import.meta.env.BASE_URL);

const { user: githubUser, repos: githubRepos } = await fetchGithubProfile("wavival");
const { featured: featuredRepos, resources: resourceRepos } = curateRepos(githubRepos);

const pageTitle = "Uses: Herramientas y stack | Valentina Ramírez";
const pageDescription =
  "El stack y las herramientas que uso como Full Stack Developer (Django, Next.js, React, PostgreSQL, Astro, IA y seguridad) y por qué elijo cada una.";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.wavival.dev/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Herramientas",
      item: "https://www.wavival.dev/herramientas/",
    },
  ],
});
const hardwareItems = [
  {
    title: "Equipo",
    sub: "Mi máquina del día a día",
    tools: ["Intel Core i5", "16 GB RAM", "1 TB", "Linux · Fedora"],
  },
  {
    title: "Periféricos",
    sub: "Lo que toco a diario",
    tools: [
      "Monitor LG 27″ ultrawide (audio integrado)",
      "Teclado Genius",
      "Mouse ergonómico alámbrico",
      "Cámara HP 1080p (mic integrado)",
    ],
  },
];
const softwareItems = [
  {
    title: "Código e IA",
    sub: "Donde escribo y razono",
    tools: [
      "VS Code",
      "Cursor",
      "Claude (app · chat · Code · Design)",
      "OpenAI",
      "OpenClaw",
      "ChatGPT",
      "Codex",
    ],
  },
  {
    title: "Terminal y APIs",
    sub: "El backend del día",
    tools: ["Warp", "WSL (Ubuntu)", "Postman"],
  },
  {
    title: "Productividad y navegación",
    sub: "Para no perder el hilo",
    tools: ["Todoist", "Focus To-Do", "Bloc de notas", "Firefox"],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/herramientas/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/uses/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/herramientas/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="Herramientas" size="uses">
      <Fragment slot="title">Con qué construyo</Fragment>
      <p class="body-lg m-0">
        Todo lo que uso para construir: el stack, la máquina y las apps del día a día. No es una
        lista de modas, son las herramientas con las que entrego productos reales.
      </p>
    </PageIntro>

    <div class="rule-section section-gap flex flex-wrap gap-x-12 gap-y-6">
      <div class="flex flex-[0_0_260px] flex-col lg:sticky lg:top-24 lg:self-start">
        <div class="flex items-baseline gap-[14px]"><Index>01</Index><Eyebrow>Stack</Eyebrow></div>
        <h2 class="h-title m-0 mt-4 text-[32px] leading-[1.05] tracking-[-0.02em]">
          Con qué desarrollo
        </h2>
        <p class="m-0 mt-3 text-sm leading-[1.7] text-muted">
          El stack que uso a diario y la razón detrás de cada elección: backend sólido, frontend
          funcional, IA aplicada y seguridad desde el diseño.
        </p>
      </div>
      <div class="min-w-0 flex-1 basis-[480px]">
        {
          stack.map((s) => (
            <div class="flex flex-col gap-3 border-b border-line py-7">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="h-title m-0 text-2xl">{s.category}</h3>
                <span class="text-[13px] text-muted">{s.description}</span>
              </div>
              {s.why && <p class="body m-0">{s.why}</p>}
              <ChipList items={s.tools} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="rule-section section-gap flex flex-wrap gap-x-12 gap-y-6">
      <div class="flex flex-[0_0_260px] flex-col lg:sticky lg:top-24 lg:self-start">
        <div class="flex items-baseline gap-[14px]">
          <Index>02</Index><Eyebrow>Hardware</Eyebrow>
        </div>
        <h2 class="h-title m-0 mt-4 text-[32px] leading-[1.05] tracking-[-0.02em]">
          Dónde lo construyo
        </h2>
        <p class="m-0 mt-3 text-sm leading-[1.7] text-muted">
          Equipo modesto a propósito. Si una app corre fluida acá, corre en cualquier lado: me
          obliga a optimizar de verdad, no a tapar con hardware.
        </p>
      </div>
      <div class="min-w-0 flex-1 basis-[480px]">
        {
          hardwareItems.map((it) => (
            <div class="flex flex-col gap-3 border-b border-line py-7">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="h-title m-0 text-2xl">{it.title}</h3>
                <span class="text-[13px] text-muted">{it.sub}</span>
              </div>
              <ChipList items={it.tools} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="rule-section section-gap flex flex-wrap gap-x-12 gap-y-6">
      <div class="flex flex-[0_0_260px] flex-col lg:sticky lg:top-24 lg:self-start">
        <div class="flex items-baseline gap-[14px]">
          <Index>03</Index><Eyebrow>Software</Eyebrow>
        </div>
        <h2 class="h-title m-0 mt-4 text-[32px] leading-[1.05] tracking-[-0.02em]">
          Mis herramientas del día a día
        </h2>
        <p class="m-0 mt-3 text-sm leading-[1.7] text-muted">
          Las apps donde vivo mientras construyo: edición, IA, terminal y el flujo de productividad
          que me mantiene enfocada.
        </p>
      </div>
      <div class="min-w-0 flex-1 basis-[480px]">
        {
          softwareItems.map((it) => (
            <div class="flex flex-col gap-3 border-b border-line py-7">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="h-title m-0 text-2xl">{it.title}</h3>
                <span class="text-[13px] text-muted">{it.sub}</span>
              </div>
              <ChipList items={it.tools} />
            </div>
          ))
        }
      </div>
    </div>

    {
      githubUser && (
        <div
          id="repos"
          class="rule-section section-gap flex scroll-mt-24 flex-wrap gap-x-12 gap-y-6"
        >
          <div class="flex flex-[0_0_260px] flex-col lg:self-start">
            <div class="flex items-baseline gap-[14px]">
              <Fragment>
                <Index>04</Index>
                <Eyebrow>GitHub</Eyebrow>
              </Fragment>
            </div>
            <h2 class="h-title m-0 mt-4 text-[32px] leading-[1.05] tracking-[-0.02em]">
              Aprendo, construyo, comparto
            </h2>
            <p class="m-0 mt-3 text-sm leading-[1.7] text-muted">
              {githubUser.public_repos} repos públicos · {githubUser.followers} seguidores
            </p>
            <TextLink
              href={githubUser.html_url}
              target="_blank"
              class="mt-3 self-start"
              aria-label="Ver el perfil completo de GitHub de Valentina Ramírez"
            >
              Ver perfil completo
            </TextLink>
          </div>
          <div class="flex min-w-0 flex-1 basis-[480px] flex-col gap-10">
            {featuredRepos.length > 0 && (
              <div class="border border-line border-t-2 border-t-blue bg-surface p-6 md:p-10">
                <Badge>Destacado</Badge>
                <h3 class="h-title m-0 mt-4 text-4xl tracking-[-0.03em]">NullBreach</h3>
                <p class="body m-0 mt-[10px]">
                  Mi proyecto bandera: análisis de seguridad con IA. Aplicación en Next.js con
                  OpenAI y Prisma, con el código abierto en GitHub.
                </p>
                <div
                  class="mt-5 grid gap-3"
                  style="grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))"
                >
                  {featuredRepos.map((repo) => (
                    <RepoCard repo={repo} lang="es" />
                  ))}
                </div>
              </div>
            )}
            {resourceRepos.length > 0 && (
              <div>
                <h3 class="h-title m-0 text-2xl">Recursos para aprender</h3>
                <p class="body m-0 mt-2">
                  Tomo cursos en Platzi, YouTube y otras fuentes, y convierto lo que aprendo en
                  repos públicos para que otras personas también puedan.
                </p>
                <ul
                  class="m-0 mt-6 grid list-none gap-3 p-0"
                  role="list"
                  style="grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))"
                >
                  {resourceRepos.map((repo) => (
                    <li>
                      <RepoCard repo={repo} lang="es" variant="resource" />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )
    }

    <div class="section-gap rule-line flex flex-wrap gap-3 pt-8">
      <Button
        variant="secondary"
        href={routes.projects}
        aria-label="Ver proyectos donde uso este stack">Ver proyectos</Button
      >
      <Button variant="secondary" href={routes.services} aria-label="Ver servicios"
        >Ver servicios</Button
      >
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

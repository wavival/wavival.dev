---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import ChipList from "@/components/molecules/ChipList.astro";
import Button from "@/components/atoms/Button.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import Badge from "@/components/atoms/Badge.astro";
import { siteRoutes } from "@/i18n/utils";
import RepoCard from "@/components/organisms/RepoCard.astro";
import StickyContentSection from "@/components/organisms/StickyContentSection.astro";
import SocialProfileCard from "@/components/organisms/SocialProfileCard.astro";
import { usesStack as stack } from "@/data/stack";
import { fetchGithubProfile, curateRepos } from "@/data/github";
import { usesSectionIndices } from "@/utils/sections";

const routes = siteRoutes("es", import.meta.env.BASE_URL);

const { user: githubUser, repos: githubRepos } = await fetchGithubProfile("wavival");
const { featured: featuredRepos, resources: resourceRepos } = curateRepos(githubRepos);
const indices = usesSectionIndices(Boolean(githubUser));

const pageTitle = "Uses: Herramientas y stack | Valentina Ramírez";
const pageDescription =
  "El stack y las herramientas que uso como desarrolladora de software y estratega digital (Django, React, Astro, Canva, CapCut) y por qué elijo cada una.";

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.wavival.dev/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Herramientas",
      item: "https://www.wavival.dev/herramientas/",
    },
  ],
});
const hardwareItems = [
  {
    title: "Equipo Linux",
    sub: "Mi máquina del día a día",
    tools: ["Intel Core i5", "16 GB RAM", "1 TB", "Linux · Fedora"],
  },
  {
    title: "Equipo Windows",
    sub: "Mi otro equipo",
    tools: [
      "AMD Ryzen 5 3400G",
      "Radeon RX Vega 11",
      "16 GB RAM",
      "224 GB",
      "Windows 11 Pro (25H2)",
      "WSL2 · Ubuntu",
    ],
  },
  {
    title: "Móvil y grabación",
    sub: "Para el contenido",
    tools: ["Motorola Edge 60 Fusion", "Estabilizador DJI con selfie stick extensible"],
  },
  {
    title: "Periféricos",
    sub: "Lo que toco a diario",
    tools: [
      "Monitor LG 27″ ultrawide (audio integrado)",
      "Teclado Genius",
      "Mouse ergonómico alámbrico",
      "Cámara HP 1080p (mic integrado)",
    ],
  },
];
const softwareItems = [
  {
    title: "Código e IA",
    sub: "Donde escribo y razono",
    tools: [
      "VS Code",
      "Cursor",
      "Claude (app · chat · Code · Design)",
      "OpenAI",
      "OpenClaw",
      "ChatGPT",
      "Codex",
    ],
  },
  {
    title: "Terminal y APIs",
    sub: "El backend del día",
    tools: ["Warp", "WSL (Ubuntu)", "Postman"],
  },
  {
    title: "Marketing y estrategia digital",
    sub: "Piezas, audio y video",
    tools: ["Claude (ver Código e IA)", "CapCut", "Canva", "ElevenLabs", "Higgsfield"],
  },
  {
    title: "Productividad y navegación",
    sub: "Para no perder el hilo",
    tools: ["Kairo", "Bloc de notas", "Firefox"],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/herramientas/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/uses/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/herramientas/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="Herramientas" size="uses">
      <Fragment slot="title">Con qué construyo</Fragment>
      <p class="body-lg m-0">
        Todo lo que uso para construir: el stack, la máquina y las apps del día a día. No es una
        lista de modas, son las herramientas con las que entrego productos reales.
      </p>
    </PageIntro>

    <StickyContentSection
      index={indices.stack}
      eyebrow="Stack"
      title="Con qué desarrollo"
      description="El stack que uso a diario y la razón detrás de cada elección: backend sólido, frontend funcional, IA aplicada, seguridad desde el diseño y herramientas de marketing y estrategia digital."
      class="section-gap"
    >
      {
        stack.map((s) => (
          <div
            class={`flex flex-col gap-3 border-b border-line py-7 ${s.category === "Backend" ? "border-l-2 border-l-blue bg-tint px-5" : ""}`.trim()}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="h-title m-0 text-2xl">{s.category}</h3>
                <span class="text-[13px] text-muted">{s.description}</span>
              </div>
              {s.category === "Backend" && (
                <span class="label-sm label-sm-link shrink-0">Destacado</span>
              )}
            </div>
            {s.why && <p class="body m-0">{s.why}</p>}
            <ChipList
              items={s.tools}
              class={s.category === "Backend" ? "[&_.chip]:border-blue [&_.chip]:text-link" : ""}
            />
          </div>
        ))
      }
    </StickyContentSection>

    <StickyContentSection
      index={indices.hardware}
      eyebrow="Hardware"
      title="Dónde lo construyo"
      description="Equipo modesto a propósito. Si una app corre fluida acá, corre en cualquier lado: me obliga a optimizar de verdad, no a tapar con hardware."
      class="section-gap"
    >
      {
        hardwareItems.map((it) => (
          <div class="flex flex-col gap-3 border-b border-line py-7">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="h-title m-0 text-2xl">{it.title}</h3>
              <span class="text-[13px] text-muted">{it.sub}</span>
            </div>
            <ChipList items={it.tools} />
          </div>
        ))
      }
    </StickyContentSection>

    <StickyContentSection
      index={indices.software}
      eyebrow="Software"
      title="Mis herramientas del día a día"
      description="Las apps donde vivo mientras construyo: edición, IA, terminal y el flujo de productividad que me mantiene enfocada."
      class="section-gap"
    >
      {
        softwareItems.map((it) => (
          <div class="flex flex-col gap-3 border-b border-line py-7">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="h-title m-0 text-2xl">{it.title}</h3>
              <span class="text-[13px] text-muted">{it.sub}</span>
            </div>
            <ChipList items={it.tools} />
          </div>
        ))
      }
    </StickyContentSection>

    <StickyContentSection
      id="social"
      index={indices.social}
      eyebrow="Redes"
      title="Construyo en público"
      description="Muestro en Instagram y TikTok cómo construyo software seguro, automatizaciones con IA y lo que voy aprendiendo."
      class="section-gap scroll-mt-24"
    >
      <div
        class="grid gap-3"
        style="grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))"
      >
        <SocialProfileCard network="instagram" name="Instagram">
          Reels y publicaciones con el detrás de cámaras de cada proyecto y lo que aprendo en el
          camino.
        </SocialProfileCard>
        <SocialProfileCard network="tiktok" name="TikTok" variant="repo">
          Videos cortos donde explico cómo construyo software seguro y automatizaciones con IA.
        </SocialProfileCard>
      </div>
    </StickyContentSection>

    {
      githubUser && indices.github && (
        <StickyContentSection
          id="repos"
          index={indices.github}
          eyebrow="GitHub"
          title="Aprendo, construyo, comparto"
          description={`${githubUser.public_repos} repos públicos · ${githubUser.followers} seguidores`}
          class="section-gap scroll-mt-24"
        >
          <Fragment slot="label">
            <TextLink
              href={githubUser.html_url}
              target="_blank"
              class="mt-3 self-start"
              aria-label="Ver el perfil completo de GitHub de Valentina Ramírez"
            >
              Ver perfil completo
            </TextLink>
          </Fragment>
          <div class="flex flex-col gap-10">
            {featuredRepos.length > 0 && (
              <div class="border border-line border-t-2 border-t-blue bg-surface p-6 md:p-10">
                <Badge>Destacado</Badge>
                <h3 class="h-title m-0 mt-4 text-4xl tracking-[-0.03em]">NullBreach</h3>
                <p class="body m-0 mt-[10px]">
                  Mi proyecto bandera: análisis de seguridad con IA. Aplicación en Next.js con
                  OpenAI y Prisma, con el código abierto en GitHub.
                </p>
                <div
                  class="mt-5 grid gap-3"
                  style="grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))"
                >
                  {featuredRepos.map((repo) => (
                    <RepoCard repo={repo} lang="es" />
                  ))}
                </div>
              </div>
            )}
            {resourceRepos.length > 0 && (
              <div>
                <h3 class="h-title m-0 text-2xl">Recursos para aprender</h3>
                <p class="body m-0 mt-2">
                  Tomo cursos en Platzi, YouTube y otras fuentes, y convierto lo que aprendo en
                  repos públicos para que otras personas también puedan.
                </p>
                <ul
                  class="m-0 mt-6 grid list-none gap-3 p-0"
                  role="list"
                  style="grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))"
                >
                  {resourceRepos.map((repo) => (
                    <li>
                      <RepoCard repo={repo} lang="es" variant="resource" />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </StickyContentSection>
      )
    }

    <div class="section-gap rule-line flex flex-wrap justify-center gap-3 pt-8">
      <Button
        variant="primary"
        href={routes.services}
        icon="briefcase-white"
        aria-label="Ver servicios">Ver servicios</Button
      >
      <Button
        variant="secondary"
        href={routes.projects}
        aria-label="Ver proyectos donde uso este stack">Ver proyectos</Button
      >
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>

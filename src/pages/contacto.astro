---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/molecules/PageIntro.astro";
import SectionHeader from "@/components/molecules/SectionHeader.astro";
import Button from "@/components/atoms/Button.astro";
import TextLink from "@/components/atoms/TextLink.astro";
import MaskIcon from "@/components/atoms/MaskIcon.astro";
import Index from "@/components/atoms/Index.astro";

const email = "wavival.dev@luminaw.co";
const whatsappNumber = "573016560222";
const whatsappMessage = "Hola Valentina, vengo de tu portafolio y quiero hablar de un proyecto.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const calendlyUrl = "https://calendly.com/wavival/descubrimiento-servicios-wavival";

const pageTitle = "Contacto: Hablemos de tu producto | Valentina Ramírez";
const pageDescription =
  "Tres formas de empezar: correo, WhatsApp o una llamada de descubrimiento de 30 minutos. Diseño y construyo productos completos, del backend a la interfaz.";

const site = "https://www.wavival.dev";
const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.wavival.dev/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Contacto",
      item: "https://www.wavival.dev/contacto/",
    },
  ],
});
const contactSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${site}/contacto/#contactpage`,
  url: `${site}/contacto/`,
  name: pageTitle,
  description: pageDescription,
  inLanguage: "es-CO",
  mainEntity: { "@id": `${site}/#person` },
});

const channels = [
  {
    icon: "send-email-white",
    title: "Correo",
    body: "Cuéntame tu proyecto con calma. Respondo en 24h.",
    href: `mailto:${email}`,
    target: "_self" as const,
    cta: "Escríbeme",
    ariaLabel: "Enviar un correo electrónico a Valentina Ramírez",
    event: "contacto-email",
  },
  {
    icon: "whatsapp",
    title: "WhatsApp",
    body: "Para dudas rápidas o arrancar de una.",
    href: whatsappHref,
    target: "_blank" as const,
    cta: "Chatear",
    ariaLabel: "Escribir a Valentina Ramírez por WhatsApp",
    event: "contacto-whatsapp",
  },
  {
    icon: "calendar-blue",
    title: "Llamada 30 min",
    body: "Sin compromiso. Agenda en tu zona horaria; coordino desde COT (UTC-5).",
    href: "#agenda",
    target: "_self" as const,
    cta: "Agendar",
    ariaLabel: "Ir al calendario para agendar una llamada",
    event: "contacto-calendly",
  },
];
const steps = [
  "Eliges un horario que te sirva.",
  "Hablamos 30 min de tu idea.",
  "Te envío una propuesta clara.",
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  alternates={[
    { hreflang: "es", href: "https://www.wavival.dev/contacto/" },
    { hreflang: "en", href: "https://www.wavival.dev/en/contact/" },
    { hreflang: "x-default", href: "https://www.wavival.dev/contacto/" },
  ]}
>
  <section class="wrap page-top">
    <PageIntro eyebrow="Hablemos" size="contact">
      <Fragment slot="title"
        >Tu próxima idea merece <span class="accent">código que la sostenga.</span></Fragment
      >
      <p class="body-lg m-0">
        ¿Tienes un producto en mente? Elige cómo prefieres empezar. Diseño y construyo productos
        completos, del backend a la interfaz, con IA integrada y seguridad desde el diseño.
      </p>
    </PageIntro>

    <div
      class="mt-16 grid border-t border-ink"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))"
    >
      {
        channels.map((c, i) => (
          <article class="flex flex-col gap-5 border-b border-line py-8 pr-7">
            <div class="flex items-center justify-between">
              <Index>{String(i + 1).padStart(2, "0")}</Index>
              <span class="inline-flex h-12 w-12 items-center justify-center border border-line bg-tint">
                <MaskIcon name={c.icon} size="lg" />
              </span>
            </div>
            <h2 class="h-title m-0 text-[32px] tracking-[-0.02em]">{c.title}</h2>
            <p class="m-0 text-[15px] leading-[1.65] text-muted">{c.body}</p>
            <Button
              variant="secondary"
              size="sm"
              class="mt-auto self-start"
              href={c.href}
              target={c.target}
              aria-label={c.ariaLabel}
              data-umami-event={c.event}
            >
              {c.cta}
            </Button>
          </article>
        ))
      }
    </div>

    <p class="mb-0 mt-6 text-sm text-muted">
      Proyectos desde <strong class="font-semibold text-ink">USD 250 / COP 1.000.000</strong> según alcance.
      Disponibilidad limitada.
    </p>
  </section>

  <section id="agenda" class="wrap pb-[var(--sec)]">
    <SectionHeader
      label="Llamada de 30 min"
      title="Agenda una llamada de descubrimiento"
      titleClass="h2-sub"
      class="mb-10"
    >
      <ol
        class="m-0 mt-8 grid list-none gap-x-8 gap-y-4 p-0"
        style="grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))"
      >
        {
          steps.map((text, i) => (
            <li class="flex items-baseline gap-[14px] text-[15px] text-ink">
              <span class="h-title text-[28px] text-blue">{i + 1}</span>
              {text}
            </li>
          ))
        }
      </ol>
    </SectionHeader>

    <div
      id="calendly-embed"
      role="region"
      aria-label="Calendario para agendar una llamada de 30 minutos"
      class="overflow-hidden border border-line bg-bg"
    >
      <noscript>
        <p class="body m-0 p-6">
          El calendario necesita JavaScript. Agenda directamente en
          <TextLink
            variant="inline"
            href={calendlyUrl}
            target="_blank"
            aria-label="Abrir el calendario de Calendly">Calendly</TextLink
          > o escríbeme a <TextLink variant="inline" href={`mailto:${email}`}>{email}</TextLink>.
        </p>
      </noscript>
    </div>
  </section>

  <script is:inline define:vars={{ calendlyUrl }}>
    (function () {
      const dark = document.documentElement.classList.contains("dark");
      let url = calendlyUrl + "?hide_gdpr_banner=1&primary_color=1565c0";
      if (dark) url += "&background_color=0f1117&text_color=e5e7eb";

      const container = document.getElementById("calendly-embed");
      const widget = document.createElement("div");
      widget.className = "calendly-inline-widget";
      widget.setAttribute("data-url", url);
      widget.style.minWidth = "320px";
      widget.style.height = "1000px";
      container.appendChild(widget);

      window.addEventListener("message", function (e) {
        if (e.origin.indexOf("calendly.com") === -1) return;
        if (!e.data || e.data.event !== "calendly.page_height") return;
        const h = e.data.payload && e.data.payload.height;
        if (!h) return;
        widget.style.height = h;
        const iframe = widget.querySelector("iframe");
        if (iframe) {
          iframe.style.height = h;
          if (!iframe.getAttribute("title"))
            iframe.setAttribute("title", "Calendario de Calendly para agendar una llamada");
        }
      });

      const s = document.createElement("script");
      s.src = "https://assets.calendly.com/assets/external/widget.js";
      s.async = true;
      document.body.appendChild(s);
    })();
  </script>

  <script is:inline type="application/ld+json" set:html={contactSchema} />
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
</Layout>
